<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- fixed (byte* p = pixels) in GlReadbackTests' CopyFrame call. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- Pinned to a version satisfying the transitive 10.x required by the
         HelixToolkit.Nex stack (the old 8.* downgraded against it → NU1605). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- Win32_PnPEntity enumeration for the hardware tests' ghost-port filter
         (Bluetooth SPP ports enumerate but hang on open). Windows-only usage;
         non-Windows runs degrade to the unfiltered port list. -->
    <PackageReference Include="System.Management" Version="10.*" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SenderNG.Core\SenderNG.Core.csproj" />
    <ProjectReference Include="..\..\src\SenderNG\SenderNG.csproj" />
    <!-- Compile-time refs to the built-in converter plugins so ConverterTests
         can unit-test the module classes directly (the ScanDirectory test still
         discovers the real DLLs from Modules/ via LoadFrom). -->
    <ProjectReference Include="..\..\src\SenderNG.Modules.Excellon\SenderNG.Modules.Excellon.csproj" />
    <!-- Aliased: the linked SenderNG.Shared scaffolding is compiled into BOTH
         plugin DLLs, so shared types resolve from the Excellon assembly and
         HPGL-specific types come through the alias. -->
    <ProjectReference Include="..\..\src\SenderNG.Modules.Hpgl\SenderNG.Modules.Hpgl.csproj" Aliases="hpgl" />
    <ProjectReference Include="..\..\src\SenderNG.Modules.Plotter\SenderNG.Modules.Plotter.csproj" />
    <ProjectReference Include="..\..\src\SenderNG.Modules.Plotter.GL\SenderNG.Modules.Plotter.GL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plugin staging for the ScanDirectory test: same Link trick the app
         csproj uses, so OutputDir/Modules contains the discoverable DLLs. -->
    <None Include="..\..\src\SenderNG.Modules.Common\bin\$(Configuration)\$(TargetFramework)\SenderNG.Modules.Common.dll">
      <Link>Modules\SenderNG.Modules.Common.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\src\SenderNG.Modules.Excellon\bin\$(Configuration)\$(TargetFramework)\SenderNG.Modules.Excellon.dll">
      <Link>Modules\SenderNG.Modules.Excellon.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\src\SenderNG.Modules.Hpgl\bin\$(Configuration)\$(TargetFramework)\SenderNG.Modules.Hpgl.dll">
      <Link>Modules\SenderNG.Modules.Hpgl.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\src\SenderNG.Modules.Plotter\bin\$(Configuration)\$(TargetFramework)\SenderNG.Modules.Plotter.dll">
      <Link>Modules\SenderNG.Modules.Plotter.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\src\SenderNG.Modules.Plotter.GL\bin\$(Configuration)\$(TargetFramework)\SenderNG.Modules.Plotter.GL.dll">
      <Link>Modules\SenderNG.Modules.Plotter.GL.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\src\SenderNG.Modules.Probing\bin\$(Configuration)\$(TargetFramework)\SenderNG.Modules.Probing.dll">
      <Link>Modules\SenderNG.Modules.Probing.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Locale fixtures: copied into this project's OutputDir/Locale so tests can
         build a LocalizationService from the same UI-owned data the app uses. -->
    <Content Include="..\..\src\SenderNG\Locale\**\*.json">
      <Link>Locale\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- No Content item for the plotter module's OWN catalogs, on purpose: this
       project references src/SenderNG/SenderNG.csproj, and that app project
       already stages every module's locale pair into Modules/<id>/Locale. An
       extra item here would duplicate the file and MASK a regression in the app's
       staging, which is the one thing
       PlotterLocaleTests.The_staged_catalogs_ship_the_keys exists to catch. The
       test therefore reads whatever the app's staging put there, and nothing
       else. -->

</Project>
