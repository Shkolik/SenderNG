<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SenderNG\SenderNG.csproj" />
    <ProjectReference Include="..\..\src\SenderNG.Core\SenderNG.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Locale fixtures: copied into this project's OutputDir/Locale so tests can
         build a LocalizationService from the same UI-owned data the app uses. -->
    <Content Include="..\..\src\SenderNG\Locale\**\*.json">
      <Link>Locale\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>