<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SenderNG.Modules.Probing\SenderNG.Modules.Probing.csproj" />
    <ProjectReference Include="..\..\src\SenderNG.Core\SenderNG.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Probe-view tests resolve module.probing.* keys from the plugin's own
         Locale catalogs, linked into this project's OutputDir/Locale. -->
    <Content Include="..\..\src\SenderNG.Modules.Probing\Locale\**\*.json">
      <Link>Locale\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>