<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Modules.Shared"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="260"
             x:Class="SenderNG.Modules.Shared.ConverterSettingsView"
             x:DataType="vm:ConverterSettingsViewModel">

    <StackPanel Spacing="6">
        <TextBlock Text="{Binding ModuleName}" FontSize="12" FontWeight="SemiBold" />
        <CheckBox Content="{Binding ShowDialogLabel}" IsChecked="{Binding ShowDialog, Mode=TwoWay}" FontSize="11" />
        <CheckBox Content="{Binding CutModeLabel}" IsChecked="{Binding CutMode, Mode=TwoWay}"
                  IsVisible="{Binding ShowCutMode}" FontSize="11" />

        <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
            <StackPanel Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding ZHomeLabel}" FontSize="11" Foreground="#666" VerticalAlignment="Center" />
                    <TextBox Text="{Binding ZHome, Mode=TwoWay}" FontSize="12" Height="22" Width="70"
                             CornerRadius="0" BorderBrush="#999" BorderThickness="1" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding ZRapidsLabel}" FontSize="11" Foreground="#666" VerticalAlignment="Center" />
                    <TextBox Text="{Binding ZRapids, Mode=TwoWay}" FontSize="12" Height="22" Width="70"
                             CornerRadius="0" BorderBrush="#999" BorderThickness="1" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding ZSafeLabel}" FontSize="11" Foreground="#666" VerticalAlignment="Center" />
                    <TextBox Text="{Binding ZSafe, Mode=TwoWay}" FontSize="12" Height="22" Width="70"
                             CornerRadius="0" BorderBrush="#999" BorderThickness="1" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding ZMinLabel}" FontSize="11" Foreground="#666" VerticalAlignment="Center" />
                    <TextBox Text="{Binding ZMin, Mode=TwoWay}" FontSize="12" Height="22" Width="70"
                             CornerRadius="0" BorderBrush="#999" BorderThickness="1" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding ScaleXLabel}" FontSize="11" Foreground="#666" VerticalAlignment="Center" />
                    <TextBox Text="{Binding ScaleX, Mode=TwoWay}" FontSize="12" Height="22" Width="70"
                             CornerRadius="0" BorderBrush="#999" BorderThickness="1" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding RpmLabel}" FontSize="11" Foreground="#666" VerticalAlignment="Center" />
                    <TextBox Text="{Binding RPM, Mode=TwoWay}" FontSize="12" Height="22" Width="70"
                             CornerRadius="0" BorderBrush="#999" BorderThickness="1" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding ToolDiameterLabel}" FontSize="11" Foreground="#666" VerticalAlignment="Center" />
                    <TextBox Text="{Binding ToolDiameter, Mode=TwoWay}" FontSize="12" Height="22" Width="70"
                             CornerRadius="0" BorderBrush="#999" BorderThickness="1" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding FeedRateLabel}" FontSize="11" Foreground="#666" VerticalAlignment="Center" />
                    <TextBox Text="{Binding FeedRate, Mode=TwoWay}" FontSize="12" Height="22" Width="70"
                             CornerRadius="0" BorderBrush="#999" BorderThickness="1" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding PlungeRateLabel}" FontSize="11" Foreground="#666" VerticalAlignment="Center" />
                    <TextBox Text="{Binding PlungeRate, Mode=TwoWay}" FontSize="12" Height="22" Width="70"
                             CornerRadius="0" BorderBrush="#999" BorderThickness="1" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding ScaleYLabel}" FontSize="11" Foreground="#666" VerticalAlignment="Center" />
                    <TextBox Text="{Binding ScaleY, Mode=TwoWay}" FontSize="12" Height="22" Width="70"
                             CornerRadius="0" BorderBrush="#999" BorderThickness="1" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>