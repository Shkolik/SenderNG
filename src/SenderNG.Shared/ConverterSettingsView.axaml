<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Modules.Shared"
             xmlns:conv="clr-namespace:SenderNG.Modules.Shared.Converters"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="260"
             x:Class="SenderNG.Modules.Shared.ConverterSettingsView"
             x:DataType="vm:ConverterSettingsViewModel">

    <StackPanel Spacing="6">
        <TextBlock Text="{Binding ModuleName}" FontSize="12" FontWeight="SemiBold" />
        <CheckBox Content="{Binding ShowDialogLabel}" IsChecked="{Binding ShowDialog, Mode=TwoWay}" FontSize="11" />
        <CheckBox Content="{Binding CutModeLabel}" IsChecked="{Binding CutMode, Mode=TwoWay}"
                  IsVisible="{Binding ShowCutMode}" FontSize="11" />

        <!-- One shared grid: label and input columns are common to every row,
             so all labels line up with their inputs and the inputs in each
             column start at the same x (labels right-align onto the inputs). -->
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="6"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ZHomeLabel}" FontSize="11" Foreground="#666" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBox Classes="num" Grid.Row="0" Grid.Column="1" Text="{Binding ZHome, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}, UpdateSourceTrigger=LostFocus}" FontSize="12" Height="22" Width="70"
                     CornerRadius="0" BorderBrush="#999" BorderThickness="1" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ZRapidsLabel}" FontSize="11" Foreground="#666" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBox Classes="num" Grid.Row="1" Grid.Column="1" Text="{Binding ZRapids, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}, UpdateSourceTrigger=LostFocus}" FontSize="12" Height="22" Width="70"
                     CornerRadius="0" BorderBrush="#999" BorderThickness="1" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding ZSafeLabel}" FontSize="11" Foreground="#666" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBox Classes="num" Grid.Row="2" Grid.Column="1" Text="{Binding ZSafe, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}, UpdateSourceTrigger=LostFocus}" FontSize="12" Height="22" Width="70"
                     CornerRadius="0" BorderBrush="#999" BorderThickness="1" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding ZMinLabel}" FontSize="11" Foreground="#666" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBox Classes="num" Grid.Row="3" Grid.Column="1" Text="{Binding ZMin, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}, UpdateSourceTrigger=LostFocus}" FontSize="12" Height="22" Width="70"
                     CornerRadius="0" BorderBrush="#999" BorderThickness="1" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding ScaleXLabel}" FontSize="11" Foreground="#666" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBox Classes="num" Grid.Row="4" Grid.Column="1" Text="{Binding ScaleX, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}, UpdateSourceTrigger=LostFocus}" FontSize="12" Height="22" Width="70"
                     CornerRadius="0" BorderBrush="#999" BorderThickness="1" />

            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding RpmLabel}" FontSize="11" Foreground="#666" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBox Classes="num" Grid.Row="0" Grid.Column="3" Text="{Binding RPM, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}, UpdateSourceTrigger=LostFocus}" FontSize="12" Height="22" Width="70"
                     CornerRadius="0" BorderBrush="#999" BorderThickness="1" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ToolDiameterLabel}" FontSize="11" Foreground="#666" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBox Classes="num" Grid.Row="1" Grid.Column="3" Text="{Binding ToolDiameter, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}, UpdateSourceTrigger=LostFocus}" FontSize="12" Height="22" Width="70"
                     CornerRadius="0" BorderBrush="#999" BorderThickness="1" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding FeedRateLabel}" FontSize="11" Foreground="#666" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBox Classes="num" Grid.Row="2" Grid.Column="3" Text="{Binding FeedRate, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}, UpdateSourceTrigger=LostFocus}" FontSize="12" Height="22" Width="70"
                     CornerRadius="0" BorderBrush="#999" BorderThickness="1" />
            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding PlungeRateLabel}" FontSize="11" Foreground="#666" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBox Classes="num" Grid.Row="3" Grid.Column="3" Text="{Binding PlungeRate, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}, UpdateSourceTrigger=LostFocus}" FontSize="12" Height="22" Width="70"
                     CornerRadius="0" BorderBrush="#999" BorderThickness="1" />
            <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding ScaleYLabel}" FontSize="11" Foreground="#666" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBox Classes="num" Grid.Row="4" Grid.Column="3" Text="{Binding ScaleY, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}, UpdateSourceTrigger=LostFocus}" FontSize="12" Height="22" Width="70"
                     CornerRadius="0" BorderBrush="#999" BorderThickness="1" />
        </Grid>
    </StackPanel>
</UserControl>