<!-- Labels are VM properties resolved through the hosting module's own locale
     catalog (module.converters.* keys) — plugin views cannot use the app-only
     {Loc} markup extension. -->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Modules.Shared"
             xmlns:conv="clr-namespace:SenderNG.Modules.Shared.Converters"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="240"
             x:Class="SenderNG.Modules.Shared.ConverterParametersView"
             x:DataType="vm:ConverterParametersViewModel">

    <StackPanel Spacing="6" Margin="8">
        <!-- One shared grid: label and input columns are common to every row,
             so all labels line up with their inputs and the inputs in each
             column start at the same x (labels right-align onto the inputs). -->
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="6"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ZHomeLabel}" FontSize="11" Foreground="{DynamicResource Sender.Text.Secondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBox Classes="num" Grid.Row="0" Grid.Column="1" Text="{Binding ZHome, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" FontSize="12" Height="22" Width="70"
                     CornerRadius="0" BorderBrush="{DynamicResource Sender.Border.Input}" BorderThickness="1" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ZRapidsLabel}" FontSize="11" Foreground="{DynamicResource Sender.Text.Secondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBox Classes="num" Grid.Row="1" Grid.Column="1" Text="{Binding ZRapids, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" FontSize="12" Height="22" Width="70"
                     CornerRadius="0" BorderBrush="{DynamicResource Sender.Border.Input}" BorderThickness="1" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding ZSafeLabel}" FontSize="11" Foreground="{DynamicResource Sender.Text.Secondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBox Classes="num" Grid.Row="2" Grid.Column="1" Text="{Binding ZSafe, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" FontSize="12" Height="22" Width="70"
                     CornerRadius="0" BorderBrush="{DynamicResource Sender.Border.Input}" BorderThickness="1" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding ZMinLabel}" FontSize="11" Foreground="{DynamicResource Sender.Text.Secondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBox Classes="num" Grid.Row="3" Grid.Column="1" Text="{Binding ZMin, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" FontSize="12" Height="22" Width="70"
                     CornerRadius="0" BorderBrush="{DynamicResource Sender.Border.Input}" BorderThickness="1" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding ScaleXLabel}" FontSize="11" Foreground="{DynamicResource Sender.Text.Secondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBox Classes="num" Grid.Row="4" Grid.Column="1" Text="{Binding ScaleX, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" FontSize="12" Height="22" Width="70"
                     CornerRadius="0" BorderBrush="{DynamicResource Sender.Border.Input}" BorderThickness="1" />

            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding RpmLabel}" FontSize="11" Foreground="{DynamicResource Sender.Text.Secondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBox Classes="num" Grid.Row="0" Grid.Column="3" Text="{Binding RPM, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" FontSize="12" Height="22" Width="70"
                     CornerRadius="0" BorderBrush="{DynamicResource Sender.Border.Input}" BorderThickness="1" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ToolDiameterLabel}" FontSize="11" Foreground="{DynamicResource Sender.Text.Secondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBox Classes="num" Grid.Row="1" Grid.Column="3" Text="{Binding ToolDiameter, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" FontSize="12" Height="22" Width="70"
                     CornerRadius="0" BorderBrush="{DynamicResource Sender.Border.Input}" BorderThickness="1" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding FeedRateLabel}" FontSize="11" Foreground="{DynamicResource Sender.Text.Secondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBox Classes="num" Grid.Row="2" Grid.Column="3" Text="{Binding FeedRate, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" FontSize="12" Height="22" Width="70"
                     CornerRadius="0" BorderBrush="{DynamicResource Sender.Border.Input}" BorderThickness="1" />
            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding PlungeRateLabel}" FontSize="11" Foreground="{DynamicResource Sender.Text.Secondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBox Classes="num" Grid.Row="3" Grid.Column="3" Text="{Binding PlungeRate, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" FontSize="12" Height="22" Width="70"
                     CornerRadius="0" BorderBrush="{DynamicResource Sender.Border.Input}" BorderThickness="1" />
            <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding ScaleYLabel}" FontSize="11" Foreground="{DynamicResource Sender.Text.Secondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBox Classes="num" Grid.Row="4" Grid.Column="3" Text="{Binding ScaleY, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" FontSize="12" Height="22" Width="70"
                     CornerRadius="0" BorderBrush="{DynamicResource Sender.Border.Input}" BorderThickness="1" />
        </Grid>

        <!-- Cut/laser selector: HPGL only (ShowCutMode), hidden for Excellon. -->
        <CheckBox Content="{Binding CutModeLabel}" IsChecked="{Binding CutMode, Mode=TwoWay}"
                  IsVisible="{Binding ShowCutMode}" FontSize="11" />

        <CheckBox Content="{Binding DoNotShowAgainLabel}" IsChecked="{Binding DoNotShowAgain, Mode=TwoWay}"
                  FontSize="11" />

        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{Binding OkLabel}" Command="{Binding OkCommand}"
                    Height="26" MinHeight="26" CornerRadius="0" FontSize="11"
                    Background="{DynamicResource Sender.Bg.Button}" BorderBrush="{DynamicResource Sender.Border.Input}" BorderThickness="1"
                    Padding="12,0" VerticalContentAlignment="Center" />
            <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}"
                    Height="26" MinHeight="26" CornerRadius="0" FontSize="11"
                    Background="{DynamicResource Sender.Bg.Button}" BorderBrush="{DynamicResource Sender.Border.Input}" BorderThickness="1"
                    Padding="12,0" VerticalContentAlignment="Center" />
        </StackPanel>
    </StackPanel>
</UserControl>