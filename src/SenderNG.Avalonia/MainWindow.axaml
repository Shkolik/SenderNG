<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SenderNG.Avalonia.ViewModels"
        xmlns:fixed="clr-namespace:SenderNG.Avalonia.Modules.Fixed"
        xmlns:m="clr-namespace:SenderNG.Core.Modules;assembly=SenderNG.Core"
        xmlns:conv="clr-namespace:SenderNG.Avalonia.Converters"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="SenderNG.Avalonia.MainWindow"
        x:DataType="vm:MainViewModel"
         Title="{Binding Title, FallbackValue=SenderNG}" Width="1000" Height="600"
         Background="#f6f6f6">

    <!-- Flyout strip buttons: width stays 32, height adapts to rotated text.
         Overrides app-wide fixed Button Height=28 (class selector beats type selector). -->
    <Window.Styles>
        <Style Selector="Button.flyoutToggle">
            <Setter Property="Height" Value="NaN" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="320,*,260,Auto" RowDefinitions="Auto,*,Auto,Auto">

        <!-- Row0: Menu + Toolbar (grid-column 0/3) -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                Background="#e8e8e8" BorderBrush="#aaa" BorderThickness="0,0,0,1" HorizontalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Stretch">
                <Menu Background="#e8e8e8" CornerRadius="0">
                    <MenuItem Header="_File">
                        <MenuItem Header="_Open" Command="{Binding OpenFileCommand}" />
                        <MenuItem Header="_Recent" ItemsSource="{Binding RecentFiles}">
                            <MenuItem.ItemContainerTheme>
                                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header" Value="{Binding}" />
                                    <Setter Property="Command" Value="{Binding $parent[Window].DataContext.SelectRecentCommand}" />
                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                </ControlTheme>
                            </MenuItem.ItemContainerTheme>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="_Connect" Command="{Binding ConnectCommand}" />
                        <MenuItem Header="_Disconnect" Command="{Binding DisconnectCommand}" />
                        <Separator />
                        <MenuItem Header="E_xit" Command="{Binding $parent[Window].Close}" />
                    </MenuItem>
                    <MenuItem Header="_Settings" ItemsSource="{Binding SettingsMenu}" x:CompileBindings="False">
                        <MenuItem.ItemContainerTheme>
                            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="Header" Value="{Binding Header}" />
                                <Setter Property="Command" Value="{Binding Command}" />
                                <Setter Property="CommandParameter" Value="{Binding Parameter}" />
                            </ControlTheme>
                        </MenuItem.ItemContainerTheme>
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem Header="_About" Command="{Binding AboutCommand}" />
                        <MenuItem Header="_Libraries" Command="{Binding LibrariesCommand}" />
                    </MenuItem>
                    <MenuItem Header="_Machine">
                        <MenuItem Header="_Demo Mode"
                                  IsChecked="{Binding IsDemo, Mode=OneWay}"
                                  Command="{Binding DemoToggleCommand}" />
                    </MenuItem>
                </Menu>
                <Border BorderBrush="#aaa" BorderThickness="0,1,0,0" Padding="4,2" Background="#e8e8e8" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- Toolbox buttons square 48x48 icon-only with ToolTip, contour icons -->
                        <Button Command="{Binding ConnectCommand}" ToolTip.Tip="Connect" Width="48" Height="48" MinHeight="48" CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <!-- Plug/connector outline (stroke only) -->
                            <Path Data="M7 2 L7 6 M13 2 L13 6 M5 6 L15 6 L15 10 C15 12.8 12.8 15 10 15 C7.2 15 5 12.8 5 10 Z M10 15 L10 18"
                                  Stroke="Black" StrokeThickness="1.5"
                                  Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button Command="{Binding OpenFileCommand}" ToolTip.Tip="Open" Width="48" Height="48" MinHeight="48" CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <!-- Folder outline (stroke only) -->
                            <Path Data="M3 5 h4 l2 2 h6 v7 a1 1 0 0 1 -1 1 H4 a1 1 0 0 1 -1 -1 Z"
                                  Stroke="Black" StrokeThickness="1.5"
                                  Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <!-- Toolbar extensible: additional module toolbar items can be added here via ItemsControl bound to ToolbarModules -->
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Col0 Row1: Left Border with 5 Expanders -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="White" BorderBrush="#aaa" BorderThickness="0,0,1,0" HorizontalAlignment="Stretch">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                <!-- DRO -->
                <Expander Grid.Row="0" IsExpanded="True" CornerRadius="0" Background="White"
                          BorderBrush="#aaa" BorderThickness="1" Margin="4,4,4,2" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock Text="{Binding DroHeader, FallbackValue='DRO'}" FontWeight="SemiBold" />
                    </Expander.Header>
                    <Border HorizontalAlignment="Stretch">
                        <ContentControl Content="{Binding DroContent}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" />
                    </Border>
                </Expander>

                <!-- Program limits: hidden until a program with motion is loaded -->
                <Expander Grid.Row="1" IsExpanded="True" CornerRadius="0" Background="White"
                          BorderBrush="#aaa" BorderThickness="1" Margin="4,2" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsVisible="{Binding HasProgramLimits}">
                    <Expander.Header>
                        <TextBlock Text="Program limits" FontWeight="SemiBold" />
                    </Expander.Header>
                    <Border Padding="6" HorizontalAlignment="Stretch">
                        <ItemsControl ItemsSource="{Binding ProgramLimitRows}" HorizontalAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="fixed:ProgramLimitRow">
                                    <Grid ColumnDefinitions="14,*,10,*,Auto" Margin="0,1" HorizontalAlignment="Stretch">
                                        <TextBlock Grid.Column="0" Text="{Binding Letter}" FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding Min, StringFormat={}{0:F3}, Mode=OneWay}" IsReadOnly="True"
                                                 Height="22" MinHeight="22" CornerRadius="0" BorderBrush="#999" BorderThickness="1" Padding="0"
                                                 FontSize="10" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="2,0" />
                                        <TextBlock Grid.Column="2" Text="-" VerticalAlignment="Center" TextAlignment="Center" FontSize="10" Foreground="#666" />
                                        <TextBox Grid.Column="3" Text="{Binding Max, StringFormat={}{0:F3}, Mode=OneWay}" IsReadOnly="True"
                                                 Height="22" MinHeight="22" CornerRadius="0" BorderBrush="#999" BorderThickness="1" Padding="0"
                                                 FontSize="10" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="2,0" />
                                        <TextBlock Grid.Column="4" Text="mm" VerticalAlignment="Center" FontSize="10" Foreground="#888" Margin="4,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Expander>

                <!-- Left plugins ItemsControl (flex:1 fills) — hidden when no extra left plugins (count <=2) -->
                <Expander Grid.Row="2" IsExpanded="True" CornerRadius="0" Background="White"
                          BorderBrush="#aaa" BorderThickness="1" Margin="4,2" Padding="0"
                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsVisible="{Binding LeftModules, Converter={x:Static conv:Converters.LeftPluginsVisible}}">
                    <Expander.Header>
                        <StackPanel>
                            <TextBlock Text="Left plugins" FontWeight="SemiBold" />
                            <TextBlock Text="fills available space (flex:1)" Foreground="#888" FontSize="9" />
                        </StackPanel>
                    </Expander.Header>
                    <ScrollViewer VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <ItemsControl ItemsSource="{Binding LeftModules}" Margin="4" HorizontalAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:IModule">
                                    <Border BorderBrush="#aaa" BorderThickness="1" CornerRadius="0" Margin="0,2" Padding="6" Background="#fafafa" HorizontalAlignment="Stretch">
                                        <TextBlock Text="{Binding Name}" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Expander>

                <!-- Signals (pinned bottom) — fixed, no Expander header, compact -->
                <Border Grid.Row="3" Background="White" BorderBrush="#aaa" BorderThickness="0,1,0,0" Margin="0" Padding="4,6" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding AxisSignals}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AxisSignal">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Stroke="#999" StrokeThickness="1"
                                                 Fill="{Binding IsActive, Converter={x:Static conv:Converters.SignalBrush}}"
                                                 HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Letter}" FontSize="10" Foreground="#333" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Probe indicator separate: red circle/rect when ProbeActive -->
                        <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Ellipse Width="10" Height="10" Stroke="#999" StrokeThickness="1"
                                     Fill="{Binding ProbeActive, Converter={x:Static conv:Converters.SignalBrush}}"
                                     HorizontalAlignment="Center" />
                            <TextBlock Text="Probe" FontSize="10" Foreground="#333" HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- State / Controls (pinned bottom) — fixed, no Expander, aligns with Cycle bar height 28 -->
                <Border Grid.Row="4" Background="White" BorderBrush="#aaa" BorderThickness="0,1,0,0" Margin="0" Padding="4" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <!-- State label sits outside the indicator block -->
                            <TextBlock Text="State" FontSize="12" FontWeight="SemiBold" Foreground="#333" VerticalAlignment="Center" />
                            <Border Width="72" Height="30" MinHeight="30" VerticalAlignment="Center" Background="{Binding StateBrush}" BorderBrush="#8a8" BorderThickness="1" CornerRadius="0" Padding="8,0">
                                <TextBlock Text="{Binding MachineStateDisplay}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{Binding StateForeground}" />
                            </Border>
                            <CheckBox Content="Check" FontSize="11" CornerRadius="0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*,*" HorizontalAlignment="Stretch">
                            <Button Grid.Column="0" Content="Home" Command="{Binding HomeCommand}" ToolTip.Tip="Home ($H)" CornerRadius="0" Background="#eee" Foreground="Black" BorderBrush="#999" BorderThickness="1" Margin="0,0,2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0" Height="28" MinHeight="28" />
                            <Button Grid.Column="1" Content="Unlock" Command="{Binding UnlockCommand}" ToolTip.Tip="Unlock ($X)" CornerRadius="0" Background="#eee" Foreground="Black" BorderBrush="#999" BorderThickness="1" Margin="2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0" Height="28" MinHeight="28" />
                            <Button Grid.Column="2" Content="Reset" Command="{Binding ResetCommand}" ToolTip.Tip="Reset (realtime)" CornerRadius="0" Background="#e04545" Foreground="White" BorderBrush="#b00" BorderThickness="1" Margin="2,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0" Height="28" MinHeight="28" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Col1 Row1: Center — TabControl with one tab per Center-claiming module (Program, Console) -->
        <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="#aaa" BorderThickness="1,0,0,0" HorizontalAlignment="Stretch">
            <Grid RowDefinitions="*,Auto">
                <TabControl Grid.Row="0" ItemsSource="{Binding CenterTabs}" CornerRadius="0" Background="White" Margin="4" HorizontalAlignment="Stretch">
                    <TabControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CenterTab">
                            <TextBlock Text="{Binding Module.Name}" FontSize="11" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:CenterTab">
                            <ContentControl Content="{Binding View}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>

                <!-- Cycle bar: 4 Buttons left-aligned below Center TabControl — Height 28, flat contour glyphs black/white on bg -->
                <Border Grid.Row="1" Background="#e8e8e8" BorderBrush="#aaa" BorderThickness="0,1,0,0" Padding="6" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Command="{Binding CycleStartCommand}" ToolTip.Tip="Cycle Start" CornerRadius="0" Background="#eee" Foreground="Black" BorderBrush="#999" BorderThickness="1" Padding="8,0" FontSize="11" Height="28" MinHeight="28" VerticalAlignment="Center" VerticalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <PathIcon Data="M6 5 L14 10 L6 15 Z" Width="12" Height="12" Foreground="Black" VerticalAlignment="Center" />
                                <TextBlock Text="Cycle Start" Foreground="Black" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding FeedHoldCommand}" ToolTip.Tip="Feed Hold" CornerRadius="0" Background="#eee" Foreground="Black" BorderBrush="#999" BorderThickness="1" Padding="8,0" FontSize="11" Height="28" MinHeight="28" VerticalAlignment="Center" VerticalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <PathIcon Data="M5 5 L7 5 L7 15 L5 15 Z M9 5 L11 5 L11 15 L9 15 Z" Width="12" Height="12" Foreground="Black" VerticalAlignment="Center" />
                                <TextBlock Text="Feed Hold" Foreground="Black" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding StopCommand}" ToolTip.Tip="Stop" CornerRadius="0" Background="#e04545" Foreground="White" BorderBrush="#b00" BorderThickness="1" Padding="8,0" FontSize="11" Height="28" MinHeight="28" VerticalAlignment="Center" VerticalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <PathIcon Data="M5 5 L11 5 L11 11 L5 11 Z" Width="12" Height="12" Foreground="White" VerticalAlignment="Center" />
                                <TextBlock Text="Stop" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RewindCommand}" ToolTip.Tip="Rewind" CornerRadius="0" Background="#eee" Foreground="Black" BorderBrush="#999" BorderThickness="1" Padding="8,0" FontSize="11" Height="28" MinHeight="28" VerticalAlignment="Center" VerticalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <PathIcon Data="M12 5 A6 6 0 1 0 12 15 L12 13 A4 4 0 1 1 12 7 Z M11 8 L8 11 L11 11 Z" Width="12" Height="12" Foreground="Black" VerticalAlignment="Center" />
                                <TextBlock Text="Rewind" Foreground="Black" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Col2 Row1: Right panel (own column — flyout strip never covers it); flyout drawer overlays on top -->
        <Panel x:Name="FlyoutHost" Grid.Row="1" Grid.Column="2">
            <Border Background="White" BorderBrush="#aaa" BorderThickness="1,0,0,0" HorizontalAlignment="Stretch" Margin="0,0,0,0">
                <ScrollViewer HorizontalAlignment="Stretch" Margin="0,0,0,0">
                    <StackPanel Spacing="2" Margin="4" HorizontalAlignment="Stretch">
                        <ItemsControl ItemsSource="{Binding RightModuleViews}" HorizontalAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ModuleView">
                                    <Expander IsExpanded="True" CornerRadius="0" Background="White"
                                              BorderBrush="#aaa" BorderThickness="1" Margin="0,2" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <Expander.Header>
                                            <TextBlock Text="{Binding Module.Name}" FontWeight="SemiBold" FontSize="11" />
                                        </Expander.Header>
                                        <Border Padding="4" HorizontalAlignment="Stretch">
                                            <ContentControl Content="{Binding View}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" />
                                        </Border>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Panel>

        <!-- Flyout drawer overlay — spans the full row (so it can grow wider than the
             right column), opens on top, left of the strip. Sizes to its content,
             capped by the host panel height and window width. -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                MinWidth="360" MaxWidth="{Binding $parent[Window].Width}"
                MaxHeight="{Binding #FlyoutHost.Bounds.Height}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="White" BorderBrush="#aaa" BorderThickness="1"
                IsVisible="{Binding SelectedModule, Converter={x:Static conv:Converters.IsFlyout}}">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0" Background="#e8e8e8" BorderBrush="#aaa" BorderThickness="0,0,0,1" Padding="6,4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding SelectedModule.Name, FallbackValue='Flyout'}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="✕" CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" Padding="6,0" Height="22" MinHeight="22" FontSize="10"
                                Command="{Binding SelectModuleCommand}" CommandParameter="{x:Null}" />
                    </Grid>
                </Border>
                <ContentControl Grid.Row="1" Content="{Binding CurrentModuleView}" Margin="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Grid>
        </Border>

        <!-- Col3 Row1: Flyout vertical 32px strip — dedicated column, never covers Right; Auto collapses when no Flyout claimants -->
        <Border Grid.Row="1" Grid.Column="3" Width="32"
                Background="#e0e0e0" BorderBrush="#aaa" BorderThickness="1,0,0,0"
                IsVisible="{Binding FlyoutModules, Converter={x:Static conv:Converters.HasElements}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FlyoutModules}" Margin="2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:IModule">
                            <Button Classes="flyoutToggle" CornerRadius="0" Background="#eee"
                                    BorderBrush="#999" BorderThickness="1"
                                    HorizontalAlignment="Stretch" FontSize="10"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectModuleCommand}"
                                    CommandParameter="{Binding}">
                                <LayoutTransformControl>
                                    <LayoutTransformControl.LayoutTransform>
                                        <RotateTransform Angle="-90" />
                                    </LayoutTransformControl.LayoutTransform>
                                    <TextBlock Text="{Binding Name}" FontSize="10" />
                                </LayoutTransformControl>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Row2: MDI editable ComboBox (IsEditable) Width=300 + Send + signals/limits summary -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                Background="White" BorderBrush="#aaa" BorderThickness="0,1,0,1" Padding="6" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="MDI" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ComboBox x:Name="MdiBox" Width="300" Height="28" MinHeight="28" IsEditable="True"
                          Text="{Binding MdiInput, Mode=TwoWay}"
                          ItemsSource="{Binding MdiHistory}"
                          PlaceholderText="Type GCode (UP/DOWN history)…"
                          CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                          VerticalAlignment="Center" VerticalContentAlignment="Center">
                    <ComboBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SendMdiCommand}" />
                        <KeyBinding Gesture="Up" Command="{Binding MdiHistoryPrevCommand}" />
                        <KeyBinding Gesture="Down" Command="{Binding MdiHistoryNextCommand}" />
                    </ComboBox.KeyBindings>
                </ComboBox>
                <Button Content="Send" Command="{Binding SendMdiCommand}" CornerRadius="0" Background="#eee" Foreground="Black" BorderBrush="#999" BorderThickness="1" Padding="12,0" Height="28" MinHeight="28" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                <TextBlock Text="{Binding Status}" Foreground="#666" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBlock Text="Signals: dynamic (see panel) | Limits: -0.07 – 70.07" Foreground="#888" FontSize="9" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.85" />
            </StackPanel>
        </Border>

        <!-- Row3: StatusBar -->
        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
                Background="#e8e8e8" BorderBrush="#aaa" BorderThickness="0,1,0,0" Padding="4,2" HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="Block: --/--" FontSize="10" Foreground="#666" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Ready" FontSize="10" Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Jog step: 0.05" FontSize="10" Foreground="#666" VerticalAlignment="Center" />
            </Grid>
        </Border>

    </Grid>
</Window>
