<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SenderNG.Avalonia.ViewModels"
        xmlns:m="clr-namespace:SenderNG.Core.Modules;assembly=SenderNG.Core"
        xmlns:conv="clr-namespace:SenderNG.Avalonia.Converters"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="SenderNG.Avalonia.MainWindow"
        x:DataType="vm:MainViewModel"
         Title="SenderNG" Width="1000" Height="600"
         Background="#f6f6f6">

    <Grid ColumnDefinitions="220,*,260,32" RowDefinitions="Auto,*,Auto,Auto">

        <!-- Row0: Menu + Toolbar (grid-column 0/4) -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                Background="#e8e8e8" BorderBrush="#aaa" BorderThickness="0,0,0,1">
            <StackPanel>
                <Menu Background="#e8e8e8" CornerRadius="0">
                    <MenuItem Header="_File">
                        <MenuItem Header="_Open" Command="{Binding OpenFileCommand}" />
                        <MenuItem Header="_Recent" ItemsSource="{Binding RecentFiles}">
                            <MenuItem.ItemTemplate>
                                <DataTemplate>
                                    <MenuItem Header="{Binding}" Command="{Binding $parent[Window].DataContext.SelectRecentCommand}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </MenuItem.ItemTemplate>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="_Connect" Command="{Binding ConnectCommand}" />
                        <MenuItem Header="_Disconnect" Command="{Binding DisconnectCommand}" />
                        <Separator />
                        <MenuItem Header="E_xit" Command="{Binding $parent[Window].Close}" />
                    </MenuItem>
                    <MenuItem Header="_Settings">
                        <MenuItem Header="_Machine" Command="{Binding MachineSettingsCommand}" />
                        <MenuItem Header="_App settings" Command="{Binding AppSettingsCommand}" />
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem Header="_About" Command="{Binding AboutCommand}" />
                        <MenuItem Header="_Libraries" Command="{Binding LibrariesCommand}" />
                    </MenuItem>
                    <MenuItem Header="_Machine">
                        <MenuItem Header="_Demo Mode"
                                  IsChecked="{Binding IsDemo, Mode=OneWay}"
                                  Command="{Binding DemoToggleCommand}" />
                    </MenuItem>
                </Menu>
                <Border BorderBrush="#aaa" BorderThickness="0,1,0,0" Padding="4,2" Background="#e8e8e8">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="Connect" Command="{Binding ConnectCommand}" CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" Padding="8,4" />
                        <Button Content="Open" Command="{Binding OpenFileCommand}" CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" Padding="8,4" />
                        <!-- Toolbar extensible: additional module toolbar items can be added here via ItemsControl bound to ToolbarModules -->
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Col0 Row1: Left Border with 5 Expanders -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="White" BorderBrush="#aaa" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                <!-- DRO -->
                <Expander Grid.Row="0" IsExpanded="True" CornerRadius="0" Background="White"
                          BorderBrush="#aaa" BorderThickness="1" Margin="4,4,4,2" Padding="0">
                    <Expander.Header>
                        <TextBlock Text="DRO" FontWeight="SemiBold" />
                    </Expander.Header>
                    <Border Padding="6">
                        <TextBlock Text="DRO — placeholder" Foreground="#888" FontSize="11" />
                    </Border>
                </Expander>

                <!-- Program limits -->
                <Expander Grid.Row="1" IsExpanded="True" CornerRadius="0" Background="White"
                          BorderBrush="#aaa" BorderThickness="1" Margin="4,2" Padding="0">
                    <Expander.Header>
                        <TextBlock Text="Program limits" FontWeight="SemiBold" />
                    </Expander.Header>
                    <Border Padding="6">
                        <TextBlock Text="X -0.075 – 70.075&#x0a;Y -0.075 – 120.075" Foreground="#888" FontSize="10" />
                    </Border>
                </Expander>

                <!-- Left plugins ItemsControl (flex:1 fills) -->
                <Expander Grid.Row="2" IsExpanded="True" CornerRadius="0" Background="White"
                          BorderBrush="#aaa" BorderThickness="1" Margin="4,2" Padding="0"
                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel>
                            <TextBlock Text="Left plugins" FontWeight="SemiBold" />
                            <TextBlock Text="fills available space (flex:1)" Foreground="#888" FontSize="9" />
                        </StackPanel>
                    </Expander.Header>
                    <ScrollViewer VerticalAlignment="Stretch">
                        <ItemsControl ItemsSource="{Binding LeftModules}" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:IModule">
                                    <Border BorderBrush="#aaa" BorderThickness="1" CornerRadius="0" Margin="0,2" Padding="6" Background="#fafafa">
                                        <TextBlock Text="{Binding Name}" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Expander>

                <!-- Signals (pinned bottom) -->
                <Expander Grid.Row="3" IsExpanded="True" CornerRadius="0" Background="White"
                          BorderBrush="#aaa" BorderThickness="1" Margin="4,2" Padding="0">
                    <Expander.Header>
                        <TextBlock Text="Signals" FontWeight="SemiBold" />
                    </Expander.Header>
                    <Border Padding="6">
                        <TextBlock Text="X Y Z  H S R P  ■ Probe" FontSize="10" Foreground="#666" />
                    </Border>
                </Expander>

                <!-- State / Controls (pinned bottom) -->
                <Expander Grid.Row="4" IsExpanded="True" CornerRadius="0" Background="White"
                          BorderBrush="#aaa" BorderThickness="1" Margin="4,2,4,4" Padding="0">
                    <Expander.Header>
                        <TextBlock Text="State / Controls" FontWeight="SemiBold" />
                    </Expander.Header>
                    <StackPanel Margin="6" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Background="#c8e8c8" BorderBrush="#8a8" BorderThickness="1" CornerRadius="0" Padding="6,2">
                                <TextBlock Text="State: RUN" FontSize="10" />
                            </Border>
                            <CheckBox Content="Check" FontSize="11" CornerRadius="0" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*,*">
                            <Button Grid.Column="0" Content="Home" CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" Margin="0,0,2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,4" />
                            <Button Grid.Column="1" Content="Unlock" CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" Margin="2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,4" />
                            <Button Grid.Column="2" Content="Reset" CornerRadius="0" Background="#e04545" Foreground="White" BorderBrush="#b00" BorderThickness="1" Margin="2,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,4" />
                        </Grid>
                    </StackPanel>
                </Expander>
            </Grid>
        </Border>

        <!-- Col1 Row1: Center TabControl + pinned Cycle bar -->
        <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="#aaa" BorderThickness="1,0,0,0">
            <Grid RowDefinitions="*,Auto">
                <TabControl Grid.Row="0" ItemsSource="{Binding CenterModules}" CornerRadius="0" Background="White" Margin="4">
                    <TabControl.ItemTemplate>
                        <DataTemplate x:DataType="m:IModule">
                            <TextBlock Text="{Binding Name}" FontSize="11" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate x:DataType="m:IModule">
                            <Border Padding="8" Background="#fafafa">
                                <TextBlock Text="{Binding Name, StringFormat='{}{0} — view placeholder'}" Foreground="#888" FontSize="11" />
                            </Border>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>

                <!-- Cycle bar: 4 Buttons left-aligned below Center TabControl -->
                <Border Grid.Row="1" Background="#e8e8e8" BorderBrush="#aaa" BorderThickness="0,1,0,0" Padding="6">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
                        <Button Content="▶ Cycle Start" Command="{Binding CycleStartCommand}" CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" Padding="8,4" FontSize="11" />
                        <Button Content="⏸ Feed Hold" Command="{Binding FeedHoldCommand}" CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" Padding="8,4" FontSize="11" />
                        <Button Content="■ Stop" Command="{Binding StopCommand}" CornerRadius="0" Background="#e04545" Foreground="White" BorderBrush="#b00" BorderThickness="1" Padding="8,4" FontSize="11" />
                        <Button Content="↺ Rewind" Command="{Binding RewindCommand}" CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" Padding="8,4" FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Col2 Row1: Right Expanders ItemsSource="{Binding RightModules}" -->
        <Border Grid.Row="1" Grid.Column="2" Background="White" BorderBrush="#aaa" BorderThickness="1,0,0,0">
            <ScrollViewer>
                <StackPanel Spacing="2" Margin="4">
                    <ItemsControl ItemsSource="{Binding RightModules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:IModule">
                                <Expander IsExpanded="True" CornerRadius="0" Background="White"
                                          BorderBrush="#aaa" BorderThickness="1" Margin="0,2" Padding="0">
                                    <Expander.Header>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" />
                                    </Expander.Header>
                                    <Border Padding="6">
                                        <TextBlock Text="{Binding Name, StringFormat='{}{0} content — placeholder'}" Foreground="#888" FontSize="11" />
                                    </Border>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- TODO(Task 4): 32px flyout gutter width is provisional (topology Task 3); revisit sizing/responsive behavior in Task 4 polish — leave as-is. -->
        <!-- Col3 Row1: Flyout vertical ItemsControl only if Count>0 -->
        <Border Grid.Row="1" Grid.Column="3"
                Background="#e0e0e0" BorderBrush="#aaa" BorderThickness="1,0,0,0"
                IsVisible="{Binding FlyoutModules, Converter={x:Static conv:Converters.HasElements}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FlyoutModules}" Margin="2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:IModule">
                            <Button Content="{Binding Name}" CornerRadius="0" Background="#eee"
                                    BorderBrush="#999" BorderThickness="1" Padding="4,8"
                                    HorizontalAlignment="Stretch" FontSize="10">
                                <!-- TODO(Task 4): RotateTransform 90° is provisional vertical-text placeholder; revisit Avalonia vertical writing-mode styling in Task 4 — leave as-is. -->
                                <Button.RenderTransform>
                                    <RotateTransform Angle="90" />
                                </Button.RenderTransform>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Row2: MDI TextBox Width=300 + Send + history dropdown (full width grid-column 1/5) + signals/limits summary -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                Background="White" BorderBrush="#aaa" BorderThickness="0,1,0,1" Padding="6">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="MDI" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBox x:Name="MdiBox" Width="300" Text="{Binding MdiInput, Mode=TwoWay}" PlaceholderText="Type GCode (UP/DOWN history)…" CornerRadius="0"
                         BorderBrush="#999" BorderThickness="1" Padding="4,3">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SendMdiCommand}" />
                        <KeyBinding Gesture="Up" Command="{Binding MdiHistoryPrevCommand}" />
                        <KeyBinding Gesture="Down" Command="{Binding MdiHistoryNextCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Content="Send" Command="{Binding SendMdiCommand}" CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" Padding="12,4" />
                <ComboBox PlaceholderText="History" CornerRadius="0" BorderBrush="#999" BorderThickness="1" Width="120"
                          ItemsSource="{Binding MdiHistory}" SelectedItem="{Binding MdiInput, Mode=TwoWay}" />
                <TextBlock Text="{Binding Status}" Foreground="#666" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBlock Text="Signals: X Y Z  H S R P  ■ Probe  |  Limits: -0.07 – 70.07" Foreground="#888" FontSize="9" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.85" />
            </StackPanel>
        </Border>

        <!-- Row3: StatusBar -->
        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
                Background="#e8e8e8" BorderBrush="#aaa" BorderThickness="0,1,0,0" Padding="4,2">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="Block: --/--" FontSize="10" Foreground="#666" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Ready" FontSize="10" Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Jog step: 0.05" FontSize="10" Foreground="#666" VerticalAlignment="Center" />
            </Grid>
        </Border>

    </Grid>
</Window>
