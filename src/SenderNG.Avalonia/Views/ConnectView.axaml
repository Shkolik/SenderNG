<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CNC.Core.ViewModels;assembly=SenderNG.Core"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="300"
             x:Class="SenderNG.Avalonia.Views.ConnectView"
             x:DataType="vm:ConnectViewModel">

    <Border Width="300" Padding="12" Background="#f6f6f6">
        <StackPanel Spacing="8">

            <!-- Serial port + refresh -->
            <TextBlock Text="Port" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="6">
                <ComboBox ItemsSource="{Binding Ports}"
                          SelectedItem="{Binding SelectedPort, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"
                          MinWidth="180" Height="28" CornerRadius="0"
                          BorderBrush="#999" BorderThickness="1" />
                <Button Content="⟳" Command="{Binding RefreshCommand}"
                        Width="28" Height="28" MinHeight="28" CornerRadius="0"
                        Background="#eee" BorderBrush="#999" BorderThickness="1"
                        ToolTip.Tip="Refresh port list" />
            </StackPanel>

            <!-- Baud rate -->
            <TextBlock Text="Baud rate" FontWeight="SemiBold" Margin="0,4,0,0" />
            <ComboBox ItemsSource="{Binding BaudRates}"
                      SelectedItem="{Binding BaudRate, Mode=TwoWay}"
                      MinWidth="120" Height="28" CornerRadius="0"
                      HorizontalAlignment="Left"
                      BorderBrush="#999" BorderThickness="1" />

            <!-- Networking: deliberately deferred. Disabled but visible so the
                 capability is discoverable (see P0 plan cross-platform note). -->
            <TextBlock Text="Network" FontWeight="SemiBold" Margin="0,4,0,0" IsEnabled="False" />
            <TextBlock Text="Address (host:port)"
                       FontSize="12" Foreground="#777" IsEnabled="False" />
            <TextBox Text="192.168.1.100:23" IsEnabled="False" CornerRadius="0"
                     BorderBrush="#999" BorderThickness="1" Height="24" />
            <TextBlock Text="{Binding NetworkNote}" FontSize="11" Foreground="#a33"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Connect" Command="{Binding ConnectCommand}"
                        Height="28" MinHeight="28" CornerRadius="0"
                        Background="#eee" BorderBrush="#999" BorderThickness="1"
                        Padding="12,0" VerticalContentAlignment="Center" />
                <Button Content="Cancel" Command="{Binding CancelCommand}"
                        Height="28" MinHeight="28" CornerRadius="0"
                        Background="#eee" BorderBrush="#999" BorderThickness="1"
                        Padding="12,0" VerticalContentAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>