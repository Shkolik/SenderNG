<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Avalonia.Modules.Fixed"
             x:Class="SenderNG.Avalonia.Modules.Fixed.OffsetsView"
             x:DataType="vm:OffsetsViewModel" mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="420">
    <UserControl.Styles>
        <!-- Axis cell label: centered over its column. -->
        <Style Selector="TextBlock.axisHeader">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBox.axisCell">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="MinWidth" Value="60" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="8" Spacing="6">

            <!-- Offset table header: offset-code column + one axis column each -->
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="Offset" Width="48" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ItemsControl Grid.Column="1" ItemsSource="{Binding AxisNames}" HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding AxisNames.Count}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" Classes="axisHeader" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Offset rows -->
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EditableOffsetRow">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="{Binding Code}" Width="48" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}" HorizontalAlignment="Stretch">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding Cells.Count}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OffsetCellViewModel">
                                        <TextBox Text="{Binding Value, Mode=TwoWay}" Classes="axisCell" VerticalAlignment="Stretch" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Selected offset + actions -->
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,6,0,0">
                <TextBlock Grid.Column="0" Text="Selected offset:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding OffsetCodes}" SelectedItem="{Binding SelectedOffset, Mode=TwoWay}" Width="100">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2" Content="Get current position" Command="{Binding GetCurrentPositionCommand}" Margin="6,0,0,0" CornerRadius="0" />
                <Button Grid.Column="3" Content="Clear all" Command="{Binding ClearAllCommand}" Margin="6,0,0,0" CornerRadius="0" />
                <Button Grid.Column="4" Content="Set all" Command="{Binding SetAllCommand}" Margin="6,0,0,0" CornerRadius="0" />
            </Grid>

            <!-- Tool table: optional (App Settings checkbox), hidden entirely when
                 the controller can't persist one. No redundant header — the editable
                 rows + a single Save button are self-explanatory. -->
            <StackPanel IsVisible="{Binding ShowToolTable}">
                <Separator Margin="0,4" />

                <StackPanel IsVisible="{Binding ControllerSupportsToolTable}">
                    <!-- Tool table header: tool name, axis cells, radius, save action -->
                    <Grid ColumnDefinitions="48,*,96">
                        <TextBlock Text="Tool" Width="48" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding ToolAxisNames}" HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding ToolAxisNames.Count}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}" Classes="axisHeader" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Column="2" Text="Radius" FontWeight="SemiBold"
                                   HorizontalAlignment="Stretch" TextAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Tool rows: axis cells + radius, one Save button below the table -->
                    <ItemsControl ItemsSource="{Binding Tools}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EditableToolRow">
                                <Grid ColumnDefinitions="48,*,96">
                                    <TextBlock Text="{Binding DisplayName}" Width="48" VerticalAlignment="Center" />
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}" HorizontalAlignment="Stretch">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="{Binding Cells.Count}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:OffsetCellViewModel">
                                                <TextBox Text="{Binding Value, Mode=TwoWay}" Classes="axisCell" VerticalAlignment="Stretch" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBox Grid.Column="2" Text="{Binding Radius, Mode=TwoWay}" CornerRadius="0"
                                             MinWidth="60" VerticalAlignment="Stretch" Margin="3,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- No tool table support: show why the editable table is hidden. -->
                <TextBlock IsVisible="{Binding !ControllerSupportsToolTable}"
                           Text="Tool table is unavailable on this controller (classic grbl 1.1 has no G10 L1)."
                           Foreground="#999" FontSize="11" TextWrapping="Wrap" />

                <Button Content="Save tool table (changed tools only)" Command="{Binding SaveToolTableCommand}"
                        IsEnabled="{Binding ControllerSupportsToolTable}"
                        HorizontalAlignment="Stretch" CornerRadius="0" Margin="0,4,0,0" />
            </StackPanel>

            <TextBlock Text="{Binding Status}" Foreground="#777" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>