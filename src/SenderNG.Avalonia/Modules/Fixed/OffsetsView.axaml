<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Avalonia.Modules.Fixed"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:Class="SenderNG.Avalonia.Modules.Fixed.OffsetsView"
             x:DataType="vm:OffsetsViewModel">

    <DockPanel>
        <Button DockPanel.Dock="Bottom" Content="Save Offsets"
                Command="{Binding SaveCommand}" Margin="8" HorizontalAlignment="Left" />
        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OffsetRow">
                    <Grid ColumnDefinitions="60,*,*,*" Margin="8,2">
                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                   VerticalAlignment="Center" FontWeight="Bold" />
                        <TextBox Grid.Column="1" Text="{Binding X, StringFormat={}{0:F3}}" Margin="4,2" PlaceholderText="X" />
                        <TextBox Grid.Column="2" Text="{Binding Y, StringFormat={}{0:F3}}" Margin="4,2" PlaceholderText="Y" />
                        <TextBox Grid.Column="3" Text="{Binding Z, StringFormat={}{0:F3}}" Margin="4,2" PlaceholderText="Z" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>
