<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Avalonia.Modules.Fixed"
             x:Class="SenderNG.Avalonia.Modules.Fixed.OffsetsView"
             x:DataType="vm:OffsetsViewModel" mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="420">
    <ScrollViewer>
        <StackPanel Margin="8" Spacing="6">

            <!-- Offset table header -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Offset" Width="48" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ItemsControl ItemsSource="{Binding AxisNames}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" Width="76" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,2,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Offset rows -->
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EditableOffsetRow">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="{Binding Code}" Width="48" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OffsetCellViewModel">
                                        <TextBox Text="{Binding Value, Mode=TwoWay}" Width="76" Margin="0,0,2,0" CornerRadius="0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Selected offset + actions -->
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,6,0,0">
                <TextBlock Grid.Column="0" Text="Selected offset:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding OffsetCodes}" SelectedItem="{Binding SelectedOffset, Mode=TwoWay}" Width="100">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2" Content="Get current position" Command="{Binding GetCurrentPositionCommand}" Margin="6,0,0,0" CornerRadius="0" />
                <Button Grid.Column="3" Content="Clear all" Command="{Binding ClearAllCommand}" Margin="6,0,0,0" CornerRadius="0" />
                <Button Grid.Column="4" Content="Set all" Command="{Binding SetAllCommand}" Margin="6,0,0,0" CornerRadius="0" />
            </Grid>

            <Separator Margin="0,4" />
            <TextBlock Text="Tool table" FontWeight="SemiBold" />

            <!-- Tool table header -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Tool" Width="48" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ItemsControl ItemsSource="{Binding ToolAxisNames}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" Width="76" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,2,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Radius" Width="76" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,2,0" />
                <TextBlock Text="Save" Width="64" FontWeight="SemiBold" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Tool rows -->
            <ItemsControl ItemsSource="{Binding Tools}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EditableToolRow">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="{Binding DisplayName}" Width="48" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ItemsControl ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:OffsetCellViewModel">
                                            <TextBox Text="{Binding Value, Mode=TwoWay}" Width="76" Margin="0,0,2,0" CornerRadius="0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox Text="{Binding Radius, Mode=TwoWay}" Width="76" Margin="0,0,2,0" CornerRadius="0" />
                                <Button Content="Save" Width="64" CornerRadius="0"
                                        Command="{Binding $parent[UserControl].((vm:OffsetsViewModel)DataContext).SaveToolCommand}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding Status}" Foreground="#777" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>