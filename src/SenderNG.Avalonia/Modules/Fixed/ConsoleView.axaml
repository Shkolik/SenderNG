<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Avalonia.Modules.Fixed"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
             x:Class="SenderNG.Avalonia.Modules.Fixed.ConsoleView"
             x:DataType="vm:ConsoleViewModel">

    <Border BorderBrush="#aaa" BorderThickness="1" CornerRadius="0" Background="#f6f6f6">
        <Grid RowDefinitions="Auto,*">

            <!-- Console settings (ioSender ConsoleControl parity): verbose output,
                 filter realtime status reports, show all realtime responses. -->
            <Border Grid.Row="0" Background="#e8e8e8" BorderBrush="#aaa" BorderThickness="0,0,0,1" Padding="4,3">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <CheckBox Content="Verbose" IsChecked="{Binding Verbose, Mode=TwoWay}"
                              FontSize="11" CornerRadius="0" VerticalAlignment="Center" />
                    <CheckBox Content="Filter out realtime responses"
                              IsChecked="{Binding FilterRealtime, Mode=TwoWay}"
                              IsEnabled="{Binding Verbose}"
                              FontSize="11" CornerRadius="0" VerticalAlignment="Center" />
                    <CheckBox Content="Show all realtime responses"
                              IsChecked="{Binding ShowAllRealtime, Mode=TwoWay}"
                              IsEnabled="{Binding Verbose}"
                              FontSize="11" CornerRadius="0" VerticalAlignment="Center" />
                    <Button Content="Clear" Command="{Binding ClearCommand}"
                            CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1"
                            Padding="10,0" Height="24" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <ListBox x:Name="ConsoleList" Grid.Row="1" ItemsSource="{Binding ConsoleLines}"
                     CornerRadius="0" BorderBrush="#aaa" BorderThickness="0"
                     FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Visible"
                     HorizontalAlignment="Stretch" />
        </Grid>
    </Border>
</UserControl>
