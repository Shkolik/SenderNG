<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Avalonia.Modules.Fixed"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
             x:Class="SenderNG.Avalonia.Modules.Fixed.ConsoleView"
             x:DataType="vm:ConsoleViewModel">

    <Border BorderBrush="#aaa" BorderThickness="1" CornerRadius="0" Background="#f6f6f6">
        <ListBox ItemsSource="{Binding ConsoleLines}" CornerRadius="0" BorderBrush="#aaa" BorderThickness="0"
                 HorizontalAlignment="Stretch" />
    </Border>
</UserControl>
