<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Avalonia.Modules.Fixed"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="480"
             x:Class="SenderNG.Avalonia.Modules.Fixed.GrblSettingsView"
             x:DataType="vm:GrblSettingsViewModel">

    <DockPanel Width="560" Background="#f6f6f6">

        <!-- Search -->
        <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="#aaa" BorderThickness="0,0,0,1">
            <TextBox Text="{Binding Search}" Watermark="Search settings..."
                     Height="26" MinHeight="26" VerticalContentAlignment="Center"
                     FontSize="11" CornerRadius="0" BorderBrush="#999" BorderThickness="1" />
        </Border>

        <!-- Description + status + actions -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#aaa" BorderThickness="0,1,0,0" Padding="8,6">
            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{Binding SelectedSetting.Name}" FontWeight="SemiBold"
                           FontSize="11" Foreground="#333" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{Binding SelectedSetting.Description}" FontSize="10"
                           Foreground="#666" TextWrapping="Wrap" MaxHeight="42"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                           Text="{Binding Status}" FontSize="10" Foreground="#888"
                           VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"
                           MaxWidth="180" />
                <Button Grid.Row="0" Grid.Column="2" Content="Load" Command="{Binding LoadCommand}"
                        Height="28" MinHeight="28" CornerRadius="0"
                        Background="#eee" BorderBrush="#999" BorderThickness="1"
                        Padding="12,0" VerticalContentAlignment="Center" Margin="0,0,6,0" />
                <Button Grid.Row="1" Grid.Column="2" Content="Save changes" Command="{Binding SaveCommand}"
                        Height="28" MinHeight="28" CornerRadius="0"
                        Background="#eee" BorderBrush="#999" BorderThickness="1"
                        Padding="12,0" VerticalContentAlignment="Center" />
            </Grid>
        </Border>

        <!-- Settings tree -->
        <ScrollViewer>
            <TreeView ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedNode}" Margin="4,6">
                <TreeView.Styles>
                    <!-- Bind the container's expansion state to the group view model so it
                         survives reloads and programmatic expand/collapse. ReflectionBinding
                         (not compiled): the setter runs against each item, and only group
                         items expose IsExpanded — leaves simply ignore it. -->
                    <Style Selector="TreeViewItem">
                        <Setter Property="IsExpanded"
                                Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.Styles>
                <TreeView.DataTemplates>
                    <TreeDataTemplate DataType="{x:Type vm:GrblSettingGroupItem}"
                                      ItemsSource="{Binding Children}"
                                      x:DataType="vm:GrblSettingGroupItem">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                   Foreground="#333" Margin="2,4,2,2" />
                    </TreeDataTemplate>

                    <DataTemplate DataType="{x:Type vm:GrblSettingItem}"
                                  x:DataType="vm:GrblSettingItem">
                        <Grid ColumnDefinitions="*,Auto" Margin="2,1">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontSize="11"
                                           Foreground="#666" />
                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#333"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="*" FontSize="12" FontWeight="Bold" Foreground="#c00"
                                           IsVisible="{Binding IsDirty}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding IsChecked}" IsVisible="{Binding IsBool}"
                                          VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex}"
                                          IsVisible="{Binding IsRadio}" Width="170" Height="24" MinHeight="24"
                                          FontSize="11" CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                                          VerticalContentAlignment="Center" />
                                <ItemsControl ItemsSource="{Binding Bits}" IsVisible="{Binding IsBits}"
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GrblSettingBit">
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}"
                                                      FontSize="10" Margin="0,0,10,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox Text="{Binding Value}" IsVisible="{Binding ShowTextBox}"
                                         Width="120" Height="24" MinHeight="24"
                                         VerticalContentAlignment="Center" FontSize="11"
                                         CornerRadius="0" BorderBrush="#999" BorderThickness="1" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </TreeView.DataTemplates>
            </TreeView>
        </ScrollViewer>
    </DockPanel>
</UserControl>
