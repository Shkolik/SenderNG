<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Avalonia.Modules.Fixed"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="220"
             x:Class="SenderNG.Avalonia.Modules.Fixed.DroView"
             x:DataType="vm:DroViewModel">

    <StackPanel Margin="4" Spacing="4">
        <ItemsControl ItemsSource="{Binding Axes}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AxisPosition">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1">
                        <TextBlock Grid.Column="0" Text="{Binding Letter}" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Width="14" TextAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Position, StringFormat={}{0:F3}, Mode=OneWay}"
                                 IsReadOnly="True" Height="24" MinHeight="24" CornerRadius="0"
                                 BorderBrush="#999" BorderThickness="1" Margin="4,0"
                                 VerticalContentAlignment="Center" FontSize="11" />
                        <Button Grid.Column="2" Content="0" Command="{Binding $parent[UserControl].((vm:DroViewModel)DataContext).ZeroAxisCommand}"
                                CommandParameter="{Binding Letter}"
                                Width="24" Height="24" MinHeight="24" CornerRadius="0"
                                Background="#eee" BorderBrush="#999" BorderThickness="1" Padding="0"
                                FontSize="11" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                ToolTip.Tip="Zero axis" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="Zero all axes" Command="{Binding ZeroAllCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Height="24" MinHeight="24" CornerRadius="0"
                Background="#eee" BorderBrush="#999" BorderThickness="1"
                FontSize="11" VerticalContentAlignment="Center" Margin="0,4,0,0" />

        <TextBlock Text="{Binding Status}" FontSize="9" Foreground="#888"
                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
    </StackPanel>
</UserControl>
