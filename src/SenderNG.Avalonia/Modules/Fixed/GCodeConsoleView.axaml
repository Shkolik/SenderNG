<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Avalonia.Modules.Fixed"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
             x:Class="SenderNG.Avalonia.Modules.Fixed.GCodeConsoleView"
             x:DataType="vm:GCodeConsoleViewModel">

    <TabControl Margin="4" CornerRadius="0" Background="White">
        <TabItem Header="Program" CornerRadius="0">
            <Border BorderBrush="#aaa" BorderThickness="1" CornerRadius="0" Background="White">
                <DockPanel>
                    <!-- Program grid header: 3 columns Line (44px) | Status (28px blank) | Data (1*) -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="44,28,1*" Background="#e8e8e8" Height="22">
                        <TextBlock Grid.Column="0" Text="Line" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" Margin="6,0" Foreground="#333" />
                        <TextBlock Grid.Column="1" Text="" />
                        <TextBlock Grid.Column="2" Text="Data" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" Margin="6,0" Foreground="#333" />
                    </Grid>
                    <ListBox ItemsSource="{Binding ProgramRows}" CornerRadius="0" BorderBrush="#aaa" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GCodeProgramRow">
                                <Grid ColumnDefinitions="44,28,1*">
                                    <TextBlock Grid.Column="0" Text="{Binding Line}" FontSize="10" Foreground="#666" VerticalAlignment="Center" Margin="4,0" HorizontalAlignment="Right" />
                                    <!-- Status cell: 28px no header, cells show ✓/✕/· with tooltip -->
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11" Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="{Binding Status}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Data}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" Margin="4,0" Foreground="#333" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </TabItem>
        <TabItem Header="Console" CornerRadius="0">
            <Border BorderBrush="#aaa" BorderThickness="1" CornerRadius="0" Background="White">
                <DockPanel>
                    <ListBox ItemsSource="{Binding ConsoleLines}" CornerRadius="0" BorderBrush="#aaa" BorderThickness="0" />
                </DockPanel>
            </Border>
        </TabItem>
    </TabControl>
</UserControl>
