<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Avalonia.Modules.Plugins"
             mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="200"
             x:Class="SenderNG.Avalonia.Modules.Plugins.MposView"
             x:DataType="vm:MposViewModel">

    <StackPanel Margin="8" Spacing="4">
        <ItemsControl ItemsSource="{Binding Axes}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MposAxis">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1">
                        <TextBlock Grid.Column="0" Text="{Binding Letter}" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Width="22" TextAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Position, StringFormat={}{0:F3}, Mode=OneWay}"
                                 IsReadOnly="True" Height="32" MinHeight="32" CornerRadius="0"
                                 BorderBrush="#999" BorderThickness="1" Margin="4,0" Padding="8,0"
                                 VerticalContentAlignment="Center" FontSize="14" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
