<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Avalonia.Modules.Plugins"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="260"
             x:Class="SenderNG.Avalonia.Modules.Plugins.CuttingView"
             x:DataType="vm:CuttingViewModel">

    <UserControl.Styles>
        <Style Selector="Button.ovr">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="#eee" />
            <Setter Property="BorderBrush" Value="#999" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.ovrToggle">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="#eee" />
            <Setter Property="BorderBrush" Value="#999" />
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          FontSize="{TemplateBinding FontSize}"
                                          Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.ovrToggle:checked">
            <Setter Property="Background" Value="#bdbdbd" />
            <Setter Property="BorderBrush" Value="#666" />
            <Setter Property="Foreground" Value="#111" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#333" />
        </Style>
        <Style Selector="TextBlock.ovrValue">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <StackPanel Margin="8" Spacing="8">

        <!-- Live feed & speed (FS: report field) -->
        <Border BorderBrush="#aaa" BorderThickness="1" Padding="8,5" Background="#f6f6f6">
            <StackPanel>
                <Grid ColumnDefinitions="*,*">
                    <TextBlock Grid.Column="0" Classes="caption" Text="Feed" />
                    <TextBlock Grid.Column="1" Classes="caption" Text="Speed" Grid.ColumnSpan="1" />
                </Grid>
                <Grid ColumnDefinitions="*,*" Margin="0,1,0,0">
                    <TextBlock Grid.Column="0" Text="{Binding Feed, StringFormat={}{0:F0} mm/min}" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding Speed, StringFormat={}{0:F0} rpm}" FontSize="13" FontWeight="SemiBold" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Feed override -->
        <StackPanel>
            <TextBlock Classes="caption" Text="Feed override" />
            <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,2,0,0">
                <Button Classes="ovr" Content="-10" Command="{Binding FeedCoarseMinusCommand}" />
                <Button Classes="ovr" Content="-1" Command="{Binding FeedFineMinusCommand}" />
                <TextBlock Classes="ovrValue" Text="{Binding FeedOvr, StringFormat={}{0}%}" />
                <Button Classes="ovr" Content="+1" Command="{Binding FeedFinePlusCommand}" />
                <Button Classes="ovr" Content="+10" Command="{Binding FeedCoarsePlusCommand}" />
                <Button Classes="ovr" Content="100" Command="{Binding FeedResetCommand}" ToolTip.Tip="Reset to 100%" />
            </StackPanel>
        </StackPanel>

        <!-- Rapids override -->
        <StackPanel>
            <TextBlock Classes="caption" Text="Rapids override" />
            <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,2,0,0">
                <ToggleButton Classes="ovrToggle" Content="100%"
                              IsChecked="{Binding IsRapidFull, Mode=OneWay}"
                              Command="{Binding RapidFullCommand}" />
                <ToggleButton Classes="ovrToggle" Content="50%"
                              IsChecked="{Binding IsRapidHalf, Mode=OneWay}"
                              Command="{Binding RapidHalfCommand}" />
                <ToggleButton Classes="ovrToggle" Content="25%"
                              IsChecked="{Binding IsRapidQuarter, Mode=OneWay}"
                              Command="{Binding RapidQuarterCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- Speed override + spindle on/off -->
        <StackPanel>
            <TextBlock Classes="caption" Text="Speed override" />
            <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,2,0,0">
                <Button Classes="ovr" Content="-10" Command="{Binding SpeedCoarseMinusCommand}" />
                <Button Classes="ovr" Content="-1" Command="{Binding SpeedFineMinusCommand}" />
                <TextBlock Classes="ovrValue" Text="{Binding SpindleOvr, StringFormat={}{0}%}" />
                <Button Classes="ovr" Content="+1" Command="{Binding SpeedFinePlusCommand}" />
                <Button Classes="ovr" Content="+10" Command="{Binding SpeedCoarsePlusCommand}" />
                <Button Classes="ovr" Content="100" Command="{Binding SpeedResetCommand}" ToolTip.Tip="Reset to 100%" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                <ToggleButton Classes="ovrToggle" Content="Spindle On/Off" Command="{Binding SpindleToggleCommand}"
                              ToolTip.Tip="Realtime spindle stop toggle" />
            </StackPanel>
        </StackPanel>

    </StackPanel>
</UserControl>
