<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Avalonia.Modules.Plugins"
             xmlns:loc="clr-namespace:SenderNG.Avalonia.Localization;assembly=SenderNG.Avalonia"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="260"
             x:Class="SenderNG.Avalonia.Modules.Plugins.CuttingView"
             x:DataType="vm:CuttingViewModel">

    <UserControl.Styles>
        <Style Selector="Button.ovr">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="#eee" />
            <Setter Property="BorderBrush" Value="#999" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.ovrToggle">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="#eee" />
            <Setter Property="BorderBrush" Value="#999" />
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          FontSize="{TemplateBinding FontSize}"
                                          Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.ovrToggle:checked">
            <Setter Property="Background" Value="#bdbdbd" />
            <Setter Property="BorderBrush" Value="#666" />
            <Setter Property="Foreground" Value="#111" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#333" />
        </Style>
        <Style Selector="TextBlock.ovrValue">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <StackPanel Margin="8" Spacing="8">

        <!-- Live feed & speed (FS: report field) -->
        <Border BorderBrush="#aaa" BorderThickness="1" Padding="8,5" Background="#f6f6f6">
            <StackPanel>
                <Grid ColumnDefinitions="*,*">
                    <TextBlock Grid.Column="0" Classes="caption" Text="{loc:Loc module.cutting.feed}" />
                    <TextBlock Grid.Column="1" Classes="caption" Text="{loc:Loc module.cutting.speed}" Grid.ColumnSpan="1" />
                </Grid>
                <Grid ColumnDefinitions="*,*" Margin="0,1,0,0">
                    <TextBlock Grid.Column="0" Text="{Binding Feed, StringFormat={}{0:F0} mm/min}" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding Speed, StringFormat={}{0:F0}}" FontSize="13" FontWeight="SemiBold" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Feed override: reset pinned to the right edge, value centered -->
        <StackPanel>
            <TextBlock Classes="caption" Text="{loc:Loc module.cutting.feedOverride}" />
            <Grid ColumnDefinitions="Auto,4,Auto,*,Auto,4,Auto, 10, Auto" Margin="0,2,0,0">
                <Button Grid.Column="0" Classes="ovr" Content="-10" Command="{Binding FeedCoarseMinusCommand}" />
                <Button Grid.Column="2" Classes="ovr" Content="-1" Command="{Binding FeedFineMinusCommand}" />
                <TextBlock Grid.Column="3" Classes="ovrValue" Text="{Binding FeedOvr, StringFormat={}{0}%}" />
                <Button Grid.Column="4" Classes="ovr" Content="+1" Command="{Binding FeedFinePlusCommand}" />
                <Button Grid.Column="6" Classes="ovr" Content="+10" Command="{Binding FeedCoarsePlusCommand}" />
                <Button Grid.Column="8" Classes="ovr" Content="100" Command="{Binding FeedResetCommand}" ToolTip.Tip="{loc:Loc module.cutting.reset100}" />
            </Grid>
        </StackPanel>

        <!-- Rapids override: widths roughly proportional to the value -->
        <StackPanel>
            <TextBlock Classes="caption" Text="{loc:Loc module.cutting.rapidsOverride}" />
            <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,2,0,0">
                <ToggleButton Classes="ovrToggle" Content="100%" Width="56"
                              IsChecked="{Binding IsRapidFull, Mode=OneWay}"
                              Command="{Binding RapidFullCommand}" />
                <ToggleButton Classes="ovrToggle" Content="50%" Width="44"
                              IsChecked="{Binding IsRapidHalf, Mode=OneWay}"
                              Command="{Binding RapidHalfCommand}" />
                <ToggleButton Classes="ovrToggle" Content="25%" Width="38"
                              IsChecked="{Binding IsRapidQuarter, Mode=OneWay}"
                              Command="{Binding RapidQuarterCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- Speed override + spindle on/off -->
        <StackPanel Margin="0,8,0,0">
            <TextBlock Classes="caption" Text="{loc:Loc module.cutting.speedOverride}" />
            <Grid ColumnDefinitions="Auto,4,Auto,*,Auto,4,Auto, 10, Auto" Margin="0,2,0,0">
                <Button Grid.Column="0" Classes="ovr" Content="-10" Command="{Binding SpeedCoarseMinusCommand}" />
                <Button Grid.Column="2" Classes="ovr" Content="-1" Command="{Binding SpeedFineMinusCommand}" />
                <TextBlock Grid.Column="3" Classes="ovrValue" Text="{Binding SpindleOvr, StringFormat={}{0}%}" />
                <Button Grid.Column="4" Classes="ovr" Content="+1" Command="{Binding SpeedFinePlusCommand}" />
                <Button Grid.Column="6" Classes="ovr" Content="+10" Command="{Binding SpeedCoarsePlusCommand}" />
                <Button Grid.Column="8" Classes="ovr" Content="100" Command="{Binding SpeedResetCommand}" ToolTip.Tip="{loc:Loc module.cutting.reset100}" />
            </Grid>

            <!-- Spindle control row: [rpm input] [CW] [CCW] [On/Off]; input and
                 direction buttons are disabled while the spindle is running. -->
            <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,12,0,0">
                <TextBox Width="64" Height="26" MinHeight="26" CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                         Padding="4,0" FontSize="11" VerticalContentAlignment="Center"
                         Text="{Binding SpindleRpm, Mode=TwoWay}"
                         IsEnabled="{Binding !IsSpindleOn}"
                         ToolTip.Tip="{loc:Loc module.cutting.spindleRpmHint}" />
                <Button Classes="ovr" Content="{loc:Loc module.cutting.cw}" Command="{Binding SpindleCwCommand}" ToolTip.Tip="{loc:Loc module.cutting.spindleCwHint}" />
                <Button Classes="ovr" Content="{loc:Loc module.cutting.ccw}" Command="{Binding SpindleCcwCommand}" ToolTip.Tip="{loc:Loc module.cutting.spindleCcwHint}" />
                <Button Classes="ovr" Content="{loc:Loc module.cutting.off}" Command="{Binding SpindleOffCommand}"
                        ToolTip.Tip="{loc:Loc module.cutting.spindleOffHint}"
                        Margin="6,0,0,0" />
            </StackPanel>
        </StackPanel>

    </StackPanel>
</UserControl>
