<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Avalonia.Modules.Plugins"
             mc:Ignorable="d" d:DesignWidth="250" d:DesignHeight="84"
             x:Class="SenderNG.Avalonia.Modules.Plugins.WorkParametersView"
             x:DataType="vm:WorkParametersViewModel">    <Border Background="#f6f6f6" Padding="6">
        <Grid RowDefinitions="Auto,Auto,Auto">
            <Grid ColumnDefinitions="*,*">
                <TextBlock Grid.Column="0" Text="Offset" />
                <TextBlock Grid.Column="1" Text="Tool" />
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,2,0,0">
                <ComboBox Grid.Column="0" ItemsSource="{Binding CoordinateSystemCodes}"
                          SelectedItem="{Binding SelectedCoordinateSystem, Mode=OneWay}"
                          SelectionChanged="CoordinateSystemChanged" CornerRadius="0" Height="28" Margin="0,0,6,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Tools}"
                          SelectedItem="{Binding SelectedToolRow, Mode=OneWay}"
                          SelectionChanged="ToolChanged" CornerRadius="0" Height="28">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ToolRow">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,3,0,0">
                <CheckBox IsChecked="{Binding IsTloReferenceSet, Mode=OneWay}" IsEnabled="False" />
                <TextBlock Text="TLO ref'd" VerticalAlignment="Center" />
                <TextBlock Text="TLO active" IsVisible="{Binding IsTloActive}" Foreground="#555" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
