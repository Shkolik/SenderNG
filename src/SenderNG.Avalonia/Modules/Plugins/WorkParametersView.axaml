<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Avalonia.Modules.Plugins"
             mc:Ignorable="d" d:DesignWidth="250" d:DesignHeight="84"
             x:Class="SenderNG.Avalonia.Modules.Plugins.WorkParametersView"
             x:DataType="vm:WorkParametersViewModel">
    <Border BorderBrush="#999" BorderThickness="1" Background="#f6f6f6" Padding="6">
        <StackPanel Spacing="6">
            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Column="0" Text="Offset:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding CoordinateSystemCodes}"
                          SelectedItem="{Binding SelectedCoordinateSystem, Mode=OneWay}"
                          SelectionChanged="CoordinateSystemChanged" CornerRadius="0" Height="24" />
                <TextBlock Grid.Column="2" Text="Tool:" VerticalAlignment="Center" Margin="10,0,6,0" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding Tools}"
                          SelectedItem="{Binding SelectedToolRow, Mode=OneWay}"
                          SelectionChanged="ToolChanged" CornerRadius="0" Height="24">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ToolRow">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" BorderBrush="#ccc" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,4,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <CheckBox IsChecked="{Binding IsTloReferenceSet, Mode=OneWay}" IsEnabled="False" />
                        <TextBlock Text="TLO ref'd" VerticalAlignment="Center" FontSize="11" />
                        <TextBlock Text="TLO active" IsVisible="{Binding IsTloActive}" Foreground="#555" VerticalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="{Binding Status}" Foreground="#777" FontSize="10" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
