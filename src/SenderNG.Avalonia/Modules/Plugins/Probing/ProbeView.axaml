<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Avalonia.Modules.Plugins"
             xmlns:panels="clr-namespace:SenderNG.Avalonia.Modules.Plugins"
             xmlns:conv="clr-namespace:SenderNG.Avalonia.Converters"
             xmlns:probing="clr-namespace:SenderNG.Core.Modules.Probing;assembly=SenderNG.Core"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="560"
             x:Class="SenderNG.Avalonia.Modules.Plugins.ProbeView"
             x:DataType="vm:ProbeViewModel">

    <UserControl.Styles>
        <!-- Flat group-box look: bordered card with a small header -->
        <Style Selector="Border.group">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#aaa" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <!-- Label + numeric field row -->
        <Style Selector="TextBlock.fld">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style Selector="TextBox.num">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderBrush" Value="#999" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- Tool strip toggle -->
        <Style Selector="RadioButton.tool">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Root" CornerRadius="0" BorderThickness="1" Padding="10,6"
                            Background="#eee" BorderBrush="#999" Margin="0,0,4,0">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.tool:checked /template/ Border#Root">
            <Setter Property="Background" Value="#ddd" />
            <Setter Property="BorderBrush" Value="#666" />
        </Style>
        <!-- Edge/corner selector buttons -->
        <Style Selector="RadioButton.edge">
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="#eee" />
            <Setter Property="BorderBrush" Value="#999" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="252,*">

        <!-- ============================ Left: profiles + settings ============================ -->
        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="6,4" Spacing="2">

                <!-- Profile selector -->
                <Grid ColumnDefinitions="*,24">
                    <ComboBox Grid.Column="0" Height="24" MinHeight="24" CornerRadius="0" BorderBrush="#999"
                              BorderThickness="1" FontSize="11"
                              ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                              IsEditable="True"
                              Text="{Binding NewProfileName, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="probing:ProbingProfile">
                                <TextBlock Text="{Binding Name}" FontSize="11" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="1" Content="..." Height="24" MinHeight="24" Padding="0" Margin="4,0,0,0"
                            CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" FontSize="10"
                            ToolTip.Tip="Profile actions">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Add" Command="{Binding ProfileAddCommand}" />
                                <MenuItem Header="Update" Command="{Binding ProfileUpdateCommand}" />
                                <MenuItem Header="Delete" Command="{Binding ProfileDeleteCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <!-- Probe tip/tool -->
                <Border Classes="group">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Probe tip/tool" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
                        <Grid ColumnDefinitions="110,*">
                            <TextBlock Classes="fld" Text="Diameter:" />
                            <TextBox Grid.Column="1" Classes="num" Text="{Binding ProbeDiameter, Mode=TwoWay, StringFormat='0.###'}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Touch plate/fixture height -->
                <Border Classes="group">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Touch plate/fixture height" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
                        <Grid ColumnDefinitions="110,*">
                            <TextBlock Classes="fld" Text="Touch plate:" />
                            <TextBox Grid.Column="1" Classes="num" Text="{Binding TouchPlateHeight, Mode=TwoWay, StringFormat='0.###'}" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*">
                            <TextBlock Classes="fld" Text="Fixture:" />
                            <TextBox Grid.Column="1" Classes="num" Text="{Binding FixtureHeight, Mode=TwoWay, StringFormat='0.###'}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Probing distances and speed -->
                <Border Classes="group">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Probing distances and speed" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
                        <Grid ColumnDefinitions="110,*">
                            <TextBlock Classes="fld" Text="Rapids feed rate:" ToolTip.Tip="Feed for rapid moves; 0 uses the controller setting" />
                            <TextBox Grid.Column="1" Classes="num" Text="{Binding RapidsFeedRate, Mode=TwoWay, StringFormat='0.###'}" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*">
                            <TextBlock Classes="fld" Text="Search feed rate:" ToolTip.Tip="Feed rate for the initial probing move" />
                            <TextBox Grid.Column="1" Classes="num" Text="{Binding ProbeFeedRate, Mode=TwoWay, StringFormat='0.###'}" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*">
                            <TextBlock Classes="fld" Text="Latch feed rate:" ToolTip.Tip="Feed rate for the second slow probing move" />
                            <TextBox Grid.Column="1" Classes="num" Text="{Binding LatchFeedRate, Mode=TwoWay, StringFormat='0.###'}" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*">
                            <TextBlock Classes="fld" Text="Probing distance:" ToolTip.Tip="Maximum distance of a probing move" />
                            <TextBox Grid.Column="1" Classes="num" Text="{Binding ProbeDistance, Mode=TwoWay, StringFormat='0.###'}" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*">
                            <TextBlock Classes="fld" Text="Latch distance:" ToolTip.Tip="Retract before the slow probe; 0 skips it" />
                            <TextBox Grid.Column="1" Classes="num" Text="{Binding LatchDistance, Mode=TwoWay, StringFormat='0.###'}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Probing clearances -->
                <Border Classes="group">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Probing clearances" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
                        <Grid ColumnDefinitions="110,*">
                            <TextBlock Classes="fld" Text="XY Clearance:" ToolTip.Tip="Initial distance away from the face to probe" />
                            <TextBox Grid.Column="1" Classes="num" Text="{Binding XYClearance, Mode=TwoWay, StringFormat='0.###'}" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*">
                            <TextBlock Classes="fld" Text="Offset:" ToolTip.Tip="Distance from the corner to the probe point" />
                            <TextBox Grid.Column="1" Classes="num" Text="{Binding Offset, Mode=TwoWay, StringFormat='0.###'}" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*">
                            <TextBlock Classes="fld" Text="Depth:" ToolTip.Tip="Z below the start position where XY probing happens" />
                            <TextBox Grid.Column="1" Classes="num" Text="{Binding Depth, Mode=TwoWay, StringFormat='0.###'}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Probe/touchplate XY offsets -->
                <Border Classes="group">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Probe/touchplate XY offsets" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
                        <Grid ColumnDefinitions="110,*">
                            <TextBlock Classes="fld" Text="X:" ToolTip.Tip="X offset from the probe to the controlled point" />
                            <TextBox Grid.Column="1" Classes="num" Text="{Binding ProbeOffsetX, Mode=TwoWay, StringFormat='0.###'}" />
                        </Grid>
                        <Grid ColumnDefinitions="110,*">
                            <TextBlock Classes="fld" Text="Y:" ToolTip.Tip="Y offset from the probe to the controlled point" />
                            <TextBox Grid.Column="1" Classes="num" Text="{Binding ProbeOffsetY, Mode=TwoWay, StringFormat='0.###'}" />
                        </Grid>
                        <CheckBox Content="Is touch plate" FontSize="11" IsChecked="{Binding TouchPlateIsXY}" />
                    </StackPanel>
                </Border>

                <!-- Coordinate writing -->
                <Border Classes="group">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Set offset" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <RadioButton Content="G10" FontSize="11" GroupName="cmode" IsChecked="{Binding IsCoordG10}" />
                            <RadioButton Content="G92" FontSize="11" GroupName="cmode" IsChecked="{Binding IsCoordG92}" />
                            <RadioButton Content="Measure" FontSize="11" GroupName="cmode" IsChecked="{Binding IsCoordMeasure}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="110,*">
                            <TextBlock Classes="fld" Text="System:" />
                            <ComboBox Grid.Column="1" Height="24" MinHeight="24" CornerRadius="0" BorderBrush="#999"
                                      BorderThickness="1" FontSize="11"
                                      ItemsSource="{Binding CoordinateSystemNames}"
                                      SelectedIndex="{Binding CoordinateSystemIndex, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Last result -->
                <TextBlock Text="{Binding LastResult}" TextWrapping="Wrap" FontSize="10" Foreground="#555"
                           FontFamily="Consolas,monospace" IsVisible="{Binding LastResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- ============================ Right: tool strip + panel ============================ -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto">

            <!-- Tool toggle strip (ioSender's inner TabControl as buttons) -->
            <WrapPanel Grid.Row="0" Margin="6,6,6,0">
                <RadioButton Classes="tool" GroupName="tool" Content="Tool length"
                             IsChecked="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=ToolLength}"
                             IsVisible="{Binding ToolLengthEnabled}" />
                <RadioButton Classes="tool" GroupName="tool" Content="Edge ext"
                             IsChecked="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=EdgeFinderExternal}"
                             IsVisible="{Binding EdgeExternalEnabled}" />
                <RadioButton Classes="tool" GroupName="tool" Content="Edge int"
                             IsChecked="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=EdgeFinderInternal}"
                             IsVisible="{Binding EdgeInternalEnabled}" />
                <RadioButton Classes="tool" GroupName="tool" Content="Rotation"
                             IsChecked="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=Rotation}"
                             IsVisible="{Binding RotationEnabled}" />
                <RadioButton Classes="tool" GroupName="tool" Content="Center"
                             IsChecked="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=CenterFinder}"
                             IsVisible="{Binding CenterEnabled}" />
                <RadioButton Classes="tool" GroupName="tool" Content="Height map"
                             IsChecked="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=HeightMap}"
                             IsVisible="{Binding HeightMapEnabled}" />
            </WrapPanel>

            <!-- Instructions + warning -->
            <Border Grid.Row="1" Margin="6,6,6,0" Padding="6" Background="#fff8e1" BorderBrush="#e0c060" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Instructions}" TextWrapping="Wrap" FontSize="11" Foreground="#333" />
                    <TextBlock Text="Warning! Use with care - incorrect parameters may damage your probe!"
                               Foreground="Red" FontWeight="Bold" FontSize="10" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Per-tool panel -->
            <Grid Grid.Row="2" Margin="6">
                <panels:ToolLengthPanel IsVisible="{Binding IsToolLength}" />
                <panels:EdgeFinderPanel IsVisible="{Binding IsEdgeExternal}" />
                <panels:EdgeFinderPanel IsVisible="{Binding IsEdgeInternal}" />
                <panels:CenterFinderPanel IsVisible="{Binding IsCenter}" />
                <panels:RotationPanel IsVisible="{Binding IsRotation}" />
                <panels:HeightMapPanel IsVisible="{Binding IsHeightMap}" />
            </Grid>

            <!-- Start / Stop -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6" Margin="6,0,6,6">
                <Button Content="Start" Command="{Binding StartCommand}" Width="90" Height="30" MinHeight="30"
                        CornerRadius="0" Background="#eee" Foreground="Black" BorderBrush="#999" BorderThickness="1"
                        VerticalContentAlignment="Center" />
                <Button Content="Stop" Command="{Binding StopCommand}" Width="90" Height="30" MinHeight="30"
                        CornerRadius="0" Background="#e04545" Foreground="White" BorderBrush="#b00" BorderThickness="1"
                        VerticalContentAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
