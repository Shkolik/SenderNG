<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SenderNG.Avalonia.Modules.Plugins"
             x:Class="SenderNG.Avalonia.Modules.Plugins.HeightMapPanel"
             x:DataType="vm:ProbeViewModel">

    <StackPanel Spacing="10" Margin="4" HorizontalAlignment="Stretch">
        <TextBlock Text="Probe a Z grid over the area. The map is stored relative to the first probed point."
                   FontSize="11" Foreground="#333" TextWrapping="Wrap" />

        <Border CornerRadius="0" Background="White" BorderBrush="#aaa" BorderThickness="1" Padding="6">
            <StackPanel Spacing="4">
                <TextBlock Text="Area" FontWeight="SemiBold" FontSize="11" />
                <Grid ColumnDefinitions="90,*,90,*" RowDefinitions="Auto,Auto" Width="430" HorizontalAlignment="Left">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Min X:" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding HmMinX, Mode=TwoWay, StringFormat='0.###'}"
                             Height="24" MinHeight="24" CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                             FontSize="11" Padding="4,0" VerticalContentAlignment="Center" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Max X:" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding HmMaxX, Mode=TwoWay, StringFormat='0.###'}"
                             Height="24" MinHeight="24" CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                             FontSize="11" Padding="4,0" VerticalContentAlignment="Center" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Min Y:" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HmMinY, Mode=TwoWay, StringFormat='0.###'}"
                             Height="24" MinHeight="24" CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                             FontSize="11" Padding="4,0" VerticalContentAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Max Y:" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding HmMaxY, Mode=TwoWay, StringFormat='0.###'}"
                             Height="24" MinHeight="24" CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                             FontSize="11" Padding="4,0" VerticalContentAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <Border CornerRadius="0" Background="White" BorderBrush="#aaa" BorderThickness="1" Padding="6">
            <StackPanel Spacing="4">
                <TextBlock Text="Grid" FontWeight="SemiBold" FontSize="11" />
                <Grid ColumnDefinitions="90,*,90,*" Width="360" HorizontalAlignment="Left">
                    <TextBlock Grid.Column="0" Text="Grid X:" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Grid.Column="1" Text="{Binding HmGridSizeX, Mode=TwoWay, StringFormat='0.###'}"
                             Height="24" MinHeight="24" CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                             FontSize="11" Padding="4,0" VerticalContentAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="2" Text="Grid Y:" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Grid.Column="3" Text="{Binding HmGridSizeY, Mode=TwoWay, StringFormat='0.###'}"
                             Height="24" MinHeight="24" CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                             FontSize="11" Padding="4,0" VerticalContentAlignment="Center" />
                </Grid>
                <CheckBox Content="Lock X/Y grid size" IsChecked="{Binding HmLockXY}" FontSize="11" />
                <CheckBox Content="Add pause between points" IsChecked="{Binding HmAddPause}" FontSize="11"
                          ToolTip.Tip="Wait for cycle start between probe points" />
                <CheckBox Content="Set tool offset after probing" IsChecked="{Binding HmSetToolOffset}" FontSize="11" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Save map" Command="{Binding HeightMapSaveCommand}" Padding="12,5" Height="28" MinHeight="28"
                    CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" FontSize="11" VerticalContentAlignment="Center" />
            <Button Content="Load map" Command="{Binding HeightMapLoadCommand}" Padding="12,5" Height="28" MinHeight="28"
                    CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" FontSize="11" VerticalContentAlignment="Center" />
            <Button Content="Apply to program" Command="{Binding HeightMapApplyCommand}" Padding="12,5" Height="28" MinHeight="28"
                    CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" FontSize="11" VerticalContentAlignment="Center"
                    IsEnabled="{Binding HasHeightMap}" />
            <Button Content="Export points" Command="{Binding HeightMapExportCommand}" Padding="12,5" Height="28" MinHeight="28"
                    CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" FontSize="11" VerticalContentAlignment="Center"
                    IsEnabled="{Binding HasHeightMap}"
                    ToolTip.Tip="Export the probed grid as an XYZ point cloud" />
        </StackPanel>
    </StackPanel>
</UserControl>
