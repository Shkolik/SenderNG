<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Avalonia.Modules.Plugins"
             xmlns:loc="clr-namespace:SenderNG.Avalonia.Localization;assembly=SenderNG.Avalonia"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="260"
             x:Class="SenderNG.Avalonia.Modules.Plugins.GotoView"
             x:DataType="vm:GotoViewModel">
    <ScrollViewer>
        <StackPanel Margin="8" Spacing="6">
            <TextBlock Text="{loc:Loc module.goto.referencePoints}" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                <Button Content="{loc:Loc module.goto.home}" Command="{Binding GotoHomeCommand}"
                        IsEnabled="{Binding IsHomed}" CornerRadius="0" />
                <Button Grid.Column="1" Content="{loc:Loc module.goto.ref2}" Command="{Binding GotoG30Command}"
                        IsEnabled="{Binding IsHomed}" CornerRadius="0" />
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                <Button Content="{loc:Loc module.goto.setHome}" Command="{Binding SetHomeCommand}"
                        IsEnabled="{Binding IsHomed}" CornerRadius="0" />
                <Button Grid.Column="1" Content="{loc:Loc module.goto.setRef2}" Command="{Binding SetG30Command}"
                        IsEnabled="{Binding IsHomed}" CornerRadius="0" />
            </Grid>

            <Separator Margin="0,2" />

            <TextBlock Text="{loc:Loc module.goto.position}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ItemsControl ItemsSource="{Binding GotoAxes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GotoAxisRow">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                            <TextBlock Grid.Column="0" Text="{Binding Letter}" FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Width="22" TextAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" Height="32" MinHeight="32"
                                     CornerRadius="0" BorderBrush="#999" BorderThickness="1" Margin="4,0"
                                     Padding="8,0" VerticalContentAlignment="Center" FontSize="14" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="{loc:Loc common.go}" Command="{Binding GoCommand}" IsEnabled="{Binding IsHomed}"
                    CornerRadius="0" HorizontalAlignment="Stretch" />

            <TextBlock Text="{Binding Status}" Foreground="#777" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
