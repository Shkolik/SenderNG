<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The plugin SDK (docs/plugin-development.md): generic, UI-free machinery
         any plugin type can reuse (contracts via SenderNG.Core, generic settings
         helpers). Ships with the app in Modules/ — plugins reference it, never
         bundle it. No Avalonia: the SDK shares no UI; plugins that need views
         reference Avalonia themselves, pinned to the host's resolved version. -->
    <RootNamespace>SenderNG.Modules.Common</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SenderNG.Core\SenderNG.Core.csproj" />
  </ItemGroup>

</Project>