<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SenderNG.Modules.HeightMapViewer"
             x:Class="SenderNG.Modules.HeightMapViewer.HeightMapViewerView"
             x:DataType="vm:HeightMapViewerViewModel"
             x:CompileBindings="False">
    <!-- GL context + viewport client live on the code-behind (concrete types);
         the view model stays headless. The scene renders offscreen and is read
         back into a WriteableBitmap by a DispatcherTimer tick; GpuImage shows
         the result. Chrome mirrors the 3D plotter: a bottom-right zoom cluster
         (− ⛶ +, with a percent readout) and a bottom-left save-screenshot
         button. The empty-state TextBlock overlays the viewport while no layer
         has been published; the fallback panel replaces the viewport when no GL
         context could be created. -->
    <Border BorderBrush="{DynamicResource Sender.Border}" BorderThickness="1" Background="{DynamicResource Sender.Bg.Panel}">
        <Panel x:Name="ScenePanel">
            <Image x:Name="GpuImage" Stretch="UniformToFill"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />

            <Panel x:Name="PlotInput"
                   Background="Transparent"
                   PointerPressed="OnPlotInputPointerPressed"
                   PointerMoved="OnPlotInputPointerMoved"
                   PointerReleased="OnPlotInputPointerReleased"
                   PointerCaptureLost="OnPlotInputPointerCaptureLost"
                   PointerWheelChanged="OnPlotInputPointerWheelChanged">
                <Panel.Styles>
                    <!-- Shared navigation-button chrome (ported from the 3D plotter):
                         flat 32x32 buttons with a #777 glyph. -->
                    <Style Selector="Button.navBtn">
                        <Setter Property="Width" Value="32" />
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="FontSize" Value="24" />
                        <Setter Property="Foreground" Value="{DynamicResource Sender.Text.Caption}" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter x:Name="PART_ContentPresenter"
                                                  Background="Transparent"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalContentAlignment="Center"
                                                  VerticalContentAlignment="Center" />
                            </ControlTemplate>
                        </Setter>
                    </Style>
                    <Style Selector="Button.navBtn:pointerover">
                        <Setter Property="Foreground" Value="{DynamicResource Sender.Icon.Hover}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>
                    <Style Selector="Button.navBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Foreground" Value="{DynamicResource Sender.Icon.Hover}" />
                    </Style>
                    <Style Selector="Button.navBtn:pressed">
                        <Setter Property="Foreground" Value="{DynamicResource Sender.Text.Strong}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>
                    <Style Selector="Button.navBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Foreground" Value="{DynamicResource Sender.Text.Strong}" />
                    </Style>
                </Panel.Styles>

                <TextBlock x:Name="EmptyTextBlock"
                           Text="{Binding EmptyText}"
                           IsVisible="{Binding IsEmpty, Mode=OneWay}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="24" MaxWidth="460"
                           Foreground="{DynamicResource Sender.Text.Muted}" FontSize="14"
                           TextWrapping="Wrap" TextAlignment="Center" />

                <!-- Top-left stats overlay: measured-point count and max Z
                     deviation, or hidden while no layer is loaded. -->
                <TextBlock x:Name="StatsTextBlock"
                           Text="{Binding StatsText}"
                           IsVisible="{Binding StatsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                           Foreground="{DynamicResource Sender.Text.Caption}" FontSize="12" />

                <!-- Bottom-left: save the current view (the readback frame at its
                     native size) as a PNG through the standard save dialog. -->
                <Button x:Name="SaveScreenshotButton" Classes="navBtn"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                        Click="OnSaveScreenshot">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="1.3"
                          Data="M 2,1 L 12,1 L 14,3 L 14,14 L 2,14 Z M 4,1 L 4,6 L 12,6 L 12,1 M 3,14 L 3,9 L 13,9 L 13,14 M 6,2 L 10,2" />
                </Button>

                <!-- Bottom-right: − ⛶ + zoom cluster with a percent readout above. -->
                <StackPanel Orientation="Vertical" Spacing="6"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12">
                    <TextBlock x:Name="ZoomPctText" Text="100%" FontSize="12" Foreground="{DynamicResource Sender.Text.Caption}"
                               HorizontalAlignment="Center" IsVisible="False" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="ZoomOutButton" Classes="navBtn" Content="&#x2212;" Click="OnZoomOut" />
                        <Button x:Name="ReframeButton" Classes="navBtn" Content="&#x26F6;" Click="OnReframe" />
                        <Button x:Name="ZoomInButton" Classes="navBtn" Content="+" Click="OnZoomIn" />
                    </StackPanel>
                </StackPanel>
            </Panel>

            <Border x:Name="FallbackPanel" Background="Transparent" IsVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="6" MaxWidth="460">
                    <TextBlock x:Name="FallbackTitle" Text=""
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Sender.Text.Strong}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="FallbackHint" Text=""
                               Foreground="{DynamicResource Sender.Text.Muted}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Panel>
    </Border>
</UserControl>
