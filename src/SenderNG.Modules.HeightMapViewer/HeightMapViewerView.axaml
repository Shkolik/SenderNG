<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SenderNG.Modules.HeightMapViewer"
             x:Class="SenderNG.Modules.HeightMapViewer.HeightMapViewerView"
             x:DataType="vm:HeightMapViewerViewModel"
             x:CompileBindings="False">
    <!-- GL context + viewport client live on the code-behind (concrete types);
         the view model stays headless. The scene renders offscreen and is read
         back into a WriteableBitmap by a DispatcherTimer tick; GpuImage shows
         the result. The empty-state TextBlock overlays the viewport while no
         layer has been published; the fallback panel replaces the viewport when
         no GL context could be created. -->
    <Border BorderBrush="#aaa" BorderThickness="1" Background="White">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="#e8e8e8" Height="26">
                <DockPanel Margin="8,0,6,0">
                    <Button x:Name="ResetViewButton" DockPanel.Dock="Right"
                            Content="Reset view" FontSize="11" Padding="8,1"
                            VerticalAlignment="Center" Click="OnResetView" />
                    <TextBlock x:Name="HeaderText" Text="Height map 3D"
                               VerticalAlignment="Center" FontSize="11"
                               FontWeight="SemiBold" Foreground="#333" />
                </DockPanel>
            </Border>

            <Panel x:Name="ScenePanel">
                <Image x:Name="GpuImage" Stretch="UniformToFill"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />

                <Panel x:Name="PlotInput"
                       Background="Transparent"
                       PointerPressed="OnPlotInputPointerPressed"
                       PointerMoved="OnPlotInputPointerMoved"
                       PointerReleased="OnPlotInputPointerReleased"
                       PointerCaptureLost="OnPlotInputPointerCaptureLost"
                       PointerWheelChanged="OnPlotInputPointerWheelChanged">
                    <TextBlock x:Name="EmptyTextBlock"
                               Text="{Binding EmptyText}"
                               IsVisible="{Binding IsEmpty, Mode=OneWay}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="24" MaxWidth="460"
                               Foreground="#555" FontSize="14"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </Panel>
            </Panel>

            <Border x:Name="FallbackPanel" Background="Transparent" IsVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="6" MaxWidth="460">
                    <TextBlock x:Name="FallbackTitle" Text=""
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="#222" HorizontalAlignment="Center" />
                    <TextBlock x:Name="FallbackHint" Text=""
                               Foreground="#555" TextWrapping="Wrap"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
