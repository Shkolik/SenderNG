<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Modules.Plotter.Settings"
             mc:Ignorable="d" d:DesignWidth="240" d:DesignHeight="180"
             x:Class="SenderNG.Modules.Plotter.Settings.PlotterSettingsView"
             x:DataType="vm:PlotterSettingsViewModel">
    <!-- The four view toggles, and nothing else. The per-plane world-axis combos
         and origin rows that used to sit below them are deleted: within a plane
         slot k feeds world axis k, so there is no mapping to choose. Every label
         is a *Label property on the model, resolved code-side — plugin views
         cannot use the app-only {Loc} markup (PlotterSettingsViewModel.Resolve). -->
    <StackPanel Spacing="4">
        <TextBlock Text="{Binding ViewLabel}" FontSize="12" FontWeight="SemiBold"
                   Foreground="#333" Margin="0,6,0,0" />
        <Grid ColumnDefinitions="Auto,24,Auto" RowDefinitions="Auto,Auto">
            <CheckBox Grid.Column="0" Grid.Row="0" Content="{Binding ShowGridLabel}"
                      IsChecked="{Binding ShowGrid, Mode=TwoWay}" FontSize="11" />
            <CheckBox Grid.Column="0" Grid.Row="1" Content="{Binding ShowOriginLabel}"
                      IsChecked="{Binding ShowOrigin, Mode=TwoWay}" FontSize="11" />
            <CheckBox Grid.Column="2" Grid.Row="0" Content="{Binding ShowRunStateLabel}"
                      IsChecked="{Binding ShowRunState, Mode=TwoWay}" FontSize="11" />
            <CheckBox Grid.Column="2" Grid.Row="1" Content="{Binding ShowEnvelopeLabel}"
                      IsChecked="{Binding ShowEnvelope, Mode=TwoWay}" FontSize="11" />
        </Grid>
    </StackPanel>
</UserControl>
