<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Modules.Plotter"
             xmlns:s="clr-namespace:SenderNG.Modules.Plotter.Settings"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="SenderNG.Modules.Plotter.PlotterView"
             x:DataType="vm:PlotterViewModel">

    <!-- The plot canvases are custom-drawn (code-behind) — this layout hosts
         them: one canvas for single-plane machines, the same one canvas for
         foam with the two carriage planes drawn in diagonal quadrants (XY
         top-left, ZA bottom-right), and one full-panel canvas for the
         isometric view, plus a header row and a progress line. -->
    <Border BorderBrush="#aaa" BorderThickness="1" Background="White">
        <DockPanel>
            <Border x:Name="HeaderHost" DockPanel.Dock="Top" Background="#e8e8e8" Height="24">
                <DockPanel Margin="6,0">
                    <CheckBox x:Name="IsoToggle" DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderLetters" FontSize="11" FontWeight="SemiBold" Foreground="#333" />
                        <TextBlock x:Name="ProgressText" FontSize="11" Foreground="#666" Margin="12,0,0,0" />
                        <TextBlock x:Name="StatusTextBlock" FontSize="11" Foreground="#b03030" Margin="12,0,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid>
                <!-- The plot canvases are custom-drawn (code-behind): RebuildCanvases owns this grid's columns and rows. -->
                <Grid x:Name="PlanesGrid" />

                <!-- The view chrome, OVERLAID on the plot rather than put in the header:
                     - the header row is 24px and already carries the iso toggle;
                     - the PNG export (Task 12) paints through fresh canvases and never
                       instantiates this XAML, so nothing in here can reach a saved image —
                       "the PNG has no buttons in it" is true by construction, not by
                       remembering to clip the header out.
                       OverlayHost carries its own DataContext ({x:Null} stops it inheriting the
                       root's PlotterViewModel) and its own x:DataType, or every compiled binding
                       below would be type-checked against the plot view model, which has none of
                        these properties.

                        Input: the wheel and drag belong to the canvas UNDER this
                        overlay, so the overlay's empty regions must not swallow
                        them. An Avalonia Grid answers a hit test for its CHILDREN
                        only - over its own empty space it returns nothing and the
                        hit passes through - so that is the wanted shape here, and
                        the eight controls on top are real targets, so a click on a
                        toggle or a zoom button still works.

                        That relies on the canvas beneath being a hit target over
                        its whole area, which it is NOT for free: a custom-drawn
                        control is only hit-tested where it paints, and the toolpath
                        covers little of the plot. This was a live bug - at low zoom
                        the wheel and drag fell through to the white Border below at
                        every probed point. PlotterView.PlotCanvas now implements
                        Avalonia.Rendering.ICustomHitTest to claim its whole box.
                        Do not remove it. -->

                <Grid x:Name="OverlayHost" DataContext="{x:Null}"
                      x:DataType="s:PlotterSettingsViewModel">
                    <StackPanel x:Name="TogglesPanel"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,6,6,0" Spacing="1">
                        <CheckBox x:Name="GridToggle" FontSize="11"
                                  IsChecked="{Binding ShowGrid}"
                                  Content="{Binding ShowGridLabel}"
                                  ToolTip.Tip="{Binding ShowGridLabel}" />
                        <CheckBox x:Name="OriginToggle" FontSize="11"
                                  IsChecked="{Binding ShowOrigin}"
                                  Content="{Binding ShowOriginLabel}"
                                  ToolTip.Tip="{Binding ShowOriginLabel}" />
                        <CheckBox x:Name="EnvelopeToggle" FontSize="11"
                                  IsChecked="{Binding ShowEnvelope}"
                                  Content="{Binding ShowEnvelopeLabel}"
                                  ToolTip.Tip="{Binding ShowEnvelopeLabel}" />
                        <CheckBox x:Name="RunStateToggle" FontSize="11"
                                  IsChecked="{Binding ShowRunState}"
                                  Content="{Binding ShowRunStateLabel}"
                                  ToolTip.Tip="{Binding ShowRunStateLabel}" />
                    </StackPanel>

                    <StackPanel x:Name="ZoomPanel"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,6,6" Orientation="Horizontal" Spacing="2">
                        <TextBlock x:Name="ZoomPctText" FontSize="11" Foreground="#333"
                                   VerticalAlignment="Center" IsVisible="False" />
                        <Button x:Name="ZoomOutButton" Content="−" Width="24" Height="20"
                                Click="OnZoomOut" ToolTip.Tip="{Binding ZoomOutLabel}" />
                        <Button x:Name="ZoomFitButton" Content="⛶" Width="24" Height="20"
                                Click="OnZoomFit" ToolTip.Tip="{Binding ZoomFitLabel}" />
                        <Button x:Name="ZoomInButton" Content="+" Width="24" Height="20"
                                Click="OnZoomIn" ToolTip.Tip="{Binding ZoomInLabel}" />
                    </StackPanel>

                    <Button x:Name="SavePngButton" Content="⤓" Width="24" Height="20"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="6,0,0,6"
                            Click="OnSavePng" ToolTip.Tip="{Binding SavePngLabel}" />
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
