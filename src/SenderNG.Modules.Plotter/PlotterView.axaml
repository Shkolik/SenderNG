<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Modules.Plotter"
             xmlns:s="clr-namespace:SenderNG.Modules.Plotter.Settings"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="SenderNG.Modules.Plotter.PlotterView"
             x:DataType="vm:PlotterViewModel">

    <!-- The plot canvases are custom-drawn (code-behind) — this layout hosts
         them: one canvas for single-plane machines, the same one canvas for
         foam with the two carriage planes drawn in diagonal quadrants (XY
         top-left, ZA bottom-right), and one full-panel canvas for the
         isometric view, plus a header row and a progress line. -->
    <Border BorderBrush="#aaa" BorderThickness="1" Background="White">
        <DockPanel>
            <Border x:Name="HeaderHost" DockPanel.Dock="Top" Background="#e8e8e8" Height="24">
                <DockPanel Margin="6,0">
                    <CheckBox x:Name="IsoToggle" DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderLetters" FontSize="11" FontWeight="SemiBold" Foreground="#333" />
                        <TextBlock x:Name="ProgressText" FontSize="11" Foreground="#666" Margin="12,0,0,0" />
                        <TextBlock x:Name="StatusTextBlock" FontSize="11" Foreground="#b03030" Margin="12,0,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid>
                <!-- The plot canvases are custom-drawn (code-behind): RebuildCanvases owns this grid's columns and rows. -->
                <Grid x:Name="PlanesGrid" />

                <!-- <para>The view chrome, OVERLAID on the plot rather than put in the header:
                     - the header row is 24px and already carries the iso toggle;
                     - the PNG export (Task 12) paints through fresh canvases and never
                       instantiates this XAML, so nothing in here can reach a saved image —
                       "the PNG has no buttons in it" is true by construction, not by
                        remembering to clip the header out.
                     </para>
                     <para>OverlayHost carries its own DataContext ({x:Null} stops it inheriting the
                     root's PlotterViewModel) and its own x:DataType, or every compiled binding
                     below would be type-checked against the plot view model, which has none of
                     these properties.</para>
                     <para>Input: the wheel and drag belong to the canvas UNDER this
                     overlay, so the overlay's empty regions must not swallow
                     them. An Avalonia Grid answers a hit test for its CHILDREN
                     only - over its own empty space it returns nothing and the
                     hit passes through - so that is the wanted shape here, and
                     the eight controls on top are real targets, so a click on a
                     toggle or a zoom button still works.</para>
                     <para>That relies on the canvas beneath being a hit target over
                     its whole area, which it is NOT for free: a custom-drawn
                     control is only hit-tested where it paints, and the toolpath
                     covers little of the plot. This was a live bug - at low zoom
                     the wheel and drag fell through to the white Border below at
                     every probed point. PlotterView.PlotCanvas now implements
                     Avalonia.Rendering.ICustomHitTest to claim its whole box.
                     Do not remove it.</para>
                     -->

                <Grid x:Name="OverlayHost" DataContext="{x:Null}"
                      x:DataType="s:PlotterSettingsViewModel">
                    <Grid.Styles>
                        <!-- navBtn, ported verbatim from PlotterNexView.axaml so the
                             two plots' chrome is the same control, not merely a
                             similar one: same 32x32 box, same #777 idle grey, the
                             same pointerover/pressed/checked ramp, and the same
                             borderless ContentPresenter template that lets an
                             icon Path take the button's Foreground. It is a
                             copy and not a shared resource because the Nex view
                             defines it in its OWN Panel.Styles; hoisting it to a
                             common file is a bigger change than this parity fix,
                             and a divergence here would be a silent one.
                             If you change one, change both. -->
                        <Style Selector="Button.navBtn, ToggleButton.navBtn">
                            <Setter Property="Width" Value="32" />
                            <Setter Property="Height" Value="32" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="FontSize" Value="24" />
                            <Setter Property="Foreground" Value="#777" />
                            <Setter Property="FontWeight" Value="Normal" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                        <Style Selector="Button.navBtn">
                            <Setter Property="Template">
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter x:Name="PART_ContentPresenter"
                                                      Background="Transparent"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalContentAlignment="Center"
                                                      VerticalContentAlignment="Center" />
                                </ControlTemplate>
                            </Setter>
                        </Style>
                        <Style Selector="ToggleButton.navBtn">
                            <Setter Property="Template">
                                <ControlTemplate TargetType="ToggleButton">
                                    <ContentPresenter x:Name="PART_ContentPresenter"
                                                      Background="Transparent"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalContentAlignment="Center"
                                                      VerticalContentAlignment="Center" />
                                </ControlTemplate>
                            </Setter>
                        </Style>
                        <Style Selector="Button.navBtn:pointerover, ToggleButton.navBtn:pointerover">
                            <Setter Property="Foreground" Value="#444" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                        <Style Selector="Button.navBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                                     ToggleButton.navBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Foreground" Value="#444" />
                        </Style>
                        <Style Selector="Button.navBtn:pressed, ToggleButton.navBtn:pressed">
                            <Setter Property="Foreground" Value="#222" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                        <Style Selector="Button.navBtn:pressed /template/ ContentPresenter#PART_ContentPresenter,
                                     ToggleButton.navBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Foreground" Value="#222" />
                        </Style>
                        <Style Selector="ToggleButton.navBtn:checked">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="#222" />
                        </Style>
                        <Style Selector="ToggleButton.navBtn:checked /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Foreground" Value="#222" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style Selector="ToggleButton.navBtn:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Foreground" Value="#222" />
                            <Setter Property="Background" Value="#22000000" />
                        </Style>
                    </Grid.Styles>

                    <!-- The four visibility toggles: a horizontal row of icon
                         buttons at the top LEFT, as in Nex. They were a vertical
                         column of text CheckBoxes at the top right, which is a
                         different control doing the same job in a different
                         place — and the text made the overlay wider than the
                         plot it sat on. Same x:Names, so the headless tests that
                         address them by name still find them; IsChecked and the
                         tooltip bind to the same shared-model properties, so only
                         the presentation changed. -->
                    <StackPanel x:Name="TogglesPanel"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="12" Spacing="6" Orientation="Horizontal">
                        <ToggleButton x:Name="GridToggle" Classes="navBtn"
                                      IsChecked="{Binding ShowGrid}"
                                      ToolTip.Tip="{Binding ShowGridLabel}">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{Binding $parent[ToggleButton].Foreground}"
                                  StrokeThickness="1.5"
                                  Data="M 1,1 L 15,1 L 15,15 L 1,15 Z M 1,5.66 L 15,5.66 M 1,10.33 L 15,10.33 M 5.66,1 L 5.66,15 M 10.33,1 L 10.33,15" />
                        </ToggleButton>
                        <ToggleButton x:Name="OriginToggle" Classes="navBtn"
                                      IsChecked="{Binding ShowOrigin}"
                                      ToolTip.Tip="{Binding ShowOriginLabel}">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{Binding $parent[ToggleButton].Foreground}"
                                  StrokeThickness="1.5"
                                  Data="M 8,8 L 8,1 M 8,1 L 6.5,3 M 8,1 L 9.5,3 M 8,8 L 2,11.5 M 2,11.5 L 4,11 M 2,11.5 L 2.5,9.5 M 8,8 L 14,11.5 M 14,11.5 L 13.5,9.5 M 14,11.5 L 12,11" />
                        </ToggleButton>
                        <ToggleButton x:Name="EnvelopeToggle" Classes="navBtn"
                                      IsChecked="{Binding ShowEnvelope}"
                                      ToolTip.Tip="{Binding ShowEnvelopeLabel}">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{Binding $parent[ToggleButton].Foreground}"
                                  StrokeThickness="1.5"
                                  Data="M 8,1 L 15,4.5 L 15,11.5 L 8,15 L 1,11.5 L 1,4.5 Z M 1,4.5 L 8,8 L 15,4.5 M 8,8 L 8,15" />
                        </ToggleButton>
                        <ToggleButton x:Name="RunStateToggle" Classes="navBtn"
                                      IsChecked="{Binding ShowRunState}"
                                      ToolTip.Tip="{Binding ShowRunStateLabel}">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{Binding $parent[ToggleButton].Foreground}"
                                  StrokeThickness="1.5"
                                  Data="M 4,2 L 13,8 L 4,14 Z" />
                        </ToggleButton>
                    </StackPanel>

                    <!-- The zoom cluster: the percentage ABOVE the buttons, and
                         the buttons on navBtn like every other chrome button in
                         the two views. The readout used to sit to the LEFT of the
                         row, which put a number between the plot and the buttons
                         that change it. Vertical stack, readout on top, and the
                         same bottom-right corner it has always occupied. -->
                    <StackPanel x:Name="ZoomPanel"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,12,12" Spacing="6">
                        <TextBlock x:Name="ZoomPctText" FontSize="12" Foreground="#777"
                                   HorizontalAlignment="Center" IsVisible="False" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="ZoomOutButton" Classes="navBtn" Content="−"
                                    Click="OnZoomOut" ToolTip.Tip="{Binding ZoomOutLabel}" />
                            <Button x:Name="ZoomFitButton" Classes="navBtn" Content="⛶"
                                    Click="OnZoomFit" ToolTip.Tip="{Binding ZoomFitLabel}" />
                            <Button x:Name="ZoomInButton" Classes="navBtn" Content="+"
                                    Click="OnZoomIn" ToolTip.Tip="{Binding ZoomInLabel}" />
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="SavePngButton" Classes="navBtn"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="12"
                            Click="OnSavePng" ToolTip.Tip="{Binding SavePngLabel}">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.3"
                              Data="M 2,1 L 12,1 L 14,3 L 14,14 L 2,14 Z M 4,1 L 4,6 L 12,6 L 12,1 M 3,14 L 3,9 L 13,9 L 13,14 M 6,2 L 10,2" />
                    </Button>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
