<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Modules.Plugins"
             xmlns:panels="clr-namespace:SenderNG.Modules.Plugins"
             xmlns:conv="clr-namespace:SenderNG.Modules.Probing.Converters"
             xmlns:prims="using:Avalonia.Controls.Primitives"
             xmlns:probing="clr-namespace:SenderNG.Core.Modules.Probing;assembly=SenderNG.Modules.Probing"
             xmlns:loc="clr-namespace:SenderNG.Modules.Probing.Localization"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="800"
             x:Class="SenderNG.Modules.Plugins.ProbeView"
             x:DataType="vm:ProbeViewModel"
             panels:ProbeDesignState.PinnedTool="CenterFinder">

    <UserControl.Styles>
        <!-- Flat group-box look: bordered card with a small header -->
        <Style Selector="Border.group">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#aaa" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <!-- Label + numeric field row -->
        <Style Selector="TextBlock.fld">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <!-- Trailing unit suffix after a numeric field (fixed-width unit column) -->
        <Style Selector="TextBlock.unit">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#888" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style Selector="TextBox.num">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderBrush" Value="#999" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Width" Value="60" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- Tool strip / action-bar toggle buttons -->
        <Style Selector="RadioButton.tool">
            <!-- Fluent's ControlTheme sets HorizontalAlignment=Left + VerticalAlignment=Center on
                 RadioButton, which stops the last child of a DockPanel (LastChildFill) from
                 stretching into the remaining space. Override both to Stretch. -->
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Root" CornerRadius="0" BorderThickness="1" Padding="10,6"
                            Background="#eee" BorderBrush="#999">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.tool:checked /template/ Border#Root">
            <Setter Property="Background" Value="#ddd" />
            <Setter Property="BorderBrush" Value="#666" />
        </Style>
        <!-- Edge/corner selector buttons: flat squares filling their cell (jog-widget style) -->
        <Style Selector="RadioButton.edge">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Root" CornerRadius="0" BorderThickness="1" Margin="1"
                            Background="#eee" BorderBrush="#999"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.edge:checked /template/ Border#Root">
            <Setter Property="Background" Value="#ddd" />
            <Setter Property="BorderBrush" Value="#666" />
        </Style>
        <!-- Pictogram selector buttons (ioSender-style image radios): the picture
             itself is the button (no radio bullet), the unchecked picture is
             dimmed so the selected action reads at a glance. The picture is the
             RadioButton's Content (an Image child); the shared template just
             presents it. -->
        <Style Selector="RadioButton.img">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <!-- Size is set per tool on the buttons themselves (center finder
                 120x120, rotation 80x80, matching ioSender). -->
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.img:not(:checked)">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <!-- Padlock checkbox (jog-widget style): open lock when unchecked, closed when checked. -->
        <Style Selector="CheckBox.padlock">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent" Width="34" Height="34" HorizontalAlignment="Center">
                        <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Open lock (unchecked) -->
                            <Path x:Name="UnlockedIcon" Data="M5 8 V6 A3 3 0 0 1 11 6 M4 8 L12 8 L12 15 L4 15 Z"
                                  Stroke="#555" StrokeThickness="1.5" Width="16" Height="16" Stretch="None"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <!-- Closed lock (checked) -->
                            <Path x:Name="LockedIcon" Data="M5 8 V6 A3 3 0 0 1 11 6 V8 M4 8 L12 8 L12 15 L4 15 Z M8 10 L8 12"
                                  Stroke="#333" StrokeThickness="1.5" Width="16" Height="16" Stretch="None"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox.padlock:checked /template/ Path#UnlockedIcon">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="CheckBox.padlock:checked /template/ Path#LockedIcon">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </UserControl.Styles>

    <!-- Horizontal ScrollViewer wraps the whole probing tab: the columns are
         auto-sized from their content, so a scrollbar appears when the hosting
         panel is narrower than the left column + the selected tab's content.
         Probe values are configured in millimetres (unit labels below). -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <Grid ColumnDefinitions="Auto,Auto">

        <!-- ============================ Left: profiles + settings ============================ -->
        <Grid Margin="6,4" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="2" MinWidth="200">

            <!-- Profile selector (combo fills the line, ... opens the profile menu) -->
            <Grid Grid.Row="0" ColumnDefinitions="*,32">
                <ComboBox Grid.Column="0" Height="24" MinHeight="24" CornerRadius="0" BorderBrush="#999"
                          BorderThickness="1" FontSize="11"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                          IsEditable="True"
                          prims:TextSearch.TextBinding="{ReflectionBinding Name}"
                          Text="{Binding NewProfileName, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="probing:ProbingProfile">
                            <TextBlock Text="{Binding Name}" FontSize="11" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" Content="..." Height="24" MinHeight="24" Padding="0" Margin="4,0,0,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" FontSize="11"
                        ToolTip.Tip="{loc:Loc module.probing.profileActions, DText='Profile actions'}" Click="ProfileMenu_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{loc:Loc common.add, DText='Add'}" Command="{Binding ProfileAddCommand}" />
                            <MenuItem Header="{loc:Loc common.apply, DText='Apply'}" Command="{Binding ProfileUpdateCommand}" />
                            <MenuItem Header="{loc:Loc common.remove, DText='Remove'}" Command="{Binding ProfileDeleteCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>

            <!-- Probe tip/tool -->
            <Border Grid.Row="1" Classes="group">
                <!-- Shared grid columns: label (auto) / value (60px) / fixed unit column -->
                <Grid ColumnDefinitions="*,60,44" RowDefinitions="Auto,Auto" RowSpacing="3">
                    <TextBlock Text="{loc:Loc module.probing.probeTipTool, DText='Probe tip/tool'}" FontWeight="SemiBold"
                               FontSize="11" Grid.ColumnSpan="3" Margin="0,0,0,3" />
                    <TextBlock Grid.Row="1" Classes="fld" Text="{loc:Loc module.probing.diameter, DText='Diameter:'}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Classes="num" Text="{Binding ProbeDiameter, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Classes="unit" Text="{loc:Loc common.mm, DText='mm'}" />
                </Grid>
            </Border>

            <!-- Touch plate/fixture height -->
            <Border Grid.Row="2" Classes="group">
                <Grid ColumnDefinitions="*,60,44" RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                    <TextBlock Text="{loc:Loc module.probing.touchPlateHeight, DText='Touch plate/fixture height'}" FontWeight="SemiBold"
                               FontSize="11" Grid.ColumnSpan="3" Margin="0,0,0,3" />
                    <TextBlock Grid.Row="1" Classes="fld" Text="{loc:Loc module.probing.touchPlate, DText='Touch plate:'}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Classes="num" Text="{Binding TouchPlateHeight, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Classes="unit" Text="{loc:Loc common.mm, DText='mm'}" />
                    <TextBlock Grid.Row="2" Classes="fld" Text="{loc:Loc module.probing.fixture, DText='Fixture:'}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Classes="num" Text="{Binding FixtureHeight, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Classes="unit" Text="{loc:Loc common.mm, DText='mm'}" />
                </Grid>
            </Border>

            <!-- Probing distances and speed -->
            <Border Grid.Row="3" Classes="group">
                <Grid ColumnDefinitions="*,60,44" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="3">
                    <TextBlock Text="{loc:Loc module.probing.distancesAndSpeed, DText='Probing distances and speed'}" FontWeight="SemiBold"
                               FontSize="11" Grid.ColumnSpan="3" Margin="0,0,0,3" />
                    <TextBlock Grid.Row="1" Classes="fld" Text="{loc:Loc module.probing.rapidsFeedRate, DText='Rapids feed rate:'}" ToolTip.Tip="{loc:Loc module.probing.rapidsFeedRateHint, DText='Feed for rapid moves; 0 uses the controller setting'}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Classes="num" Text="{Binding RapidsFeedRate, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Classes="unit" Text="{loc:Loc common.mmMin, DText='mm/min'}" />
                    <TextBlock Grid.Row="2" Classes="fld" Text="{loc:Loc module.probing.searchFeedRate, DText='Search feed rate:'}" ToolTip.Tip="{loc:Loc module.probing.searchFeedRateHint, DText='Feed rate for the initial probing move'}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Classes="num" Text="{Binding ProbeFeedRate, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Classes="unit" Text="{loc:Loc common.mmMin, DText='mm/min'}" />
                    <TextBlock Grid.Row="3" Classes="fld" Text="{loc:Loc module.probing.latchFeedRate, DText='Latch feed rate:'}" ToolTip.Tip="{loc:Loc module.probing.latchFeedRateHint, DText='Feed rate for the second slow probing move'}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Classes="num" Text="{Binding LatchFeedRate, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Classes="unit" Text="{loc:Loc common.mmMin, DText='mm/min'}" />
                    <TextBlock Grid.Row="4" Classes="fld" Text="{loc:Loc module.probing.probingDistance, DText='Probing distance:'}" ToolTip.Tip="{loc:Loc module.probing.probingDistanceHint, DText='Maximum distance of a probing move'}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Classes="num" Text="{Binding ProbeDistance, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Classes="unit" Text="{loc:Loc common.mm, DText='mm'}" />
                    <TextBlock Grid.Row="5" Classes="fld" Text="{loc:Loc module.probing.latchDistance, DText='Latch distance:'}" ToolTip.Tip="{loc:Loc module.probing.latchDistanceHint, DText='Retract before the slow probe; 0 skips it'}" />
                    <TextBox Grid.Row="5" Grid.Column="1" Classes="num" Text="{Binding LatchDistance, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Classes="unit" Text="{loc:Loc common.mm, DText='mm'}" />
                </Grid>
            </Border>

            <!-- Probing clearances -->
            <Border Grid.Row="4" Classes="group">
                <Grid ColumnDefinitions="*,60,44" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="3">
                    <TextBlock Text="{loc:Loc module.probing.clearances, DText='Probing clearances'}" FontWeight="SemiBold"
                               FontSize="11" Grid.ColumnSpan="3" Margin="0,0,0,3" />
                    <TextBlock Grid.Row="1" Classes="fld" Text="{loc:Loc module.probing.xyClearance, DText='XY Clearance:'}" ToolTip.Tip="{loc:Loc module.probing.xyClearanceHint, DText='Initial distance away from the face to probe'}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Classes="num" Text="{Binding XYClearance, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Classes="unit" Text="{loc:Loc common.mm, DText='mm'}" />
                    <TextBlock Grid.Row="2" Classes="fld" Text="{loc:Loc module.probing.offset, DText='Offset:'}" ToolTip.Tip="{loc:Loc module.probing.offsetHint, DText='Distance from the corner to the probe point'}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Classes="num" Text="{Binding Offset, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Classes="unit" Text="{loc:Loc common.mm, DText='mm'}" />
                    <TextBlock Grid.Row="3" Classes="fld" Text="{loc:Loc module.probing.depth, DText='Depth:'}" ToolTip.Tip="{loc:Loc module.probing.depthHint, DText='Z below the start position where XY probing happens'}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Classes="num" Text="{Binding Depth, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Classes="unit" Text="{loc:Loc common.mm, DText='mm'}" />
                </Grid>
            </Border>

            <!-- Probe/touchplate XY offsets -->
            <Border Grid.Row="5" Classes="group">
                <Grid ColumnDefinitions="24,60,34,*,24,60,44" RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                    <TextBlock Text="{loc:Loc module.probing.xyOffsets, DText='Probe/touchplate XY offsets'}" FontWeight="SemiBold"
                               FontSize="11" Grid.ColumnSpan="3" Margin="0,0,0,3" />
                    <TextBlock Grid.Row="1" Classes="fld" Text="X:" ToolTip.Tip="{loc:Loc module.probing.xOffsetHint, DText='X offset from the probe to the controlled point'}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Classes="num" Text="{Binding ProbeOffsetX, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Classes="unit" Text="{loc:Loc common.mm, DText='mm'}" />
                    
					<TextBlock Grid.Row="1" Grid.Column="4" Classes="fld" Text="Y:" ToolTip.Tip="{loc:Loc module.probing.yOffsetHint, DText='Y offset from the probe to the controlled point'}" />
                    <TextBox Grid.Row="1" Grid.Column="5" Classes="num" Text="{Binding ProbeOffsetY, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" />
                    <TextBlock Grid.Row="1" Grid.Column="6" Classes="unit" Text="{loc:Loc common.mm, DText='mm'}" />
                    <CheckBox Grid.Row="2" Grid.ColumnSpan="3" Content="{loc:Loc module.probing.isTouchPlate, DText='Is touch plate'}" FontSize="11" IsChecked="{Binding TouchPlateIsXY}" />
                </Grid>
            </Border>
        </Grid>

        <!-- ============================ Right: tool tabs + panel ============================ -->
        <!-- Tool tabs: one per tool (ProbeViewModel.ToolTabs), styled like
             the app's center-panel/About tabs (13 SemiBold headers,
             CornerRadius 0). Each tab's content template shows the per-tool
             instructions/warning banner, the tool panel with the shared
             G-code preview, and the bottom action bar (Set offset group +
             Start/Stop + per-tool action buttons). Tabs of disabled tools are
             hidden via the container theme; the SelectedIndex maps to
             SelectedTool via ProbeViewModel.SelectedToolIndex. In the designer
             only the tab pinned via panels:ProbeDesignState.PinnedTool on the
             root is selected, so exactly one panel renders. -->
        <TabControl Grid.Column="1" CornerRadius="0" Background="White" Margin="6,6,6,6"
                    ItemsSource="{Binding ToolTabs}"
                    SelectedIndex="{Binding SelectedToolIndex, Mode=TwoWay}">
            <TabControl.ItemContainerTheme>
                <ControlTheme TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}" x:CompileBindings="False">
                    <Setter Property="IsVisible" Value="{Binding IsEnabled}" />
                </ControlTheme>
            </TabControl.ItemContainerTheme>
            <TabControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProbeToolTab">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate x:DataType="vm:ProbeToolTab" x:CompileBindings="False">
                    <!-- No stretch row: the content hugs its rows (banner /
                         tool + preview /
                         actions / last result), so Start/Stop stays close to
                         the tool controls instead of being pinned to the
                         bottom of a tall tab area. -->
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4" VerticalAlignment="Top">
                        <!-- Instructions + warning banner -->
                        <Border Margin="0,0,0,4" Padding="6" HorizontalAlignment="Stretch"
                                Background="#fff8e1" BorderBrush="#e0c060" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding $parent[TabControl].DataContext.Instructions}" TextWrapping="Wrap" FontSize="11" Foreground="#333" />
                                <TextBlock Text="{loc:Loc module.probing.warning, DText='Warning! Use with care - incorrect parameters may damage your probe!'}"
                                           Foreground="Red" FontWeight="Bold" FontSize="10" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <!-- Tool column (left): the tool's controls with the Set
                             offset group directly under them; the shared G-code
                             preview (fixed 250px) matches the whole column's
                             height on the right. -->
                        <Grid Grid.Row="1" Margin="0,6" ColumnDefinitions="*,250">
                            <StackPanel x:Name="ToolColumn" Grid.Column="0" VerticalAlignment="Top"
                                        HorizontalAlignment="Stretch">
                                <ContentControl x:Name="ToolHost" Content="{Binding View}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" />
                                <!-- Set offset group (G10 / G92 / Measure +
                                     coordinate system — the selector is only
                                     meaningful for G10). Shared by every tab,
                                     rendered here under the tool's controls. -->
                                <Border Margin="0,10,0,0" Padding="6" CornerRadius="0" Background="White"
                                        BorderBrush="#aaa" BorderThickness="1"
                                        DataContext="{Binding $parent[TabControl].DataContext}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{loc:Loc module.probing.setOffset, DText='Set offset'}"
                                                   FontWeight="SemiBold" FontSize="11" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <RadioButton Classes="tool" Content="G10" FontSize="11"
                                                         IsChecked="{Binding IsCoordG10}" Height="28" MinHeight="28"
                                                         HorizontalContentAlignment="Center" />
                                            <RadioButton Classes="tool" Content="G92" FontSize="11"
                                                         IsChecked="{Binding IsCoordG92}" Height="28" MinHeight="28"
                                                         HorizontalContentAlignment="Center" />
                                            <RadioButton Classes="tool"
                                                         Content="{loc:Loc module.probing.measure, DText='Measure'}" FontSize="11"
                                                         IsChecked="{Binding IsCoordMeasure}" Height="28" MinHeight="28"
                                                         HorizontalContentAlignment="Center" />
                                            <TextBlock Classes="fld" Text="{loc:Loc module.probing.system, DText='System:'}"
                                                       Margin="8,0,4,0" VerticalAlignment="Center" />
                                            <ComboBox Width="70" Height="28" MinHeight="28" CornerRadius="0" BorderBrush="#999"
                                                      BorderThickness="1" FontSize="11" VerticalContentAlignment="Center"
                                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                      ItemsSource="{Binding CoordinateSystemNames}"
                                                      SelectedIndex="{Binding CoordinateSystemIndex, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsCoordG10}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBox Grid.Column="1" Margin="16,0,0,0" IsReadOnly="True"
                                     Text="{Binding $parent[TabControl].DataContext.PreviewText}"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                     Height="{Binding Bounds.Height, ElementName=ToolColumn}"
                                     FontFamily="Consolas, Courier New, monospace" FontSize="12" TextWrapping="NoWrap"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" Padding="4,2" />
                        </Grid>
                        <!-- Action row, spanning the whole tab content: Start /
                             Stop plus the active tool's buttons (Apply rotation
                             on Rotation; Save/Load/Apply to program on Height
                             map). Visibility driven by the tool VM, enabled
                             state by the command CanExecute. -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,8,0,2"
                                    DataContext="{Binding $parent[TabControl].DataContext}">
                            <Button Content="{loc:Loc common.start, DText='Start'}" Command="{Binding StartCommand}" Width="90" Height="30" MinHeight="30"
                                    CornerRadius="0" Background="#eee" Foreground="Black" BorderBrush="#999" BorderThickness="1"
                                    VerticalContentAlignment="Center" ToolTip.Tip="{loc:HotkeyTip module.probing.hotkey.probe.start, probe.start}" />
                            <Button Content="{loc:Loc common.stop, DText='Stop'}" Command="{Binding StopCommand}" Width="90" Height="30" MinHeight="30"
                                    CornerRadius="0" Background="#e04545" Foreground="White" BorderBrush="#b00" BorderThickness="1"
                                    VerticalContentAlignment="Center" ToolTip.Tip="{loc:HotkeyTip module.probing.hotkey.probe.stop, probe.stop}" />
                            <!-- Rotation: apply the probed angle to the loaded program -->
                            <Button Content="{loc:Loc module.probing.applyRotation, DText='Apply rotation'}"
                                    Command="{Binding RotationApplyCommand}" IsVisible="{Binding IsRotation}"
                                    Padding="14,0" Height="30" MinHeight="30" Margin="12,0,0,0"
                                    CornerRadius="0" Background="#eee" Foreground="Black" BorderBrush="#999" BorderThickness="1"
                                    VerticalContentAlignment="Center"
                                    ToolTip.Tip="{loc:Loc module.probing.applyRotationHint, DText=&quot;Rotates the loaded program's X/Y coordinates by the probed angle&quot;}" />
                            <!-- Height map: file IO + apply to the loaded program -->
                            <Button Content="{loc:Loc module.probing.saveMap, DText='Save map'}"
                                    Command="{Binding HeightMapSaveCommand}" IsVisible="{Binding IsHeightMap}"
                                    Padding="14,0" Height="30" MinHeight="30" Margin="12,0,0,0"
                                    CornerRadius="0" Background="#eee" Foreground="Black" BorderBrush="#999" BorderThickness="1"
                                    VerticalContentAlignment="Center" />
                            <Button Content="{loc:Loc module.probing.loadMap, DText='Load map'}"
                                    Command="{Binding HeightMapLoadCommand}" IsVisible="{Binding IsHeightMap}"
                                    Padding="14,0" Height="30" MinHeight="30"
                                    CornerRadius="0" Background="#eee" Foreground="Black" BorderBrush="#999" BorderThickness="1"
                                    VerticalContentAlignment="Center" />
                            <Button Content="{loc:Loc module.probing.applyToProgram, DText='Apply to program'}"
                                    Command="{Binding HeightMapApplyCommand}" IsVisible="{Binding IsHeightMap}"
                                    Padding="14,0" Height="30" MinHeight="30"
                                    CornerRadius="0" Background="#eee" Foreground="Black" BorderBrush="#999" BorderThickness="1"
                                    VerticalContentAlignment="Center" />
                        </StackPanel>
                        <!-- Last result: under the action row so the outcome is
                             visible next to the buttons that produce it. Bound
                             through the TabControl (the row above re-binds its
                             DataContext the same way); tool-local, cleared on
                             tab switch. -->
                        <TextBlock Grid.Row="3" Margin="0,0,0,2"
                                   Text="{Binding $parent[TabControl].DataContext.LastResult}"
                                   TextWrapping="Wrap" FontSize="10" Foreground="#555"
                                   FontFamily="Consolas,monospace"
                                   IsVisible="{Binding $parent[TabControl].DataContext.LastResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
    </ScrollViewer>
</UserControl>
