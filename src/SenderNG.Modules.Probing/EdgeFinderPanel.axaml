<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SenderNG.Modules.Plugins"
             xmlns:conv="clr-namespace:SenderNG.Modules.Probing.Converters"
             xmlns:loc="clr-namespace:SenderNG.Modules.Probing.Localization"
             x:Class="SenderNG.Modules.Plugins.EdgeFinderPanel"
             x:DataType="vm:ProbeViewModel">

    <StackPanel Spacing="8" VerticalAlignment="Top">
        <!-- External/internal mode of the merged Edge finder tab: which side the
             probe approaches the probed surface from. Internal mirrors the moves
             about the edge/corner (P1 fix) and flips the radius-compensation sign. -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Width="180" HorizontalAlignment="Left">
            <RadioButton Grid.Column="0" Classes="tool" Content="{loc:Loc module.probing.external, DText='External'}" FontSize="12"
                         IsChecked="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=EdgeFinderExternal}" />
            <RadioButton Grid.Column="1" Classes="tool" Content="{loc:Loc module.probing.internal, DText='Internal'}" FontSize="12"
                         IsChecked="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=EdgeFinderInternal}" />
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="24">
                <!-- Edge/corner selector (diagram: D top-left, C top-right, A bottom-left, B bottom-right).
                     Each cell stacks the external pictogram over its internal ("I") variant; the
                     mode radio above flips which one is visible, so the picture always shows the
                     actual approach direction. Z is shared by both modes. -->
                <Grid Width="180" Height="180" ColumnDefinitions="*,*,*" RowDefinitions="*,*,*" VerticalAlignment="Top">
                    <RadioButton Grid.Row="0" Grid.Column="0" Classes="img" Width="60" Height="60"
                                 ToolTip.Tip="{loc:Loc module.probing.cornerD, DText='Probe the top-left corner'}"
                                 IsChecked="{Binding ProbeEdge, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=D}">
                        <Grid>
                            <Image x:Name="CornerDImage" Stretch="Fill"
                                   IsVisible="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=EdgeFinderExternal}" />
                            <Image x:Name="CornerDIntImage" Stretch="Fill"
                                   IsVisible="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=EdgeFinderInternal}" />
                            <Rectangle x:Name="ZDotD" Width="8" Height="8" Fill="Red"
                                       Margin="{Binding SelectedTool, Converter={x:Static conv:Converters.ZDotMargin}, ConverterParameter=D}">
                                <Rectangle.IsVisible>
                                    <MultiBinding Converter="{x:Static conv:Converters.EnumAndBool}" ConverterParameter="D">
                                        <Binding Path="ProbeEdge" />
                                        <Binding Path="ProbeZ" />
                                    </MultiBinding>
                                </Rectangle.IsVisible>
                            </Rectangle>
                        </Grid>
                    </RadioButton>
                    <RadioButton Grid.Row="0" Grid.Column="1" Classes="img" Width="60" Height="60"
                                 ToolTip.Tip="{loc:Loc module.probing.edgeCD, DText='Probe the top edge'}"
                                 IsChecked="{Binding ProbeEdge, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=CD}">
                        <Grid>
                            <Image x:Name="EdgeCDImage" Stretch="Fill"
                                   IsVisible="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=EdgeFinderExternal}" />
                            <Image x:Name="EdgeCDIntImage" Stretch="Fill"
                                   IsVisible="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=EdgeFinderInternal}" />
                            <Rectangle x:Name="ZDotCD" Width="8" Height="8" Fill="Red"
                                       Margin="{Binding SelectedTool, Converter={x:Static conv:Converters.ZDotMargin}, ConverterParameter=CD}">
                                <Rectangle.IsVisible>
                                    <MultiBinding Converter="{x:Static conv:Converters.EnumAndBool}" ConverterParameter="CD">
                                        <Binding Path="ProbeEdge" />
                                        <Binding Path="ProbeZ" />
                                    </MultiBinding>
                                </Rectangle.IsVisible>
                            </Rectangle>
                        </Grid>
                    </RadioButton>
                    <RadioButton Grid.Row="0" Grid.Column="2" Classes="img" Width="60" Height="60"
                                 ToolTip.Tip="{loc:Loc module.probing.cornerC, DText='Probe the top-right corner'}"
                                 IsChecked="{Binding ProbeEdge, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=C}">
                        <Grid>
                            <Image x:Name="CornerCImage" Stretch="Fill"
                                   IsVisible="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=EdgeFinderExternal}" />
                            <Image x:Name="CornerCIntImage" Stretch="Fill"
                                   IsVisible="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=EdgeFinderInternal}" />
                            <Rectangle x:Name="ZDotC" Width="8" Height="8" Fill="Red"
                                       Margin="{Binding SelectedTool, Converter={x:Static conv:Converters.ZDotMargin}, ConverterParameter=C}">
                                <Rectangle.IsVisible>
                                    <MultiBinding Converter="{x:Static conv:Converters.EnumAndBool}" ConverterParameter="C">
                                        <Binding Path="ProbeEdge" />
                                        <Binding Path="ProbeZ" />
                                    </MultiBinding>
                                </Rectangle.IsVisible>
                            </Rectangle>
                        </Grid>
                    </RadioButton>
                    <RadioButton Grid.Row="1" Grid.Column="0" Classes="img" Width="60" Height="60"
                                 ToolTip.Tip="{loc:Loc module.probing.edgeAD, DText='Probe the left edge'}"
                                 IsChecked="{Binding ProbeEdge, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=AD}">
                        <Grid>
                            <Image x:Name="EdgeADImage" Stretch="Fill"
                                   IsVisible="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=EdgeFinderExternal}" />
                            <Image x:Name="EdgeADIntImage" Stretch="Fill"
                                   IsVisible="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=EdgeFinderInternal}" />
                            <Rectangle x:Name="ZDotAD" Width="8" Height="8" Fill="Red"
                                       Margin="{Binding SelectedTool, Converter={x:Static conv:Converters.ZDotMargin}, ConverterParameter=AD}">
                                <Rectangle.IsVisible>
                                    <MultiBinding Converter="{x:Static conv:Converters.EnumAndBool}" ConverterParameter="AD">
                                        <Binding Path="ProbeEdge" />
                                        <Binding Path="ProbeZ" />
                                    </MultiBinding>
                                </Rectangle.IsVisible>
                            </Rectangle>
                        </Grid>
                    </RadioButton>
                    <!-- The Z cell only exists in external mode: a center probe
                         inside a pocket would touch the pocket bottom, not the
                         top surface. The VM also moves ProbeEdge off Z when
                         entering internal mode. -->
                    <RadioButton Grid.Row="1" Grid.Column="1" Classes="img" Width="60" Height="60"
                                 ToolTip.Tip="{loc:Loc module.probing.probeZ, DText='Probe Z'}"
                                 IsVisible="{Binding IsEdgeExternal}"
                                 IsChecked="{Binding ProbeEdge, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=Z}">
                        <Grid>
                            <Image x:Name="EdgeZImage" Stretch="Fill" />
                            <Rectangle x:Name="ZDotZ" Width="8" Height="8" Fill="Red" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle.IsVisible>
                                    <MultiBinding Converter="{x:Static conv:Converters.EnumAndBool}" ConverterParameter="Z">
                                        <Binding Path="ProbeEdge" />
                                        <Binding Path="ProbeZ" />
                                    </MultiBinding>
                                </Rectangle.IsVisible>
                            </Rectangle>
                        </Grid>
                    </RadioButton>
                    <RadioButton Grid.Row="1" Grid.Column="2" Classes="img" Width="60" Height="60"
                                 ToolTip.Tip="{loc:Loc module.probing.edgeCB, DText='Probe the right edge'}"
                                 IsChecked="{Binding ProbeEdge, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=CB}">
                        <Grid>
                            <Image x:Name="EdgeCBImage" Stretch="Fill"
                                   IsVisible="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=EdgeFinderExternal}" />
                            <Image x:Name="EdgeCBIntImage" Stretch="Fill"
                                   IsVisible="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=EdgeFinderInternal}" />
                            <Rectangle x:Name="ZDotCB" Width="8" Height="8" Fill="Red"
                                       Margin="{Binding SelectedTool, Converter={x:Static conv:Converters.ZDotMargin}, ConverterParameter=CB}">
                                <Rectangle.IsVisible>
                                    <MultiBinding Converter="{x:Static conv:Converters.EnumAndBool}" ConverterParameter="CB">
                                        <Binding Path="ProbeEdge" />
                                        <Binding Path="ProbeZ" />
                                    </MultiBinding>
                                </Rectangle.IsVisible>
                            </Rectangle>
                        </Grid>
                    </RadioButton>
                    <RadioButton Grid.Row="2" Grid.Column="0" Classes="img" Width="60" Height="60"
                                 ToolTip.Tip="{loc:Loc module.probing.cornerA, DText='Probe the bottom-left corner'}"
                                 IsChecked="{Binding ProbeEdge, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=A}">
                        <Grid>
                            <Image x:Name="CornerAImage" Stretch="Fill"
                                   IsVisible="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=EdgeFinderExternal}" />
                            <Image x:Name="CornerAIntImage" Stretch="Fill"
                                   IsVisible="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=EdgeFinderInternal}" />
                            <Rectangle x:Name="ZDotA" Width="8" Height="8" Fill="Red"
                                       Margin="{Binding SelectedTool, Converter={x:Static conv:Converters.ZDotMargin}, ConverterParameter=A}">
                                <Rectangle.IsVisible>
                                    <MultiBinding Converter="{x:Static conv:Converters.EnumAndBool}" ConverterParameter="A">
                                        <Binding Path="ProbeEdge" />
                                        <Binding Path="ProbeZ" />
                                    </MultiBinding>
                                </Rectangle.IsVisible>
                            </Rectangle>
                        </Grid>
                    </RadioButton>
                    <RadioButton Grid.Row="2" Grid.Column="1" Classes="img" Width="60" Height="60"
                                 ToolTip.Tip="{loc:Loc module.probing.edgeAB, DText='Probe the bottom edge'}"
                                 IsChecked="{Binding ProbeEdge, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=AB}">
                        <Grid>
                            <Image x:Name="EdgeABImage" Stretch="Fill"
                                   IsVisible="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=EdgeFinderExternal}" />
                            <Image x:Name="EdgeABIntImage" Stretch="Fill"
                                   IsVisible="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=EdgeFinderInternal}" />
                            <Rectangle x:Name="ZDotAB" Width="8" Height="8" Fill="Red"
                                       Margin="{Binding SelectedTool, Converter={x:Static conv:Converters.ZDotMargin}, ConverterParameter=AB}">
                                <Rectangle.IsVisible>
                                    <MultiBinding Converter="{x:Static conv:Converters.EnumAndBool}" ConverterParameter="AB">
                                        <Binding Path="ProbeEdge" />
                                        <Binding Path="ProbeZ" />
                                    </MultiBinding>
                                </Rectangle.IsVisible>
                            </Rectangle>
                        </Grid>
                    </RadioButton>
                    <RadioButton Grid.Row="2" Grid.Column="2" Classes="img" Width="60" Height="60"
                                 ToolTip.Tip="{loc:Loc module.probing.cornerB, DText='Probe the bottom-right corner'}"
                                 IsChecked="{Binding ProbeEdge, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=B}">
                        <Grid>
                            <Image x:Name="CornerBImage" Stretch="Fill"
                                   IsVisible="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=EdgeFinderExternal}" />
                            <Image x:Name="CornerBIntImage" Stretch="Fill"
                                   IsVisible="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=EdgeFinderInternal}" />
                            <Rectangle x:Name="ZDotB" Width="8" Height="8" Fill="Red"
                                       Margin="{Binding SelectedTool, Converter={x:Static conv:Converters.ZDotMargin}, ConverterParameter=B}">
                                <Rectangle.IsVisible>
                                    <MultiBinding Converter="{x:Static conv:Converters.EnumAndBool}" ConverterParameter="B">
                                        <Binding Path="ProbeEdge" />
                                        <Binding Path="ProbeZ" />
                                    </MultiBinding>
                                </Rectangle.IsVisible>
                            </Rectangle>
                        </Grid>
                    </RadioButton>
                </Grid>

                <StackPanel Spacing="4" VerticalAlignment="Top">
                    <CheckBox Content="{loc:Loc module.probing.probeZ, DText='Probe Z'}" IsChecked="{Binding ProbeZ}" IsEnabled="{Binding IsProbeZEditable}" FontSize="11" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                        <TextBlock Text="{loc:Loc module.probing.workpieceHeight, DText='Workpiece height:'}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Grid.Column="1" Text="{Binding WorkpieceHeight, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}"
                                 Height="24" MinHeight="24" CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                                 FontSize="11" Padding="4,0" VerticalContentAlignment="Center"
                                 IsEnabled="{Binding ProbeZ}" Margin="4,0"/>

						<TextBlock Grid.Row="1" Text="{loc:Loc module.probing.edgeOffset, DText='Edge offset:'}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"
                                   ToolTip.Tip="{loc:Loc module.probing.edgeOffsetHint, DText='0 uses half the probe diameter'}" />
						<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WorkpieceXYEdgeOffset, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}"
                                 Height="24" MinHeight="24" CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                                 FontSize="11" Padding="4,0" VerticalContentAlignment="Center"
                                 IsEnabled="{Binding ProbeZ}" Margin="4,0"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
    </StackPanel>
</UserControl>
