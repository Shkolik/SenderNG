<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Modules.Plotter.GL.Settings"
             mc:Ignorable="d" d:DesignWidth="240" d:DesignHeight="120"
             x:Class="SenderNG.Modules.Plotter.GL.Settings.PlotterGlSettingsView"
             x:DataType="vm:PlotterGlSettingsViewModel">
    <!-- The view toggles and the render-quality rows, and nothing else. The
         wire-length field, the per-slot world-axis combos and the origin rows
         are deleted: the plane layout and its separation are machine-model facts
         (IMachineKinematicsProvider / the profile's Separation), and within a
         plane slot k feeds world axis k, so there is no mapping to pick. -->
    <StackPanel Spacing="8">
        <StackPanel Spacing="4">
            <TextBlock Text="{Binding ViewLabel}" FontSize="12" FontWeight="SemiBold"
                       Foreground="#333" Margin="0,6,0,0" />
            <Grid ColumnDefinitions="Auto,24,Auto" RowDefinitions="Auto,Auto,Auto">
                <CheckBox Grid.Column="0" Grid.Row="0" Content="{Binding ShowOriginLabel}" IsChecked="{Binding ShowOrigin, Mode=TwoWay}" FontSize="11" />
                <CheckBox Grid.Column="0" Grid.Row="1" Content="{Binding ShowEnvelopeLabel}" IsChecked="{Binding ShowEnvelope, Mode=TwoWay}" FontSize="11" />
                <CheckBox Grid.Column="0" Grid.Row="2" Content="{Binding ShowLoftLabel}" IsChecked="{Binding ShowLoft, Mode=TwoWay}" IsVisible="{Binding HasLoft}" FontSize="11" />
                <CheckBox Grid.Column="2" Grid.Row="0" Content="{Binding ShowRunStateLabel}" IsChecked="{Binding ShowRunState, Mode=TwoWay}" FontSize="11" />
                <CheckBox Grid.Column="2" Grid.Row="1" Content="{Binding ShowGridLabel}" IsChecked="{Binding ShowGrid, Mode=TwoWay}" FontSize="11" />
            </Grid>
        </StackPanel>
        <StackPanel Spacing="4">
            <CheckBox Content="{Binding SupersampleLabel}" IsChecked="{Binding Supersample, Mode=TwoWay}" FontSize="11" Margin="0,6,0,4" />
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding MsaaLabel}" FontSize="11" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding MsaaChoices}"
                          SelectedIndex="{Binding MsaaIndex, Mode=TwoWay}"
                          Width="72" MinWidth="56" Height="28" MinHeight="28" CornerRadius="0" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
