<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Modules.Plotter.GL.Settings"
             xmlns:conv="clr-namespace:SenderNG.Modules.Plotter.GL.Converters"
             mc:Ignorable="d" d:DesignWidth="240" d:DesignHeight="120"
             x:Class="SenderNG.Modules.Plotter.GL.Settings.PlotterGlSettingsView"
             x:DataType="vm:PlotterGlSettingsViewModel">
    <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowWireLength}">
            <TextBlock Text="{Binding WireLengthLabel}" FontSize="11" VerticalAlignment="Center" />
            <TextBox Classes="num" Text="{Binding WireLength, Converter={x:Static conv:Converters.NumericText}, UpdateSourceTrigger=LostFocus}" Width="100" Height="28" MinHeight="24"
                     CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                     FontSize="11" VerticalContentAlignment="Center" Padding="4,0" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="{Binding ViewLabel}" FontSize="12" FontWeight="SemiBold"
                       Foreground="#333" Margin="0,6,0,0" />
			<Grid ColumnDefinitions="Auto,24,Auto" RowDefinitions="Auto,Auto,Auto">			    
				<CheckBox Grid.Column="0" Grid.Row="0" Content="{Binding ShowOriginLabel}" IsChecked="{Binding ShowOrigin, Mode=TwoWay}" FontSize="11" />
			    <CheckBox Grid.Column="0" Grid.Row="1" Content="{Binding ShowEnvelopeLabel}" IsChecked="{Binding ShowEnvelope, Mode=TwoWay}" FontSize="11" />
			    <CheckBox Grid.Column="0" Grid.Row="2" Content="{Binding ShowLoftLabel}" IsChecked="{Binding ShowLoft, Mode=TwoWay}" IsVisible="{Binding HasLoft}" FontSize="11" />
			    <CheckBox Grid.Column="2" Grid.Row="0" Content="{Binding ShowRunStateLabel}" IsChecked="{Binding ShowRunState, Mode=TwoWay}" FontSize="11" />
			    <CheckBox Grid.Column="2" Grid.Row="1" Content="{Binding ShowGridLabel}" IsChecked="{Binding ShowGrid, Mode=TwoWay}" FontSize="11" />
			</Grid>
        </StackPanel>
        <StackPanel Spacing="4">
			<CheckBox Content="{Binding SupersampleLabel}" IsChecked="{Binding Supersample, Mode=TwoWay}" FontSize="11" Margin="0,6,0,4" />
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding MsaaLabel}" FontSize="11" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding MsaaChoices}"
                          SelectedIndex="{Binding MsaaIndex, Mode=TwoWay}"
                          Width="72" MinWidth="56" Height="28" MinHeight="28" CornerRadius="0" />
            </StackPanel>
        </StackPanel>
        <Rectangle Height="1" Fill="#ddd" />
        <ItemsControl ItemsSource="{Binding PlaneRows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlotterGlPlaneRow">
                    <StackPanel Margin="0,6" Spacing="4">
                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#333" />
                        <Rectangle Height="1" Fill="#ddd" />
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,24,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding WorldAxesLabel}"
                                       FontSize="11" Margin="0,4,0,6" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding OriginLabel}"
                                       FontSize="11" Margin="0,4,0,6" VerticalAlignment="Center" />
                            <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Slots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorldAxisRow">
                                        <ComboBox ItemsSource="{Binding Choices}"
                                                  SelectedIndex="{Binding Axis}"
                                                  Width="64" MinWidth="56" Height="28" MinHeight="28" CornerRadius="0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="X" FontSize="11" VerticalAlignment="Center" />
                                <TextBox Classes="num" Text="{Binding OriginX, Converter={x:Static conv:Converters.NumericText}, UpdateSourceTrigger=LostFocus}" Width="56" Height="28" MinHeight="28"
                                         CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                                         FontSize="11" VerticalContentAlignment="Center" Padding="4,0" />
                                <TextBlock Text="Y" FontSize="11" VerticalAlignment="Center" />
                                <TextBox Classes="num" Text="{Binding OriginY, Converter={x:Static conv:Converters.NumericText}, UpdateSourceTrigger=LostFocus}" Width="56" Height="28" MinHeight="28"
                                         CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                                         FontSize="11" VerticalContentAlignment="Center" Padding="4,0" />
                                <TextBlock Text="Z" FontSize="11" VerticalAlignment="Center" />
                                <TextBox Classes="num" Text="{Binding OriginZ, Converter={x:Static conv:Converters.NumericText}, UpdateSourceTrigger=LostFocus}" Width="56" Height="28" MinHeight="28"
                                         CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                                          FontSize="11" VerticalContentAlignment="Center" Padding="4,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>