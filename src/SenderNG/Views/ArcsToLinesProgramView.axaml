<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CNC.Core.ViewModels;assembly=SenderNG.Core"
             xmlns:loc="clr-namespace:SenderNG.Localization;assembly=SenderNG"
             xmlns:conv="clr-namespace:SenderNG.Converters"
             mc:Ignorable="d" d:DesignWidth="340" d:DesignHeight="92"
             x:Class="SenderNG.Views.ArcsToLinesProgramView"
             x:DataType="vm:ArcsToLinesProgramViewModel">

    <StackPanel Spacing="8" Margin="8">
        <!-- Chord tolerance in mm; values > 1 are points-per-circle (engine convention) -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{loc:Loc app.transform.arcsToLines.tolerance}" FontWeight="SemiBold" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBox Classes="num" Text="{Binding Tolerance, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" FontSize="12" Height="24" Width="90"
                     CornerRadius="0" BorderBrush="#999" BorderThickness="1" />
        </StackPanel>
        <TextBlock Text="{loc:Loc app.transform.arcsToLines.toleranceHint}" FontSize="11"
                   Foreground="#666" TextWrapping="Wrap" MaxWidth="330" />

        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{loc:Loc app.dialog.ok}" Command="{Binding OkCommand}"
                    Height="26" MinHeight="26" CornerRadius="0" FontSize="11"
                    Background="#eee" BorderBrush="#999" BorderThickness="1"
                    Padding="12,0" VerticalContentAlignment="Center" />
            <Button Content="{loc:Loc app.dialog.cancel}" Command="{Binding CancelCommand}"
                    Height="26" MinHeight="26" CornerRadius="0" FontSize="11"
                    Background="#eee" BorderBrush="#999" BorderThickness="1"
                    Padding="12,0" VerticalContentAlignment="Center" />
        </StackPanel>
    </StackPanel>
</UserControl>