<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CNC.Core.ViewModels;assembly=SenderNG.Core"
             xmlns:loc="clr-namespace:SenderNG.Localization"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="220"
             x:Class="SenderNG.Views.DemoMachineSettingsView"
             x:DataType="vm:DemoMachineSettingsViewModel">

    <Border Width="280" Padding="12" Background="#f6f6f6">
        <StackPanel Spacing="8">
            <TextBlock Text="{loc:Loc demoSettings.axes}" FontWeight="SemiBold" />
            <NumericUpDown Value="{Binding NumAxes}" Minimum="1" Maximum="9" Increment="1"
                           CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
            <TextBlock Text="{loc:Loc demoSettings.mode}" FontWeight="SemiBold" Margin="0,4,0,0" />
            <RadioButton Content="{loc:Loc demoSettings.mill}" GroupName="Mode" CornerRadius="0"
                         IsChecked="{Binding IsMill, Mode=TwoWay}" />
            <RadioButton Content="{loc:Loc demoSettings.foam}" GroupName="Mode" CornerRadius="0"
                         IsChecked="{Binding IsFoam, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="{loc:Loc demoSettings.ok}" Command="{Binding OkCommand}"
                        Height="28" MinHeight="28" CornerRadius="0"
                        Background="#eee" BorderBrush="#999" BorderThickness="1"
                        Padding="12,0" VerticalContentAlignment="Center" />
                <Button Content="{loc:Loc demoSettings.cancel}" Command="{Binding CancelCommand}"
                        Height="28" MinHeight="28" CornerRadius="0"
                        Background="#eee" BorderBrush="#999" BorderThickness="1"
                        Padding="12,0" VerticalContentAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
