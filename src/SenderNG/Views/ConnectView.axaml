<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CNC.Core.ViewModels;assembly=SenderNG.Core"
             xmlns:loc="clr-namespace:SenderNG.Localization"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="360"
             x:Class="SenderNG.Views.ConnectView"
             x:DataType="vm:ConnectViewModel">

    <Border Width="360" Padding="10" Background="#f6f6f6">
        <StackPanel Spacing="6">

            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ProfileSelectorVisible}">
                <TextBlock Text="{loc:Loc connect.profile}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                          FontSize="12" Height="24" HorizontalAlignment="Stretch" CornerRadius="0"
                          BorderBrush="#999" BorderThickness="1">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProfileRow">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                <Border Background="#e4e4e4" BorderBrush="#bbb" BorderThickness="1" CornerRadius="2"
                                        Padding="4,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MachineTypeId}" FontSize="10" Foreground="#555" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <!-- MinHeight pins the dialog to the height of the (tallest) Serial tab
                 so switching to the shorter Network/Demo tabs doesn't make the
                 dialog jump; it can still grow if content needs more room. -->
            <TabControl SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                        CornerRadius="0" Background="White"
                        BorderBrush="#999" BorderThickness="1" MinHeight="200">

                <!-- Tab headers match the center-panel tab typography (13 SemiBold).
                     Serial is grayed out when no ports are found (port list + baud
                     disabled); plugging in a controller is detected automatically
                     by the live auto-refresh and brings the tab to life. -->
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="{loc:Loc connect.serial}" FontSize="13" FontWeight="SemiBold" />
                    </TabItem.Header>
                    <StackPanel Spacing="4" Margin="4,8,4,4">
                        <!-- Port: single row, dropdown spans the tab width (same size
                             as the network endpoint input). Autodetect replaces the
                             old refresh button — plugging in a controller updates
                             the list live. -->
                        <TextBlock Text="{loc:Loc connect.port}" FontWeight="SemiBold" FontSize="12" />
                        <ComboBox ItemsSource="{Binding Ports}"
                                  DisplayMemberBinding="{Binding FullName}"
                                  SelectedItem="{Binding SelectedPortEntry, Mode=TwoWay}"
                                  IsEnabled="{Binding SerialEnabled}"
                                  FontSize="12" Height="24"
                                  HorizontalAlignment="Stretch"
                                  CornerRadius="0"
                                  BorderBrush="#999" BorderThickness="1" />

                        <!-- Lines: "Baud rate      On connect" and the two selectors.
                             Three-column grid: baud selector spans the first column's
                             width, a ~30px empty middle column separates the two,
                             and the On connect selector spans the third. The baud
                             combo fills its cell so baud and On connect read equal.
                             On-connect aligns flush with its label, no left margin. -->
                        <Grid ColumnDefinitions="*,30,*" Margin="0,2,0,0">
                            <TextBlock Grid.Column="0" Text="{loc:Loc connect.baudRate}" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Grid.Column="2" Text="{loc:Loc connect.onConnect}" FontWeight="SemiBold" FontSize="12" />
                        </Grid>
                        <Grid ColumnDefinitions="*,30,*">
                            <ComboBox Grid.Column="0" ItemsSource="{Binding BaudRates}"
                                      SelectedItem="{Binding BaudRate, Mode=TwoWay}"
                                      IsEnabled="{Binding SerialEnabled}"
                                      FontSize="12" Height="24"
                                      HorizontalAlignment="Stretch"
                                      CornerRadius="0"
                                      BorderBrush="#999" BorderThickness="1" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding ResetModeOptions}"
                                      SelectedItem="{Binding SelectedResetModeOption, Mode=TwoWay}"
                                      DisplayMemberBinding="{Binding Name}"
                                      IsEnabled="{Binding SerialEnabled}"
                                      FontSize="12" Height="24"
                                      HorizontalAlignment="Stretch"
                                      CornerRadius="0"
                                      BorderBrush="#999" BorderThickness="1" />
                        </Grid>
                        <TextBlock Text="{loc:Loc connect.dtrHint}"
                                   FontSize="11" Foreground="#666" TextWrapping="Wrap" />

                        <TextBlock Text="{Binding NoPortsHint}" FontSize="11" Foreground="#a33"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </TabItem>

                <!-- Network: only usable when the settings enable network connectivity. -->
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="{loc:Loc connect.network}" FontSize="13" FontWeight="SemiBold" />
                    </TabItem.Header>
                    <StackPanel Spacing="6" Margin="4,8,4,4" IsEnabled="{Binding NetworkEnabled}">
                        <TextBlock Text="{loc:Loc connect.endpoint}" FontWeight="SemiBold" FontSize="12" />
                        <TextBox Text="{Binding NetworkEndpoint, Mode=TwoWay}"
                                 FontSize="12" Height="24"
                                 CornerRadius="0" BorderBrush="#999" BorderThickness="1" />
                        <TextBlock Text="{Binding NetworkNote}" FontSize="11" Foreground="#666"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </TabItem>

                <!-- Demo: always available; the disclaimer explains what it is. -->
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="{loc:Loc connect.demo}" FontSize="13" FontWeight="SemiBold" />
                    </TabItem.Header>
                    <StackPanel Spacing="6" Margin="4,8,4,4">
                        <TextBlock Text="{Binding DemoDisclaimer}" FontSize="12.5"
                                   Foreground="#666" TextWrapping="Wrap" LineHeight="18" />
                        <TextBlock Text="{loc:Loc connect.demoAxes}" FontWeight="SemiBold" FontSize="12"
                                   Margin="0,2,0,0" />
                        <ComboBox ItemsSource="{Binding DemoAxisOptions}"
                                  SelectedItem="{Binding DemoAxes, Mode=TwoWay}"
                                  FontSize="12" Height="24" CornerRadius="0" MinWidth="72"
                                  HorizontalAlignment="Left"
                                  BorderBrush="#999" BorderThickness="1" />
                    </StackPanel>
                </TabItem>
            </TabControl>

            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="{Binding ConnectButtonLabel}" Command="{Binding ConnectCommand}"
                        Height="26" MinHeight="26" CornerRadius="0" FontSize="11"
                        Background="#eee" BorderBrush="#999" BorderThickness="1"
                        Padding="12,0" VerticalContentAlignment="Center" />
                <Button Content="{loc:Loc connect.cancel}" Command="{Binding CancelCommand}"
                        Height="26" MinHeight="26" CornerRadius="0" FontSize="11"
                        Background="#eee" BorderBrush="#999" BorderThickness="1"
                        Padding="12,0" VerticalContentAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
