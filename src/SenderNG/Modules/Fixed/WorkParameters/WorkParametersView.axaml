<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Modules.Fixed"
             xmlns:loc="clr-namespace:SenderNG.Localization;assembly=SenderNG"
             mc:Ignorable="d" d:DesignWidth="250" d:DesignHeight="84"
             x:Class="SenderNG.Modules.Fixed.WorkParametersView"
             x:DataType="vm:WorkParametersViewModel">    <Border Background="#f6f6f6" Padding="6">
        <Grid RowDefinitions="Auto,Auto,Auto">
            <Grid ColumnDefinitions="100,*">
                <TextBlock Grid.Column="0" Text="{loc:Loc module.work-parameters.offset}" />
                <TextBlock Grid.Column="1" Text="{loc:Loc module.work-parameters.tool}" Margin="10,0,0,0"/>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="100,*" Margin="0,2,0,0">
                <!-- Coordinate selector: fixed 100px (same as the Offsets editor's
                     selector), a small 3px gap to the tool selector. -->
                <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding CoordinateSystemCodes}"
                          SelectedItem="{Binding SelectedCoordinateSystem, Mode=OneWay}"
                          SelectionChanged="CoordinateSystemChanged" CornerRadius="0" Height="28" Margin="0,0,3,0" />
                <!-- Tool selector: fills the remaining width (star column + MinWidth
                     floor) and is content-independent — a long tool name stretches
                     the combo's popup, never the control itself (labels trim). -->
                <ComboBox Grid.Column="1" ItemsSource="{Binding Tools}"
                          SelectedItem="{Binding SelectedToolRow, Mode=OneWay}"
                          SelectionChanged="ToolChanged" CornerRadius="0" Height="28"
                          HorizontalAlignment="Stretch" Margin="10,0,3,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ToolRow">
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,3,0,0">
                <CheckBox IsChecked="{Binding IsTloReferenceSet, Mode=OneWay}" IsEnabled="False" />
                <TextBlock Text="{loc:Loc module.work-parameters.tloRefd}" VerticalAlignment="Center" />
                <TextBlock Text="{loc:Loc module.work-parameters.tloActive}" IsVisible="{Binding IsTloActive}" Foreground="#555" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
