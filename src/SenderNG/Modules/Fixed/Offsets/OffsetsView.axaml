<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Modules.Fixed"
             xmlns:loc="clr-namespace:SenderNG.Localization;assembly=SenderNG"
             x:Class="SenderNG.Modules.Fixed.OffsetsView"
             x:DataType="vm:OffsetsViewModel" mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="420">
    <UserControl.Styles>
        <!-- Axis cell label: centered over its column. -->
        <Style Selector="TextBlock.axisHeader">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBox.axisCell">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="MinWidth" Value="60" />
            <!-- Kill the phantom in-cell scrollbar -->
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
        </Style>
    </UserControl.Styles>
    
    <ScrollViewer IsEnabled="{Binding IsReady}">
        <StackPanel Margin="8" Spacing="6">

            <!-- Offset table header: offset-code column + one axis column each -->
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="{loc:Loc module.offsets-table.offset}" x:Name="OffsetHeader" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ItemsControl Grid.Column="1" ItemsSource="{Binding AxisNames}" HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding AxisNames.Count}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" Classes="axisHeader" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Offset rows -->
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EditableOffsetRow">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="{Binding Code}" Width="{Binding ElementName=OffsetHeader, Path=Bounds.Width}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}" HorizontalAlignment="Stretch">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding Cells.Count}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OffsetCellViewModel">
                                        <TextBox Text="{Binding Value, Mode=TwoWay}" Classes="axisCell" VerticalAlignment="Stretch"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Selected offset + actions -->
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,6,0,0">
                <TextBlock Grid.Column="0" Text="{loc:Loc module.offsets-table.selectedOffset}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding OffsetCodes}" SelectedItem="{Binding SelectedOffset, Mode=TwoWay}" Width="100">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2" Content="{loc:Loc module.offsets-table.getCurrentPosition}" Command="{Binding GetCurrentPositionCommand}" Margin="6,0,0,0" CornerRadius="0" />
                <Button Grid.Column="3" Content="{loc:Loc module.offsets-table.clearAll}" Command="{Binding ClearAllCommand}" Margin="6,0,0,0" CornerRadius="0" />
                <Button Grid.Column="4" Content="{loc:Loc module.offsets-table.setAll}" Command="{Binding SetAllCommand}" Margin="6,0,0,0" CornerRadius="0" />
            </Grid>

            <!-- Tool table: optional (App Settings checkbox) AND only when the
                 controller can persist one — hidden entirely otherwise, no hint or
                 grayed-out placeholder. No redundant header; a 30px gap separates
                 it from the offsets table; one Save button writes changed tools. -->
            <StackPanel IsVisible="{Binding ShowToolTableSection}">
                <Border Height="30" />

                <!-- Visible-tool count lives in App Settings &gt; Offsets (per
                     mode); the grid renders T1..N where N is clamped to the
                     controller's actual tool slots. -->
                <StackPanel>
                    <!-- Tool table header: name + axis cells + radius (radius shares
                         the axis uniform grid, so it is exactly as wide as an axis
                         column and the name column keeps the remaining space) -->
                    <Grid ColumnDefinitions="140,*">
                        <TextBlock Text="{loc:Loc module.offsets-table.toolName}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding ToolColumnHeaders}" HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding ToolColumnHeaders.Count}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}" Classes="axisHeader" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Tool rows: editable name + axis/radius cells (mirrors the
                         offsets table; the last cell is the tip radius) -->
                    <ItemsControl ItemsSource="{Binding Tools}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EditableToolRow">
                                <Grid ColumnDefinitions="140,*">
                                    <TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="{Binding NamePlaceholder}" Classes="axisCell"
                                             VerticalContentAlignment="Center" MinWidth="90" />
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}" HorizontalAlignment="Stretch">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="{Binding Cells.Count}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:OffsetCellViewModel">
                                                <TextBox Text="{Binding Value, Mode=TwoWay}" Classes="axisCell" VerticalAlignment="Stretch"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Selected tool + actions: same shape as the offsets action row -->
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,6,0,0">
                    <TextBlock Grid.Column="0" Text="{loc:Loc module.offsets-table.tool}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedToolRow, Mode=TwoWay}" Width="150">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:EditableToolRow">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="2" Content="{loc:Loc module.offsets-table.getCurrentPosition}" Command="{Binding GetToolPositionCommand}" Margin="6,0,0,0" CornerRadius="0" />
                    <Button Grid.Column="3" Content="{loc:Loc module.offsets-table.clearAll}" Command="{Binding ClearToolsCommand}" Margin="6,0,0,0" CornerRadius="0" />
                    <Button Grid.Column="4" Content="{loc:Loc module.offsets-table.setAll}" Command="{Binding SetAllToolsCommand}" Margin="6,0,0,0" CornerRadius="0" />
                </Grid>
            </StackPanel>

            <TextBlock Text="{Binding Status}" Foreground="#777" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
