<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Modules.Fixed"
             xmlns:loc="clr-namespace:SenderNG.Localization;assembly=SenderNG"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
             x:Class="SenderNG.Modules.Fixed.ProgramView"
             x:DataType="vm:ProgramViewModel">

    <!-- Only the cycle bar (MainWindow, under the center tabs) controls a run:
         this view shows the program grid and its per-line statuses. Rows are a
         fixed 24px + 1px hairline, which the view code-behind needs for exact
         centered auto-scroll — keep the heights in sync. -->
    <Border BorderBrush="#aaa" BorderThickness="1" CornerRadius="0" Background="White">
        <DockPanel>
            <!-- Program grid header: Line (44px) | Status (28px) | Data (1*),
                 with 1px separator columns so the vertical gridlines line up
                 with the rows. Header text is aligned exactly like the cells:
                 Line right-aligned to the column edge, Data left-aligned. -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="44,1,28,1,1*" Background="#e8e8e8" Height="28">
                <TextBlock Grid.Column="0" Text="{loc:Loc module.program.line}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0" Foreground="#333" />
                <Border Grid.Column="1" Background="#d0d0d0" />
                <TextBlock Grid.Column="2" Text="" />
                <Border Grid.Column="3" Background="#d0d0d0" />
                <TextBlock Grid.Column="4" Text="{loc:Loc module.program.data}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="6,0" Foreground="#333" />
            </Grid>
            <ListBox x:Name="ProgramList" ItemsSource="{Binding ProgramRows}" Background="White" CornerRadius="0" BorderBrush="#aaa" BorderThickness="0">
                <ListBox.Styles>
                    <!-- Zero-padding items: the hover highlight then covers the
                         row content exactly instead of being inset from it. -->
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:GCodeProgramRow">
                        <!-- Row: bottom hairline separator + vertical gridlines
                             at the same x positions as the header. -->
                        <Border BorderBrush="#e6e6e6" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="44,1,28,1,1*" Height="24">
                                <TextBlock Grid.Column="0" Text="{Binding Line}" FontFamily="Consolas" FontSize="11" Foreground="#666" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0" />
                                <Border Grid.Column="1" Background="#d0d0d0" />
                                <!-- Status cell has no header; shows ✓/✕/· with error detail as tooltip -->
                                <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="13" Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="{Binding Detail}" />
                                <Border Grid.Column="3" Background="#d0d0d0" />
                                <TextBlock Grid.Column="4" Text="{Binding Data}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Margin="6,0" Foreground="#333" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
