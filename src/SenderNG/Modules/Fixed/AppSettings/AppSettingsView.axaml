<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CNC.Core.ViewModels;assembly=SenderNG.Core"
             xmlns:loc="clr-namespace:SenderNG.Localization;assembly=SenderNG"
             mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="560"
             x:Class="SenderNG.Modules.Fixed.AppSettingsView"
             x:DataType="vm:AppSettingsViewModel">

    <DockPanel Background="#f6f6f6">

        <!-- Close (bottom right, full width) -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#aaa" BorderThickness="0,1,0,0" Padding="10,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                <Button Content="{loc:Loc appSettings.close}" Command="{Binding CloseCommand}"
                        Height="28" MinHeight="28" CornerRadius="0"
                        Background="#eee" BorderBrush="#999" BorderThickness="1"
                        Padding="14,0" VerticalContentAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Master / detail split. Each pane scrolls independently. -->
        <Grid ColumnDefinitions="Auto,1,3*">

            <!-- LEFT: tree selector - only leaves are selectable -->
            <Border Grid.Column="0" MinWidth="240" BorderBrush="#aaa" BorderThickness="0,0,1,0" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto" Padding="2">
                    <TreeView ItemsSource="{Binding Groups}"
                              SelectedItem="{Binding SelectedNode}" Background="Transparent">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem">
                                <Setter Property="IsExpanded"
                                        Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                            </Style>
                            <Style Selector="TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
                                <Setter Property="Padding" Value="3,2" />
                            </Style>
                            <Style Selector="TreeViewItem:pointerover /template/ Border#Bd">
                                <Setter Property="Background" Value="#eee" />
                            </Style>
                            <Style Selector="TreeViewItem:selected /template/ Border#Bd">
                                <Setter Property="Background" Value="#ddd" />
                                <Setter Property="BorderBrush" Value="#999" />
                                <Setter Property="BorderThickness" Value="0,0,0,2" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.DataTemplates>
                            <!-- Group: label only, expands on chevron click -->
                            <TreeDataTemplate DataType="{x:Type vm:AppSettingsGroupItem}"
                                              ItemsSource="{Binding Children}"
                                              x:DataType="vm:AppSettingsGroupItem">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                           Foreground="#333" Margin="2,3,2,2" />
                            </TreeDataTemplate>

                            <!-- Global leaves -->
                            <DataTemplate DataType="{x:Type vm:ProfileSettingsLeaf}"
                                          x:DataType="vm:ProfileSettingsLeaf">
                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#222" Margin="2,2" />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:LanguageSettingsLeaf}"
                                          x:DataType="vm:LanguageSettingsLeaf">
                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#222" Margin="2,2" />
                            </DataTemplate>

                            <!-- Module leaf -->
                            <DataTemplate DataType="{x:Type vm:ModuleSettingsLeaf}"
                                          x:DataType="vm:ModuleSettingsLeaf">
                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#222" Margin="2,2" />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:HotkeysSettingsLeaf}"
                                          x:DataType="vm:HotkeysSettingsLeaf">
                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#222" Margin="2,2" />
                            </DataTemplate>
                        </TreeView.DataTemplates>
                    </TreeView>
                </ScrollViewer>
            </Border>

            <!-- RIGHT: selected leaf - data + editor -->
            <Rectangle Grid.Column="1" Fill="#ccc" />

            <Border Grid.Column="2" Padding="12,10">
                <Grid>
                    <TextBlock Text="{loc:Loc appSettings.selectHint}"
                               FontSize="12" Foreground="#888" VerticalAlignment="Top" HorizontalAlignment="Left"
                               TextWrapping="Wrap" IsVisible="{Binding HasNoSelection}" />

                    <!-- Detail editor. Content bound to the selected leaf; each leaf type has its own
                         DataTemplate so bindings never traverse a null Selected*Leaf path. -->
                    <ContentControl Content="{Binding SelectedSetting}" IsVisible="{Binding HasSelection}">
                        <ContentControl.DataTemplates>

                            <!-- Profiles (machine manager) -->
                            <DataTemplate DataType="{x:Type vm:ProfileSettingsLeaf}"
                                          x:DataType="vm:ProfileSettingsLeaf">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Orientation="Vertical" Spacing="10" Margin="0,2,10,4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#222" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#666"
                                                   TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                                        <Rectangle Height="1" Fill="#ddd" IsVisible="{Binding HasDescription}" />

                                        <TextBlock Text="{Binding SwitchBlockedText}" FontSize="11"
                                                   Foreground="#a33" TextWrapping="Wrap"
                                                   IsVisible="{Binding ShowSwitchBlocked}" />

                                        <ListBox ItemsSource="{Binding Profiles}"
                                                 SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                                 Height="170" FontSize="11" CornerRadius="0"
                                                 BorderBrush="#999" BorderThickness="1" Background="White">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ProfileItem">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="&#x2713;" FontWeight="Bold" Foreground="#080"
                                                                   IsVisible="{Binding IsActive}" />
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                        <Border Background="#e4e4e4" BorderBrush="#bbb" BorderThickness="1"
                                                                CornerRadius="2" Padding="4,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding MachineTypeId}" FontSize="10" Foreground="#555" />
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Content="{loc:Loc appSettings.profiles.activate}" FontSize="11"
                                                    Command="{Binding ActivateCommand}"
                                                    Height="24" MinHeight="24" CornerRadius="0" Padding="10,0" />
                                            <Button Content="{loc:Loc appSettings.profiles.duplicate}" FontSize="11"
                                                    Command="{Binding DuplicateCommand}"
                                                    Height="24" MinHeight="24" CornerRadius="0" Padding="10,0" />
                                            <Button Content="{Binding RemoveButtonText}" FontSize="11"
                                                    Command="{Binding RemoveCommand}"
                                                    Height="24" MinHeight="24" CornerRadius="0" Padding="10,0" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBox Text="{Binding NewName, Mode=TwoWay}" Width="170" Height="24"
                                                     MinHeight="24" FontSize="11" CornerRadius="0" BorderBrush="#999"
                                                     BorderThickness="1" VerticalContentAlignment="Center" Padding="4,0"
                                                     PlaceholderText="{loc:Loc appSettings.profiles.newName}" />
                                            <ComboBox ItemsSource="{Binding MachineTypeOptions}"
                                                      SelectedItem="{Binding NewType, Mode=TwoWay}"
                                                      Width="90" Height="24" MinHeight="24" FontSize="11"
                                                      CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                                                      VerticalContentAlignment="Center" />
                                            <Button Content="{loc:Loc appSettings.profiles.add}" FontSize="11"
                                                    Command="{Binding AddCommand}"
                                                    Height="24" MinHeight="24" CornerRadius="0" Padding="10,0" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBox Text="{Binding RenameName, Mode=TwoWay}" Width="170" Height="24"
                                                     MinHeight="24" FontSize="11" CornerRadius="0" BorderBrush="#999"
                                                     BorderThickness="1" VerticalContentAlignment="Center" Padding="4,0"
                                                     PlaceholderText="{loc:Loc appSettings.profiles.renameName}" />
                                            <Button Content="{loc:Loc appSettings.profiles.rename}" FontSize="11"
                                                    Command="{Binding RenameCommand}"
                                                    Height="24" MinHeight="24" CornerRadius="0" Padding="10,0" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{loc:Loc appSettings.profiles.type}" FontSize="11" VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding MachineTypeOptions}"
                                                      SelectedItem="{Binding SelectedMachineType, Mode=TwoWay}"
                                                      Width="90" Height="24" MinHeight="24" FontSize="11"
                                                      CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                                                      VerticalContentAlignment="Center" />
                                            <Button Content="{Binding TypeButtonText}" FontSize="11"
                                                    Command="{Binding ApplyTypeCommand}"
                                                    Height="24" MinHeight="24" CornerRadius="0" Padding="10,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </DataTemplate>

                            <!-- Language -->
                            <DataTemplate DataType="{x:Type vm:LanguageSettingsLeaf}"
                                          x:DataType="vm:LanguageSettingsLeaf">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Orientation="Vertical" Spacing="10" Margin="0,2,10,4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#222" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#666"
                                                   TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                                        <Rectangle Height="1" Fill="#ddd" IsVisible="{Binding HasDescription}" />

                                        <ComboBox ItemsSource="{Binding AvailableLocales}"
                                                  SelectedItem="{Binding SelectedLocale, Mode=TwoWay}"
                                                  Width="200" Height="26" MinHeight="26"
                                                  FontSize="12" CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                                                  VerticalContentAlignment="Center" />
                                    </StackPanel>
                                </ScrollViewer>
                            </DataTemplate>

                            <!-- Module: visibility + settings -->
                            <DataTemplate DataType="{x:Type vm:ModuleSettingsLeaf}"
                                          x:DataType="vm:ModuleSettingsLeaf">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Orientation="Vertical" Spacing="10" Margin="0,2,10,4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#222" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#666"
                                                   TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                                        <Rectangle Height="1" Fill="#ddd" IsVisible="{Binding HasDescription}" />

                                        <CheckBox Content="{loc:Loc appSettings.enabled}" IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                  IsVisible="{Binding CanHide}" FontSize="12" />

                                        <ContentControl Content="{Binding SettingsView}"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        IsVisible="{Binding SettingsView, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                        <ItemsControl ItemsSource="{Binding BoolFields}"
                                                      IsVisible="{Binding ShowGenericFields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:BoolSettingEntry">
                                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding Value, Mode=TwoWay}"
                                                              FontSize="12" Margin="0,2,0,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Fields}"
                                                      IsVisible="{Binding ShowGenericFields}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:NumericSettingEntry">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding Label}" FontSize="11"
                                                                   VerticalAlignment="Center" />
                                                        <TextBox Text="{Binding Value}" Width="110" Height="24" MinHeight="24"
                                                                 CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                                                                 FontSize="11" VerticalContentAlignment="Center" Padding="4,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </DataTemplate>

                            <!-- Hotkeys editor -->
                            <DataTemplate DataType="{x:Type vm:HotkeysSettingsLeaf}"
                                          x:DataType="vm:HotkeysSettingsLeaf">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Orientation="Vertical" Spacing="10" Margin="0,2,10,4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#222" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#666"
                                                   TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                                        <Rectangle Height="1" Fill="#ddd" IsVisible="{Binding HasDescription}" />

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBox Text="{Binding SearchText, Mode=TwoWay}" Width="220" Height="24"
                                                     MinHeight="24" FontSize="11" CornerRadius="0" BorderBrush="#999"
                                                     BorderThickness="1" VerticalContentAlignment="Center" Padding="4,0"
                                                     PlaceholderText="{loc:Loc appSettings.hotkeys.searchPlaceholder}" />
                                            <Button Content="{loc:Loc appSettings.hotkeys.restoreAll}"
                                                    Command="{Binding RestoreAllCommand}"
                                                    FontSize="11" Height="24" MinHeight="24" CornerRadius="0" Padding="10,0" />
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding Groups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:HotkeyGroup">
                                                    <StackPanel IsVisible="{Binding IsVisible}" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="#333" />
                                                        <Rectangle Height="1" Fill="#ddd" />
                                                        <ItemsControl ItemsSource="{Binding Rows}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:HotkeyEditorRow">
                                                                    <Grid IsVisible="{Binding IsVisible}"
                                                                          ColumnDefinitions="220,170,Auto,Auto,*" Margin="0,2,0,0">
                                                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                                                   FontSize="11" VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <Button Grid.Column="1" Classes="hotkey-cell" Tag="{Binding}"
                                                                                Content="{Binding RecordText}"
                                                                                Command="{Binding RecordCommand}"
                                                                                FontSize="11" Height="24" MinHeight="24"
                                                                                CornerRadius="0" Padding="6,0"
                                                                                HorizontalAlignment="Stretch"
                                                                                HorizontalContentAlignment="Left" />
                                                                        <Button Grid.Column="2" Content="{loc:Loc appSettings.hotkeys.clear}"
                                                                                Command="{Binding ClearCommand}"
                                                                                IsEnabled="{Binding CanClear}"
                                                                                FontSize="11" Height="24" MinHeight="24"
                                                                                CornerRadius="0" Padding="8,0" Margin="6,0,0,0" />
                                                                        <Button Grid.Column="3"
                                                                                Content="{loc:Loc appSettings.hotkeys.restoreDefault}"
                                                                                Command="{Binding RestoreCommand}"
                                                                                IsEnabled="{Binding CanRestore}"
                                                                                FontSize="11" Height="24" MinHeight="24"
                                                                                CornerRadius="0" Padding="8,0" Margin="6,0,0,0" />
                                                                        <TextBlock Grid.Column="4" Text="{Binding Message}"
                                                                                   IsVisible="{Binding HasMessage}"
                                                                                   FontSize="10" Foreground="#a33"
                                                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </DataTemplate>

                        </ContentControl.DataTemplates>
                    </ContentControl>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>