<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CNC.Core.ViewModels;assembly=SenderNG.Core"
             xmlns:views="clr-namespace:SenderNG.Modules.Fixed"
             xmlns:loc="clr-namespace:SenderNG.Localization;assembly=SenderNG"
             xmlns:conv="clr-namespace:SenderNG.Converters"
             mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="560"
             x:Class="SenderNG.Modules.Fixed.AppSettingsView"
             x:DataType="vm:AppSettingsViewModel">

    <UserControl.Styles>
        <!-- The profile row's fixed height is load-bearing, not decoration: the pencil
             only exists on the selected row, and without a fixed row the content's
             measured height changed with selection (16px → 20px), so the name and the
             machine badge jumped down a couple of pixels the moment a row was picked.
             Reserving the space once removes the jump, and a shorter edit box keeps the
             renaming state inside the same 20px instead of outgrowing it. -->
        <Style Selector="ListBoxItem StackPanel.row">
            <Setter Property="Height" Value="20" />
        </Style>
        <!-- A row's action buttons read as pictograms, not as chrome: they sit inside a
             list row where a themed button's border and hover wash would box in a small
             glyph. An action that cannot run is not shown at all (the context menu is
             where the full set stays visible, disabled); the two states worth tinting
             are the activate check and the armed delete below. -->
        <Style Selector="Button.rowact">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#1c5f8a" />
        </Style>
        <Style Selector="Button.rowact /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.rowact:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.rowact:pointerover">
            <Setter Property="Foreground" Value="#0d3d5c" />
        </Style>
        <Style Selector="Button.rowact:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- The activate glyph is the same check the active row wears, in black: an
             offer to become the active one, not the green state itself. -->
        <Style Selector="Button.rowact.activate">
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <!-- A delete glyph that has been clicked once (armed) reddens: the first click
             only arms it; the red background, the border and the confirm tooltip are
             what the second click confirms. The fill is set on the presenter, after the
             pointerover/pressed rules above, so the hover wash cannot repaint it. -->
        <Style Selector="Button.rowact.armed">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#7a2626" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.rowact.armed /template/ ContentPresenter">
            <Setter Property="Background" Value="#a33" />
        </Style>
        <!-- The menu's armed delete wears the same red: the menu waits open between
             the two clicks, so the fill is the cue standing where the confirming click
             lands. Like the row button's, the fill and the white text are set on the
             template parts, which outranks the flyout theme's own selected/pressed
             washes — the hovered item must stay red, not grey out. -->
        <Style Selector="MenuItem.armed /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#a33" />
        </Style>
        <Style Selector="MenuItem.armed /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- The machine-type badge doubles as the type picker. The button chrome is
             transparent — the chip stays exactly the border it always was — and the
             chip only lifts a shade under the pointer, so the click target reads as
             one. The height must not be pinned (the app's global Button style pins
             28): the flyout anchors to the button, so a taller button would open
             the picker below the chip instead of at its edge. The flyout's badges
             wear the same chip; only the panel behind them is transparent. -->
        <Style Selector="Button.typebadge">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Height" Value="NaN" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.typebadge /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.typebadge:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.typebadge:pointerover Border.chip">
            <Setter Property="Background" Value="#d8d8d8" />
            <Setter Property="BorderBrush" Value="#999" />
        </Style>
        <!-- The picker's flyout panel is transparent: no background, frame, inset or
             minimum size, so the badges inside line up with the badge above (the
             popup itself is placed left-edge-aligned, 2px below) and only the badges
             themselves show. -->
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="FlyoutPresenter /template/ Border#LayoutRoot">
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Styles>

    <DockPanel Background="#f6f6f6">

        <!-- Close (bottom right, full width) -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#aaa" BorderThickness="0,1,0,0" Padding="10,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                <Button Content="{loc:Loc appSettings.close}" Command="{Binding CloseCommand}"
                        Height="28" MinHeight="28" CornerRadius="0"
                        Background="#eee" BorderBrush="#999" BorderThickness="1"
                        Padding="14,0" VerticalContentAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Master / detail split. Each pane scrolls independently. -->
        <Grid ColumnDefinitions="Auto,1,3*">

            <!-- LEFT: tree selector - only leaves are selectable -->
            <Border Grid.Column="0" MinWidth="240" BorderBrush="#aaa" BorderThickness="0,0,1,0" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto" Padding="2">
                    <TreeView ItemsSource="{Binding Groups}"
                              SelectedItem="{Binding SelectedNode}" Background="Transparent">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem">
                                <Setter Property="IsExpanded"
                                        Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                            </Style>
                            <Style Selector="TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
                                <Setter Property="Padding" Value="3,2" />
                            </Style>
                            <Style Selector="TreeViewItem:pointerover /template/ Border#Bd">
                                <Setter Property="Background" Value="#eee" />
                            </Style>
                            <Style Selector="TreeViewItem:selected /template/ Border#Bd">
                                <Setter Property="Background" Value="#ddd" />
                                <Setter Property="BorderBrush" Value="#999" />
                                <Setter Property="BorderThickness" Value="0,0,0,2" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.DataTemplates>
                            <!-- Group: label only, expands on chevron click -->
                            <TreeDataTemplate DataType="{x:Type vm:AppSettingsGroupItem}"
                                              ItemsSource="{Binding Children}"
                                              x:DataType="vm:AppSettingsGroupItem">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                           Foreground="#333" Margin="2,3,2,2" />
                            </TreeDataTemplate>

                            <!-- Global leaves -->
                            <DataTemplate DataType="{x:Type vm:ProfileSettingsLeaf}"
                                          x:DataType="vm:ProfileSettingsLeaf">
                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#222" Margin="2,2" />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:LanguageSettingsLeaf}"
                                          x:DataType="vm:LanguageSettingsLeaf">
                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#222" Margin="2,2" />
                            </DataTemplate>

                            <!-- Module leaf -->
                            <DataTemplate DataType="{x:Type vm:ModuleSettingsLeaf}"
                                          x:DataType="vm:ModuleSettingsLeaf">
                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#222" Margin="2,2" />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:HotkeysSettingsLeaf}"
                                          x:DataType="vm:HotkeysSettingsLeaf">
                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#222" Margin="2,2" />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:BackupSettingsLeaf}"
                                          x:DataType="vm:BackupSettingsLeaf">
                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#222" Margin="2,2" />
                            </DataTemplate>
                        </TreeView.DataTemplates>
                    </TreeView>
                </ScrollViewer>
            </Border>

            <!-- RIGHT: selected leaf - data + editor -->
            <Rectangle Grid.Column="1" Fill="#ccc" />

            <Border Grid.Column="2" Padding="12,10">
                <Grid>
                    <TextBlock Text="{loc:Loc appSettings.selectHint}"
                               FontSize="12" Foreground="#888" VerticalAlignment="Top" HorizontalAlignment="Left"
                               TextWrapping="Wrap" IsVisible="{Binding HasNoSelection}" />

                    <!-- Detail editor. Content bound to the selected leaf; each leaf type has its own
                         DataTemplate so bindings never traverse a null Selected*Leaf path. -->
                    <ContentControl Content="{Binding SelectedSetting}" IsVisible="{Binding HasSelection}">
                        <ContentControl.DataTemplates>

                            <!-- Profiles (machine manager) -->
                            <DataTemplate DataType="{x:Type vm:ProfileSettingsLeaf}"
                                          x:DataType="vm:ProfileSettingsLeaf">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Orientation="Vertical" Spacing="10" Margin="0,2,10,4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#222" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#666"
                                                   TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                                        <Rectangle Height="1" Fill="#ddd" IsVisible="{Binding HasDescription}" />

                                        <!-- The list and the machine-type picture share one two-column row:
                                             the picture explains the machine behind the selected profile, so
                                             it belongs beside the list rather than down in the axis card.
                                             The left column is a dock panel — the add-profile row pinned to
                                             its bottom, the list filling the rest — and the fixed height on
                                             the row gives the list its established size and the picture its
                                             bounds, which now span that whole column (Uniform fits inside).

                                             No status or warning caption lives above this row: the active
                                             row already carries its checkmark, and a caption that appears
                                             for a moment on a switch (or on a failed one) shoves the whole
                                             list down. A failure is a pop-up instead, raised by the host. -->
                                        <Grid ColumnDefinitions="*,Auto" Height="204">
                                            <DockPanel Grid.Column="0">
                                                <!-- The add-profile row docks under the list instead of
                                                     sitting in the stack below, so the picture stands
                                                     beside both as one block. Type picker, then the
                                                     button: the name is the localized default, so there
                                                     is no field to type one in. -->
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" DockPanel.Dock="Bottom"
                                                            Margin="0,10,0,0" IsEnabled="{Binding CanSwitchProfiles}">
                                                    <ComboBox Grid.Column="0" ItemsSource="{Binding MachineTypeChoices}"
                                                              SelectedItem="{Binding NewTypeChoice, Mode=TwoWay}"
                                                              Height="24" MinHeight="24" FontSize="11"
                                                              CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                                                              VerticalContentAlignment="Center" HorizontalAlignment="Right">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:MachineTypeChoice">
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="11" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <Button Grid.Column="1" Content="{loc:Loc appSettings.profiles.add}" FontSize="11"
                                                            Command="{Binding AddCommand}"
                                                            Height="24" MinHeight="24" CornerRadius="0" Padding="10,0" />
                                                </Grid>
                                                <!-- The horizontal scrollbar is Auto: long profile names and
                                                     their row buttons can outgrow the list's width, and
                                                     enabling horizontal scrolling also stops the items from
                                                     stretching, so a row keeps its own natural width. -->
                                                <ListBox ItemsSource="{Binding Profiles}"
                                                         SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                                         IsEnabled="{Binding CanSwitchProfiles}"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                         FontSize="11" CornerRadius="0"
                                                         BorderBrush="#999" BorderThickness="1" Background="White">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ProfileRow">
                                                            <StackPanel Classes="row" Orientation="Horizontal" Spacing="6">
                                                                <!-- The context menu is the full action set, whether or
                                                                     not every button is shown: an unavailable command is
                                                                     present but disabled here, so right-click always
                                                                     tells the operator what can be done to the row. -->
                                                                <StackPanel.ContextMenu>
                                                                    <ContextMenu Closed="OnRowMenuClosed">
                                                                        <MenuItem Header="{loc:Loc appSettings.profiles.rename}"
                                                                                  Command="{Binding BeginRenameCommand}"
                                                                                  IsEnabled="{Binding CanRename}" />
                                                                        <MenuItem Header="{loc:Loc appSettings.profiles.activate}"
                                                                                  Command="{Binding ActivateCommand}"
                                                                                  IsEnabled="{Binding CanActivate}" />
                                                                 <MenuItem Header="{loc:Loc appSettings.profiles.duplicate}"
                                                                           Command="{Binding DuplicateCommand}"
                                                                           IsEnabled="{Binding CanDuplicate}" />
                                                                 <!-- The machine-type list, the current entry bold. The
                                                                      same two-step as the badge's flyout: the first
                                                                      click arms an entry with a checkmark (the menu
                                                                      waits open — the rule lands on the generated
                                                                      entries, see the view's code-behind), the second
                                                                      switches the profile. -->
                                                                 <MenuItem Header="{loc:Loc appSettings.profiles.type}"
                                                                           ItemsSource="{Binding TypeOptions}"
                                                                           IsEnabled="{Binding CanChangeType}"
                                                                           ContainerPrepared="OnTypeMenuItemPrepared">
                                                                     <MenuItem.ItemTemplate>
                                                                         <DataTemplate x:DataType="vm:MachineTypeOption">
                                                                             <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                 <TextBlock Text="{Binding DisplayName}"
                                                                                            FontWeight="{Binding IsCurrent, Converter={x:Static conv:Converters.BoldWhenTrue}}" />
                                                                                 <TextBlock Text="&#x2713;" FontWeight="Bold"
                                                                                            Foreground="#080"
                                                                                            IsVisible="{Binding IsArmed}" />
                                                                             </StackPanel>
                                                                         </DataTemplate>
                                                                     </MenuItem.ItemTemplate>
                                                                 </MenuItem>
                                                                        <!-- Keeps the menu open on its arming click: delete here
                                                                             is the same two-step gesture as the button's, and a
                                                                             menu that closed after the first click would make
                                                                             the operator start the gesture over. While armed it
                                                                             reddens and its tooltip asks for the confirming
                                                                             click (both above, in the styles). The second click
                                                                             deletes, and the menu closes with its row. -->
                                                                        <MenuItem Header="{loc:Loc appSettings.profiles.remove}"
                                                                                  Classes.armed="{Binding RemoveArmed}"
                                                                                  Command="{Binding RemoveCommand}"
                                                                                  StaysOpenOnClick="True"
                                                                                  ToolTip.Tip="{Binding RemoveHint}"
                                                                                  IsEnabled="{Binding CanRemove}" />
                                                                    </ContextMenu>
                                                                </StackPanel.ContextMenu>
                                                                <TextBlock Text="&#x2713;" FontWeight="Bold" Foreground="#080"
                                                                           VerticalAlignment="Center"
                                                                           IsVisible="{Binding IsActive}" />
                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           IsVisible="{Binding IsNotEditing}"
                                                                           DoubleTapped="OnProfileNameDoubleTapped" />
                                                                <TextBox Classes="rename" Text="{Binding RenameText, Mode=TwoWay}"
                                                                         Width="150" Height="20" MinHeight="20" FontSize="11"
                                                                         CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                                                                         VerticalContentAlignment="Center" Padding="4,0"
                                                                         IsVisible="{Binding IsEditing}"
                                                                         KeyDown="OnRenameKeyDown"
                                                                         TextChanged="OnRenameTextChanged"
                                                                         LostFocus="OnRenameLostFocus" />
                                                                <TextBlock Text="{Binding RenameError}" FontSize="10"
                                                                           Foreground="#a33" VerticalAlignment="Center"
                                                                           IsVisible="{Binding HasRenameError}" />
                                                                 <!-- The badge is the type picker: clicking it lifts
                                                                      the other types in a flyout — badges stacked at
                                                                      2px under the current one, left edges aligned,
                                                                      each wearing the same chip. First click arms one
                                                                      (a checkmark appears beside its name), the second
                                                                      switches the profile — the destructive switch
                                                                      (the new type's defaults replace the layout)
                                                                      stays behind two deliberate clicks, the same
                                                                      gesture as the delete glyph. -->
                                                                 <Button Classes="typebadge"
                                                                         ToolTip.Tip="{loc:Loc appSettings.profiles.typeChangeHint}">
                                                                     <Button.Flyout>
                                                                         <Flyout Placement="BottomEdgeAlignedLeft"
                                                                                 VerticalOffset="4"
                                                                                 IsOpen="{Binding TypeFlyoutOpen, Mode=TwoWay}">
                                                                             <ItemsControl ItemsSource="{Binding OtherTypeOptions}">
                                                                                 <ItemsControl.ItemsPanel>
                                                                                     <ItemsPanelTemplate>
                                                                                         <StackPanel Orientation="Vertical" Spacing="2" />
                                                                                     </ItemsPanelTemplate>
                                                                                 </ItemsControl.ItemsPanel>
                                                                                 <ItemsControl.ItemTemplate>
                                                                                     <DataTemplate x:DataType="vm:MachineTypeOption">
                                                                                         <Button Classes="typebadge"
                                                                                                 Command="{Binding SelectCommand}"
                                                                                                 ToolTip.Tip="{Binding Hint}">
                                                                                             <Border Classes="chip" Background="#e4e4e4" BorderBrush="#bbb"
                                                                                                     BorderThickness="1" CornerRadius="2" Padding="4,0">
                                                                                                 <StackPanel Orientation="Horizontal" Spacing="3">
                                                                                                     <TextBlock Text="{Binding DisplayName}" FontSize="10" Foreground="#555" />
                                                                                                     <TextBlock Text="&#x2713;" FontSize="10" FontWeight="Bold"
                                                                                                                Foreground="#080"
                                                                                                                IsVisible="{Binding IsArmed}" />
                                                                                                 </StackPanel>
                                                                                             </Border>
                                                                                         </Button>
                                                                                     </DataTemplate>
                                                                                 </ItemsControl.ItemTemplate>
                                                                             </ItemsControl>
                                                                         </Flyout>
                                                                     </Button.Flyout>
                                                                     <Border Classes="chip" Background="#e4e4e4" BorderBrush="#bbb" BorderThickness="1"
                                                                             CornerRadius="2" Padding="4,0" VerticalAlignment="Center">
                                                                         <TextBlock Text="{Binding MachineTypeDisplayName}" FontSize="10" Foreground="#555" />
                                                                     </Border>
                                                                 </Button>
                                                                <!-- The row's own actions, on the selected row only: a profile is
                                                                     managed where it is, not from a strip under the list that
                                                                     acted on whatever happened to be selected. All four are
                                                                     glyphs — the tooltips carry the words — and the delete one
                                                                     reddens while it waits for its confirming second click. An
                                                                     action this row refuses is hidden, not greyed (the context
                                                                     menu keeps the full set, disabled). Hidden too while the
                                                                     name is being edited — the row is a text field then. -->
                                                                <Button Content="&#x270E;" Classes="rowact pencil" FontSize="12"
                                                                        Width="20" Height="20" MinHeight="20" Padding="0"
                                                                        CornerRadius="2"
                                                                        VerticalContentAlignment="Center"
                                                                        HorizontalContentAlignment="Center"
                                                                        ToolTip.Tip="{Binding RenameHint}"
                                                                        IsVisible="{Binding ShowActions}"
                                                                        Command="{Binding BeginRenameCommand}"
                                                                        Click="OnRenameInvoked" />
                                                                <!-- Same check the active row wears next to its name. -->
                                                                <Button Content="&#x2713;" Classes="rowact activate"
                                                                        FontSize="12" FontWeight="Bold"
                                                                        Width="20" Height="20" MinHeight="20" Padding="0"
                                                                        CornerRadius="2"
                                                                        VerticalContentAlignment="Center"
                                                                        HorizontalContentAlignment="Center"
                                                                        ToolTip.Tip="{Binding ActivateHint}"
                                                                        IsVisible="{Binding ShowActivate}"
                                                                        Command="{Binding ActivateCommand}" />
                                                                <Button Content="&#x2750;" Classes="rowact duplicate"
                                                                        FontSize="12"
                                                                        Width="20" Height="20" MinHeight="20" Padding="0"
                                                                        CornerRadius="2"
                                                                        VerticalContentAlignment="Center"
                                                                        HorizontalContentAlignment="Center"
                                                                        ToolTip.Tip="{Binding DuplicateHint}"
                                                                        IsVisible="{Binding ShowDuplicate}"
                                                                        Command="{Binding DuplicateCommand}" />
                                                                <!-- The extra space on the left keeps a mis-aimed
                                                                     click on its neighbour from arming the destructive
                                                                     one. -->
                                                                <Button Content="&#x2715;" Classes="rowact remove"
                                                                        Classes.armed="{Binding RemoveArmed}"
                                                                        FontSize="12" Margin="8,0,0,0"
                                                                        Width="20" Height="20" MinHeight="20" Padding="0"
                                                                        CornerRadius="2"
                                                                        VerticalContentAlignment="Center"
                                                                        HorizontalContentAlignment="Center"
                                                                        ToolTip.Tip="{Binding RemoveHint}"
                                                                        IsVisible="{Binding ShowRemove}"
                                                                        Command="{Binding RemoveCommand}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </DockPanel>
                                            <!-- Height is the driver, not a max: the picture is exactly
                                                 as tall as the whole left column (list + add row, 204
                                                 units). Uniform derives the width from the type art's
                                                 own aspect ratio, so a MaxWidth would silently cap the
                                                 height instead. -->
                                            <Image Grid.Column="1" Margin="10,0,0,0" Height="204"
                                                   Stretch="Uniform" VerticalAlignment="Top"
                                                   Source="{Binding TopologyImage, Converter={x:Static conv:Converters.MachineTypeImage}}"
                                                   IsVisible="{Binding HasTopologyImage}" />
                                        </Grid>

                                        <Rectangle Height="1" Fill="#ddd" />

                                        <!-- Machine card: the type's topology picture, an ordered
                                             row per axis grouped by plane, the optional axes and
                                             the resolver's validation. -->
                                        <views:MachineAxesView DataContext="{Binding MachineAxes}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </DataTemplate>

                            <!-- Language -->
                            <DataTemplate DataType="{x:Type vm:LanguageSettingsLeaf}"
                                          x:DataType="vm:LanguageSettingsLeaf">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Orientation="Vertical" Spacing="10" Margin="0,2,10,4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#222" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#666"
                                                   TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                                        <Rectangle Height="1" Fill="#ddd" IsVisible="{Binding HasDescription}" />

                                        <ComboBox ItemsSource="{Binding AvailableLocales}"
                                                  SelectedItem="{Binding SelectedLocale, Mode=TwoWay}"
                                                  Width="200" Height="26" MinHeight="26"
                                                  FontSize="12" CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                                                  VerticalContentAlignment="Center">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={x:Static conv:Converters.LocaleDisplayName}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </ScrollViewer>
                            </DataTemplate>

                            <!-- Module: visibility + settings -->
                            <DataTemplate DataType="{x:Type vm:ModuleSettingsLeaf}"
                                          x:DataType="vm:ModuleSettingsLeaf">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Orientation="Vertical" Spacing="10" Margin="0,2,10,4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#222" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#666"
                                                   TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                                        <Rectangle Height="1" Fill="#ddd" IsVisible="{Binding HasDescription}" />

                                        <CheckBox Content="{loc:Loc appSettings.enabled}" IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                  IsVisible="{Binding CanHide}" FontSize="12" />

                                        <ContentControl Content="{Binding SettingsView}"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        IsVisible="{Binding SettingsView, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                        <ItemsControl ItemsSource="{Binding BoolFields}"
                                                      IsVisible="{Binding ShowGenericFields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:BoolSettingEntry">
                                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding Value, Mode=TwoWay}"
                                                              FontSize="12" Margin="0,2,0,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Fields}"
                                                      IsVisible="{Binding ShowGenericFields}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:NumericSettingEntry">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding Label}" FontSize="11"
                                                                   VerticalAlignment="Center" />
                                                         <TextBox Classes="num" Text="{Binding Value, Converter={x:Static conv:Converters.NumericText}, UpdateSourceTrigger=LostFocus}" Width="110" Height="24" MinHeight="24"
                                                                 CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                                                                 FontSize="11" VerticalContentAlignment="Center" Padding="4,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </DataTemplate>

                            <!-- Hotkeys editor -->
                            <DataTemplate DataType="{x:Type vm:HotkeysSettingsLeaf}"
                                          x:DataType="vm:HotkeysSettingsLeaf">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Orientation="Vertical" Spacing="10" Margin="0,2,10,4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#222" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#666"
                                                   TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                                        <Rectangle Height="1" Fill="#ddd" IsVisible="{Binding HasDescription}" />

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBox Text="{Binding SearchText, Mode=TwoWay}" Width="220" Height="24"
                                                     MinHeight="24" FontSize="11" CornerRadius="0" BorderBrush="#999"
                                                     BorderThickness="1" VerticalContentAlignment="Center" Padding="4,0"
                                                     PlaceholderText="{loc:Loc appSettings.hotkeys.searchPlaceholder}" />
                                            <Button Content="{loc:Loc appSettings.hotkeys.restoreAll}"
                                                    Command="{Binding RestoreAllCommand}"
                                                    FontSize="11" Height="24" MinHeight="24" CornerRadius="0" Padding="10,0" />
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding Groups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:HotkeyGroup">
                                                    <StackPanel IsVisible="{Binding IsVisible}" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="#333" />
                                                        <Rectangle Height="1" Fill="#ddd" />
                                                        <ItemsControl ItemsSource="{Binding Rows}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:HotkeyEditorRow">
                                                                    <Grid IsVisible="{Binding IsVisible}"
                                                                          ColumnDefinitions="220,170,Auto,Auto,*" Margin="0,2,0,0">
                                                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                                                   FontSize="11" VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <Button Grid.Column="1" Classes="hotkey-cell" Tag="{Binding}"
                                                                                Content="{Binding RecordText}"
                                                                                Command="{Binding RecordCommand}"
                                                                                FontSize="11" Height="24" MinHeight="24"
                                                                                CornerRadius="0" Padding="6,0"
                                                                                HorizontalAlignment="Stretch"
                                                                                HorizontalContentAlignment="Left" />
                                                                        <Button Grid.Column="2" Content="{loc:Loc appSettings.hotkeys.clear}"
                                                                                Command="{Binding ClearCommand}"
                                                                                IsEnabled="{Binding CanClear}"
                                                                                FontSize="11" Height="24" MinHeight="24"
                                                                                CornerRadius="0" Padding="8,0" Margin="6,0,0,0" />
                                                                        <Button Grid.Column="3"
                                                                                Content="{loc:Loc appSettings.hotkeys.restoreDefault}"
                                                                                Command="{Binding RestoreCommand}"
                                                                                IsEnabled="{Binding CanRestore}"
                                                                                FontSize="11" Height="24" MinHeight="24"
                                                                                CornerRadius="0" Padding="8,0" Margin="6,0,0,0" />
                                                                        <TextBlock Grid.Column="4" Text="{Binding Message}"
                                                                                   IsVisible="{Binding HasMessage}"
                                                                                   FontSize="10" Foreground="#a33"
                                                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </DataTemplate>

                            <!-- Backup & restore: archive the whole app config, or restore one -->
                            <DataTemplate DataType="{x:Type vm:BackupSettingsLeaf}"
                                          x:DataType="vm:BackupSettingsLeaf">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Orientation="Vertical" Spacing="10" Margin="0,2,10,4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#222" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#666"
                                                   TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                                        <Rectangle Height="1" Fill="#ddd" IsVisible="{Binding HasDescription}" />

                                        <TextBlock Text="{Binding FolderText}" FontSize="11" Foreground="#333"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#666"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Text="{Binding BlockedText}" FontSize="11"
                                                   Foreground="#a33" TextWrapping="Wrap"
                                                   IsVisible="{Binding ShowBlocked}" />

                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Content="{loc:Loc appSettings.backup.save}" FontSize="11"
                                                    Command="{Binding BackupCommand}"
                                                    Height="24" MinHeight="24" CornerRadius="0" Padding="10,0" />
                                            <Button Content="{Binding RestoreButtonText}" FontSize="11"
                                                    Command="{Binding RestoreCommand}"
                                                    Height="24" MinHeight="24" CornerRadius="0" Padding="10,0" />
                                        </StackPanel>

                                        <!-- Two-step confirm: nothing is written until Restore now -->
                                        <Border Background="#fff8e1" BorderBrush="#e0c060" BorderThickness="1"
                                                Padding="8" IsVisible="{Binding HasRestorePlan}">
                                            <StackPanel Orientation="Vertical" Spacing="8">
                                                <TextBlock Text="{Binding PlanSummary}" FontSize="11"
                                                           Foreground="#664d00" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Button Content="{Binding RestoreNowText}" FontSize="11"
                                                            Command="{Binding ApplyRestoreCommand}"
                                                            Height="24" MinHeight="24" CornerRadius="0" Padding="10,0" />
                                                    <Button Content="{loc:Loc appSettings.backup.cancel}" FontSize="11"
                                                            Command="{Binding CancelRestoreCommand}"
                                                            Height="24" MinHeight="24" CornerRadius="0" Padding="10,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatus}"
                                                   FontSize="11" Foreground="#080" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ScrollViewer>
                            </DataTemplate>

                        </ContentControl.DataTemplates>
                    </ContentControl>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>