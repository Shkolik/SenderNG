<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CNC.Core.ViewModels;assembly=SenderNG.Core"
             xmlns:loc="clr-namespace:SenderNG.Localization;assembly=SenderNG"
             mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="420"
             x:Class="SenderNG.Modules.Fixed.MachineAxesView"
             x:DataType="vm:MachineAxesViewModel">

    <!-- Every editor below is OneWay-bound (display only) and writes from an explicit,
         type-guarded, deferred handler in the code-behind: the axis rows sit in
         ItemsControls whose containers are reused when the selected profile changes, the
         machine type is switched, or a row is added/removed, and a recycled control raises
         a Change event carrying the previous row's state. -->
    <UserControl.Styles>
        <!-- Gotcha: a single-line TextBox's internal ScrollViewer shows a phantom overlay
             scrollbar on hover unless auto-hide is off. -->
        <Style Selector="TextBox">
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
        </Style>
        <!-- Fluent's CheckBox template centers its 20px box only inside a hardcoded
             32px inner grid (CheckBoxMinHeight) that is top-aligned in the control; in
             the row's pinned 24px that grid sits low and its bottom clips. The class
             makes the selector a trigger — the only kind of style that outranks a
             value set by a template — so releasing the pin and centering the grid
             sizes it to the box itself, and the box centers in the row like every
             other control. -->
        <Style Selector="CheckBox.inverted /template/ Grid#RootGrid > Grid">
            <Setter Property="Height" Value="NaN" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- The editable fields of one axis row, on the six shared axis-table columns. The
             delete button is NOT part of it: a locked base row must not render one at all
             (an invisible button is both dead weight and a trap for anything that searches the
             pane for a delete button). -->
        <DataTemplate x:Key="AxisFields" x:DataType="vm:MachineAxisRowViewModel">
            <StackPanel Orientation="Vertical">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <!-- Shared widths, not per-grid ones: every header and every row lives in
                             the one IsSharedSizeScope (the root panel), so a column measures once
                             and all of them use that width. Fluent leaves a ComboBox
                             HorizontalAlignment=Left, so a cell that is not stretched sizes itself
                             to its own text and each row drifts; the editors below are stretched
                             into their shared column instead. -->
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="AxisIndex" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="AxisType" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="AxisRole" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="AxisDirection" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="AxisAlias" />
                        <!-- The trailing star is load-bearing, not decoration: without a star
                             column Avalonia arranges every cell one pixel wider than its own
                             definition, so a row would sit 1px right of the same column in the
                             header grids (which do carry one). -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- The derived letter: the controller's own, never a stored one. -->
                    <TextBlock Grid.Column="0" Text="{Binding BoardLetterText}" FontSize="12"
                               FontWeight="SemiBold" Foreground="#1c5f8a" VerticalAlignment="Center"
                               ToolTip.Tip="{loc:Loc appSettings.axes.boardLetterHint}" />

                    <ComboBox Grid.Column="1" ItemsSource="{Binding IndexChoices}"
                              SelectedItem="{Binding SelectedIndex, Mode=OneWay}"
                              SelectionChanged="OnIndexSelectionChanged"
                              HorizontalAlignment="Stretch"
                              Height="24" MinHeight="24" FontSize="11" CornerRadius="0"
                              BorderBrush="#999" BorderThickness="1" VerticalContentAlignment="Center"
                              ToolTip.Tip="{Binding RowHint}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AxisIndexChoice">
                                <TextBlock Text="{Binding Display}" FontSize="11" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox Grid.Column="2" ItemsSource="{Binding KindChoices}"
                              SelectedItem="{Binding SelectedKind, Mode=OneWay}"
                              SelectionChanged="OnKindSelectionChanged"
                              HorizontalAlignment="Stretch"
                              Height="24" MinHeight="24" FontSize="11" CornerRadius="0"
                              BorderBrush="#999" BorderThickness="1" VerticalContentAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AxisKindChoice">
                                <TextBlock Text="{Binding Display}" FontSize="11" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox Grid.Column="3" ItemsSource="{Binding DirectionChoices}"
                              SelectedItem="{Binding SelectedDirection, Mode=OneWay}"
                              SelectionChanged="OnDirectionSelectionChanged"
                              HorizontalAlignment="Stretch"
                              Height="24" MinHeight="24" FontSize="11" CornerRadius="0"
                              BorderBrush="#999" BorderThickness="1" VerticalContentAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AxisDirectionChoice">
                                <TextBlock Text="{Binding Display}" FontSize="11" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- The axis's sense. Checked = the axis counts negative (Sign < 0); the
                         stored Sign semantics are unchanged, only the control is. -->
                    <CheckBox Grid.Column="4" Classes="inverted" Margin="0,0" Padding="0,0"
                              IsChecked="{Binding IsInverted, Mode=OneWay}"
                              Click="OnInvertedClick"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              MinWidth="0" Height="24" MinHeight="24" FontSize="11"
                              VerticalContentAlignment="Center"
                              ToolTip.Tip="{loc:Loc appSettings.axes.invertedHint}" />

                    <TextBox Grid.Column="5" Classes="alias" Text="{Binding AliasText, Mode=OneWay}"
                             TextChanged="OnAliasTextChanged" MaxLength="1"
                             HorizontalAlignment="Stretch" MinWidth="0"
                             Height="24" MinHeight="24" FontSize="11" CornerRadius="0"
                             BorderBrush="#999" BorderThickness="1" VerticalContentAlignment="Center"
                             Padding="4,0" PlaceholderText="—"
                             ToolTip.Tip="{loc:Loc appSettings.axes.aliasHint}" />
                </Grid>

                <!-- Invariant 7: a rotary axis shows exactly two pivot inputs, labelled by
                     the two directions perpendicular to its own; a linear row shows none. -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="26,2,0,0"
                            IsVisible="{Binding IsRotary}">
                    <TextBlock Text="{loc:Loc appSettings.axes.pivot}" FontSize="10" Foreground="#666"
                               VerticalAlignment="Center"
                               ToolTip.Tip="{loc:Loc appSettings.axes.pivotHint}" />
                    <ItemsControl ItemsSource="{Binding Pivots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AxisPivotRowViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#333"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               ToolTip.Tip="{Binding LabelHint}" />
                                    <TextBox Classes="num" Text="{Binding ValueText, Mode=OneWay}"
                                             TextChanged="OnPivotTextChanged"
                                             Width="66" Height="24" MinHeight="24" FontSize="11"
                                             CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                                             VerticalContentAlignment="Center" Padding="4,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- A locked base row: the preset fixes its count and order, so no delete button. -->
        <DataTemplate x:Key="AxisRow" x:DataType="vm:MachineAxisRowViewModel">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AxisFields}"
                            Margin="0,1,0,1" />
        </DataTemplate>

        <!-- An optional row is deletable: the button sits immediately after the CAM alias,
             beside the row it belongs to. The wrapper does NOT redeclare the shared column
             set: a second spacing-bearing grid over the same SharedSizeGroup scope as the
             AxisFields grid inside the ContentControl sends Avalonia's layout into an
             infinite measure loop. The Auto column hands the inner grid its own desired
             width — cells still line up through the shared values — and the trailing star
             keeps the 1px cell arithmetic shared with the header grids. -->
        <DataTemplate x:Key="OptionalAxisRow" x:DataType="vm:MachineAxisRowViewModel">
            <Grid Margin="0,1,0,1" ColumnDefinitions="Auto,Auto,*">
                <ContentControl Grid.Column="0" Content="{Binding}"
                                ContentTemplate="{StaticResource AxisFields}" />
                <Button Grid.Column="1" Content="{Binding RemoveText}" Command="{Binding RemoveCommand}"
                        VerticalAlignment="Center" VerticalContentAlignment="Center"
                        Margin="8,0,0,0" Height="24" MinHeight="24" FontSize="11"
                        CornerRadius="0" Padding="8,0" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- One shared-size scope for the whole card: the axis table's headers and rows all read
         their column widths from it, so every row lines up under the same labels. -->
    <StackPanel Orientation="Vertical" Spacing="8" Grid.IsSharedSizeScope="True"
                IsEnabled="{Binding IsEditable}">

        <!-- Machine type. The topology picture is NOT here: it sits beside the profile
             list, where it identifies the machine behind the selected profile. -->
        <TextBlock Text="{Binding MachineTypeName}" FontSize="11" FontWeight="SemiBold" Foreground="#333" />

        <!-- A machine-type switch replaces the layout but deliberately leaves DemoAxes
             alone: warn when the demo now simulates fewer axes than the type needs. -->
        <Border Background="#fff8e1" BorderBrush="#e0c060" BorderThickness="1" Padding="6"
                IsVisible="{Binding HasDemoAxesHint}">
            <TextBlock Text="{Binding DemoAxesHint}" FontSize="11" Foreground="#664d00"
                       TextWrapping="Wrap" />
        </Border>

        <!-- One block per plane, in machine order (the picture's columns). -->
        <ItemsControl ItemsSource="{Binding Planes}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MachinePlaneViewModel">
                    <StackPanel Orientation="Vertical" Spacing="2" Margin="0,4,0,2">
                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#333" />
                        <Rectangle Height="1" Fill="#ddd" />
                        <!-- The column labels. Same six shared columns as the rows below, so the
                             labels sit over their controls; the widths live in the shared scope,
                             never here, so the header cannot drift from the rows. -->
                        <Grid Margin="0,0,0,1" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="AxisIndex" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="AxisType" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="AxisRole" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="AxisDirection" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="AxisAlias" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="{loc:Loc appSettings.axes.index}"
                                       FontSize="10" Foreground="#888" />
                            <TextBlock Grid.Column="2" Text="{loc:Loc appSettings.axes.type}"
                                       FontSize="10" Foreground="#888" />
                            <TextBlock Grid.Column="3" Text="{loc:Loc appSettings.axes.role}"
                                       FontSize="10" Foreground="#888" />
                            <TextBlock Grid.Column="4" Text="{loc:Loc appSettings.axes.inverted}"
                                       FontSize="10" Foreground="#888" />
                            <TextBlock Grid.Column="5" Text="{loc:Loc appSettings.axes.alias}"
                                       FontSize="10" Foreground="#888" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Axes}"
                                      ItemTemplate="{StaticResource AxisRow}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Multi-plane machines carry the plane-to-plane distance (the foam's wire length). -->
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasSeparation}"
                    Margin="0,4,0,0">
            <TextBlock Text="{loc:Loc appSettings.axes.separation}" FontSize="11"
                       VerticalAlignment="Center"
                       ToolTip.Tip="{loc:Loc appSettings.axes.separationHint}" />
            <TextBox Classes="num" Text="{Binding SeparationText, Mode=OneWay}"
                     TextChanged="OnSeparationTextChanged"
                     Width="90" Height="24" MinHeight="24" FontSize="11" CornerRadius="0"
                     BorderBrush="#999" BorderThickness="1" VerticalContentAlignment="Center" Padding="4,0" />
        </StackPanel>

        <Rectangle Height="1" Fill="#ddd" Margin="0,4,0,0" />

        <!-- Optional axes: rotaries and extra linears, never inside a plane. No reference art
             here: the rotary picture was unreadable at this size and it mangled the list. -->
        <StackPanel Orientation="Vertical" Spacing="2">
            <TextBlock Text="{loc:Loc appSettings.axes.optional}" FontSize="12" FontWeight="SemiBold"
                       Foreground="#333" />
            <TextBlock Text="{loc:Loc appSettings.axes.optionalHint}" FontSize="10"
                       Foreground="#888" TextWrapping="Wrap" />
            <Grid Margin="0,2,0,1" ColumnSpacing="4" IsVisible="{Binding HasOptionalAxes}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AxisIndex" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AxisType" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AxisRole" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AxisDirection" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AxisAlias" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="{loc:Loc appSettings.axes.index}"
                           FontSize="10" Foreground="#888" />
                <TextBlock Grid.Column="2" Text="{loc:Loc appSettings.axes.type}"
                           FontSize="10" Foreground="#888" />
                <TextBlock Grid.Column="3" Text="{loc:Loc appSettings.axes.role}"
                           FontSize="10" Foreground="#888" />
                <TextBlock Grid.Column="4" Text="{loc:Loc appSettings.axes.inverted}"
                           FontSize="10" Foreground="#888" />
                <TextBlock Grid.Column="5" Text="{loc:Loc appSettings.axes.alias}"
                           FontSize="10" Foreground="#888" />
            </Grid>
            <ItemsControl ItemsSource="{Binding OptionalAxes}"
                          ItemTemplate="{StaticResource OptionalAxisRow}" IsVisible="{Binding HasOptionalAxes}" />
            
            <Button Content="{loc:Loc appSettings.axes.add}" Command="{Binding AddAxisCommand}"
                    HorizontalAlignment="Left" Margin="0,3,0,0" VerticalAlignment="Center"
                    Height="24" MinHeight="24" FontSize="11" CornerRadius="0" Padding="10,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
