<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Modules.Plugins"
             xmlns:conv="clr-namespace:SenderNG.Converters"
             xmlns:loc="clr-namespace:SenderNG.Localization;assembly=SenderNG"
             mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="140"
             x:Class="SenderNG.Modules.Plugins.OutlineView"
             x:DataType="vm:OutlineViewModel">

    <StackPanel Margin="8" Spacing="6">
        <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#444">
            <Run Text="{loc:Loc module.outline.description}" />
            <LineBreak />
            <Run Text="{loc:Loc module.outline.warning}" Foreground="#c03030" FontWeight="Bold" />
        </TextBlock>

        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0">
            <TextBlock Grid.Column="0" Text="{loc:Loc module.outline.feedRate}" FontSize="11" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding FeedRate, Converter={x:Static conv:Converters.NumericText}}"
                     Height="28" MinHeight="28" CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                     Margin="6,0" Padding="6,0" VerticalContentAlignment="Center" FontSize="12" />
            <TextBlock Grid.Column="2" Text="{loc:Loc common.mmMin}" FontSize="10" Foreground="#888" VerticalAlignment="Center" />
        </Grid>

        <Button Content="{loc:Loc common.go}" Command="{Binding GoCommand}"
                HorizontalAlignment="Left" MinWidth="80"
                Height="30" MinHeight="30" CornerRadius="0"
                Background="#eee" BorderBrush="#999" BorderThickness="1"
                FontSize="12" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

        <TextBlock Text="{Binding Status}" FontSize="9" Foreground="#888"
                   TextTrimming="CharacterEllipsis" />
    </StackPanel>
</UserControl>
