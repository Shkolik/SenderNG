<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Modules.Plugins"
             xmlns:loc="clr-namespace:SenderNG.Localization;assembly=SenderNG"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="460"
             x:Class="SenderNG.Modules.Plugins.StepperCalibrationView"
             x:DataType="vm:StepperCalibrationViewModel">
    <DockPanel Background="#f6f6f6">

        <Border DockPanel.Dock="Bottom" BorderBrush="#aaa" BorderThickness="0,1,0,0" Padding="10,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Status}" FontSize="10" Foreground="#888"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Loc module.stepper-calibration.back}" Command="{Binding BackCommand}"
                            IsVisible="{Binding CanGoBack}" Padding="14,0" Height="28" MinHeight="28"
                            CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" />
                    <Button Content="{loc:Loc module.stepper-calibration.next}" Command="{Binding NextCommand}"
                            IsVisible="{Binding CanAdvance}" Padding="14,0" Height="28" MinHeight="28"
                            CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" />
                    <Button Content="{loc:Loc module.stepper-calibration.stop}" Command="{Binding StopCommand}"
                            IsVisible="{Binding IsMoving}" Padding="14,0" Height="28" MinHeight="28"
                            CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" />
                    <Button Content="{loc:Loc module.stepper-calibration.save}" Command="{Binding SaveCommand}"
                            IsVisible="{Binding CanSave}" Padding="14,0" Height="28" MinHeight="28"
                            CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" />
                    <Button Content="{loc:Loc module.stepper-calibration.newCalibration}" Command="{Binding NewCommand}"
                            IsVisible="{Binding IsDone}" Padding="14,0" Height="28" MinHeight="28"
                            CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Margin="14" Spacing="10">

            <!-- Setup -->
            <StackPanel Spacing="10" IsVisible="{Binding IsSetup}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{loc:Loc module.stepper-calibration.axis}" VerticalAlignment="Center" Width="140" />
                    <ComboBox ItemsSource="{Binding Axes}" SelectedIndex="{Binding SelectedAxis}" Width="120" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{loc:Loc module.stepper-calibration.direction}" VerticalAlignment="Center" Width="140" />
                    <RadioButton Content="{loc:Loc module.stepper-calibration.positive}"
                                 IsChecked="{Binding MovePositive}" GroupName="dir" />
                    <RadioButton Content="{loc:Loc module.stepper-calibration.negative}"
                                 IsChecked="{Binding !MovePositive}" GroupName="dir" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{loc:Loc module.stepper-calibration.distance}" VerticalAlignment="Center" Width="140" />
                    <TextBox Text="{Binding Distance}" Width="120" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{loc:Loc module.stepper-calibration.currentSteps}" VerticalAlignment="Center" Width="140" />
                    <TextBlock Text="{Binding CurrentStepsPerUnit, StringFormat={}{0:0.###}}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- Measure -->
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding Step, Converter={x:Static vm:StepperCalibrationStepConverters.IsMeasureForward}}">
                    <TextBlock Text="{loc:Loc module.stepper-calibration.measured}" VerticalAlignment="Center" Width="200" />
                    <TextBox Text="{Binding MeasuredDistance}" Width="120" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding Step, Converter={x:Static vm:StepperCalibrationStepConverters.IsMeasureBacklash}}">
                    <TextBlock Text="{loc:Loc module.stepper-calibration.backlash}" VerticalAlignment="Center" Width="200" />
                    <TextBox Text="{Binding Backlash}" Width="120" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{loc:Loc module.stepper-calibration.newSteps}" VerticalAlignment="Center" Width="200" />
                    <TextBlock Text="{Binding NewStepsPerUnit, StringFormat={}{0:0.######}}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- Done -->
            <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" IsVisible="{Binding IsDone}" />

        </StackPanel>
    </DockPanel>
</UserControl>