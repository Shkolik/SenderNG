<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Modules.Plugins"
             xmlns:conv="clr-namespace:SenderNG.Converters"
             xmlns:loc="clr-namespace:SenderNG.Localization;assembly=SenderNG"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="400"
			 MinWidth="450" Height="400"
             x:Class="SenderNG.Modules.Plugins.StepperCalibrationView"
             x:DataType="vm:StepperCalibrationViewModel">
    <DockPanel Background="{DynamicResource Sender.Bg.Window}" Margin="10">
        <DockPanel.Styles>
            <Style Selector="TextBlock.unit">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Foreground" Value="{DynamicResource Sender.Text.Muted.Alt}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="6,0,0,0" />
            </Style>
        </DockPanel.Styles>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Sender.Border}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">                    
                    <Button Content="{loc:Loc module.stepper-calibration.next}" Command="{Binding NextCommand}"
                            IsVisible="{Binding CanAdvance}" Padding="14,0" Height="28" MinHeight="28"
                            CornerRadius="0" Background="{DynamicResource Sender.Bg.Button}" BorderBrush="{DynamicResource Sender.Border.Input}" BorderThickness="1" />
                    <Button Content="{loc:Loc module.stepper-calibration.stop}" Command="{Binding StopCommand}"
                            IsEnabled="{Binding IsMoving}" Padding="14,0" Height="28" MinHeight="28"
                            CornerRadius="0" Background="{DynamicResource Sender.Bg.Button}" BorderBrush="{DynamicResource Sender.Border.Input}" BorderThickness="1" />
                    <Button Content="{loc:Loc module.stepper-calibration.save}" Command="{Binding SaveCommand}"
                            IsEnabled="{Binding CanSave}" Padding="14,0" Height="28" MinHeight="28"
                            CornerRadius="0" Background="{DynamicResource Sender.Bg.Button}" BorderBrush="{DynamicResource Sender.Border.Input}" BorderThickness="1" />
                    <Button Content="{loc:Loc module.stepper-calibration.newCalibration}" Command="{Binding NewCommand}"
                            IsVisible="{Binding IsDone}" Padding="14,0" Height="28" MinHeight="28"
                            CornerRadius="0" Background="{DynamicResource Sender.Bg.Button}" BorderBrush="{DynamicResource Sender.Border.Input}" BorderThickness="1" />
                </StackPanel>
            </Grid>
        </Border>

		<!-- Done -->
		<TextBlock Text="{Binding Status}" Foreground="{DynamicResource Sender.Text.Error.Alt}" TextWrapping="Wrap" DockPanel.Dock="Bottom" Margin="0,10" MaxWidth="450"/>
		
		<Grid ColumnDefinitions="Auto, 150, Auto, *" RowDefinitions="Auto,Auto,Auto,20,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">
			<!-- Setup -->
			<TextBlock Grid.Column="0" Grid.Row="0" Text="{loc:Loc module.stepper-calibration.axis}" VerticalAlignment="Center" />
			<ComboBox Grid.Column="1" Grid.Row="0" ItemsSource="{Binding Axes}" SelectedIndex="{Binding SelectedAxis}" Width="150" IsEnabled="{Binding IsSetup}"/>

			<TextBlock Grid.Column="0" Grid.Row="1" Text="{loc:Loc module.stepper-calibration.distance}" VerticalAlignment="Center"/>
			<TextBox x:Name="DistanceBox" Classes="num" Grid.Column="1" Grid.Row="1" Text="{Binding Distance, Converter={x:Static conv:Converters.NumericText}}" Width="150" IsEnabled="{Binding IsSetup}"/>
			<TextBlock Grid.Column="2" Grid.Row="1" Classes="unit" Text="{loc:Loc common.mm, DText='mm'}" />

			<TextBlock Grid.Column="0" Grid.Row="2" Text="{loc:Loc module.stepper-calibration.currentSteps}" VerticalAlignment="Center"/>
			<TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding CurrentStepsPerUnit, StringFormat={}{0:0.###}}" VerticalAlignment="Center"/>
			<TextBlock Grid.Column="2" Grid.Row="2" Classes="unit" Text="{loc:Loc common.stepsPerMm, DText='steps/mm'}" />

			<!-- Measure -->
			<TextBlock Grid.Column="0" Grid.Row="4" Text="{loc:Loc module.stepper-calibration.measured}" VerticalAlignment="Center"/>
			<TextBox x:Name="MeasuredBox" Classes="udec" Grid.Column="1" Grid.Row="4" Text="{Binding MeasuredDistance, Converter={x:Static conv:Converters.NumericText}}" Width="150" 
					 IsEnabled="{Binding Step, Converter={x:Static vm:StepperCalibrationStepConverters.IsMeasureForward}}"/>
			<TextBlock Grid.Column="2" Grid.Row="4" Classes="unit" Text="{loc:Loc common.mm, DText='mm'}" />

			<TextBlock Grid.Column="0" Grid.Row="5" Text="{loc:Loc module.stepper-calibration.backlash}" VerticalAlignment="Center"/>
			<TextBox x:Name="BacklashBox" Classes="udec" Grid.Column="1" Grid.Row="5" Text="{Binding Backlash, Converter={x:Static conv:Converters.NumericText}}" Width="150" 
					 IsEnabled="{Binding Step, Converter={x:Static vm:StepperCalibrationStepConverters.IsMeasureBacklash}}"/>
			<TextBlock Grid.Column="2" Grid.Row="5" Classes="unit" Text="{loc:Loc common.mm, DText='mm'}" />

			<TextBlock Grid.Column="0" Grid.Row="6" Text="{loc:Loc module.stepper-calibration.newSteps}" VerticalAlignment="Center"/>
			<TextBlock Grid.Column="1" Grid.Row="6" Text="{Binding NewStepsPerUnit, StringFormat={}{0:0.######}}" VerticalAlignment="Center" />
			<TextBlock Grid.Column="2" Grid.Row="6" Classes="unit" Text="{loc:Loc common.stepsPerMm, DText='steps/mm'}" />
		</Grid>
    </DockPanel>
</UserControl>