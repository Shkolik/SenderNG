<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Modules.Plugins"
             xmlns:panels="clr-namespace:SenderNG.Modules.Plugins"
             xmlns:conv="clr-namespace:SenderNG.Converters"
             xmlns:prims="using:Avalonia.Controls.Primitives"
             xmlns:probing="clr-namespace:SenderNG.Core.Modules.Probing;assembly=SenderNG.Core"
             xmlns:loc="clr-namespace:SenderNG.Localization;assembly=SenderNG"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="800"
             x:Class="SenderNG.Modules.Plugins.ProbeView"
             x:DataType="vm:ProbeViewModel"
             panels:ProbeDesignState.PinnedTool="HeightMap">

    <UserControl.Styles>
        <!-- Flat group-box look: bordered card with a small header -->
        <Style Selector="Border.group">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#aaa" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <!-- Label + numeric field row -->
        <Style Selector="TextBlock.fld">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style Selector="TextBox.num">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderBrush" Value="#999" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
			<Setter Property="Width" Value="60" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- Tool strip toggle -->
        <Style Selector="RadioButton.tool">
            <!-- Fluent's ControlTheme sets HorizontalAlignment=Left + VerticalAlignment=Center on
                 RadioButton, which stops the last child of a DockPanel (LastChildFill) from
                 stretching into the remaining space. Override both to Stretch. -->
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Root" CornerRadius="0" BorderThickness="1" Padding="10,6"
                            Background="#eee" BorderBrush="#999">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.tool:checked /template/ Border#Root">
            <Setter Property="Background" Value="#ddd" />
            <Setter Property="BorderBrush" Value="#666" />
        </Style>
        <!-- Edge/corner selector buttons: flat squares filling their cell (jog-widget style) -->
        <Style Selector="RadioButton.edge">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Root" CornerRadius="0" BorderThickness="1" Margin="1"
                            Background="#eee" BorderBrush="#999"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.edge:checked /template/ Border#Root">
            <Setter Property="Background" Value="#ddd" />
            <Setter Property="BorderBrush" Value="#666" />
        </Style>
        <!-- Padlock checkbox (jog-widget style): open lock when unchecked, closed when checked. -->
        <Style Selector="CheckBox.padlock">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent" Width="34" Height="34" HorizontalAlignment="Center">
                        <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Open lock (unchecked) -->
                            <Path x:Name="UnlockedIcon" Data="M5 8 V6 A3 3 0 0 1 11 6 M4 8 L12 8 L12 15 L4 15 Z"
                                  Stroke="#555" StrokeThickness="1.5" Width="16" Height="16" Stretch="None"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <!-- Closed lock (checked) -->
                            <Path x:Name="LockedIcon" Data="M5 8 V6 A3 3 0 0 1 11 6 V8 M4 8 L12 8 L12 15 L4 15 Z M8 10 L8 12"
                                  Stroke="#333" StrokeThickness="1.5" Width="16" Height="16" Stretch="None"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox.padlock:checked /template/ Path#UnlockedIcon">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="CheckBox.padlock:checked /template/ Path#LockedIcon">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </UserControl.Styles>

    <!-- Horizontal ScrollViewer wraps the whole probing tab: the right column is a fixed
         600px (widest row = the six tool-toggle buttons on one line) because a star column
         is measured with infinite width inside a scrolling container and would collapse/
         balloon. A horizontal scrollbar appears when the hosting panel is narrower than
         176 + 600. -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <Grid ColumnDefinitions="Auto,Auto">

        <!-- ============================ Left: profiles + settings ============================ -->
		<Grid Margin="6,4" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="2" MinWidth="200">

			<!-- Profile selector (combo fills the line, ... opens the profile menu) -->
			<Grid Grid.Row="0" ColumnDefinitions="*,32">
				<ComboBox Grid.Column="0" Height="24" MinHeight="24" CornerRadius="0" BorderBrush="#999"
						  BorderThickness="1" FontSize="11"
						  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
						  ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
						  IsEditable="True"
						  prims:TextSearch.TextBinding="{ReflectionBinding Name}"
						  Text="{Binding NewProfileName, Mode=TwoWay}">
					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="probing:ProbingProfile">
							<TextBlock Text="{Binding Name}" FontSize="11" />
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
				<Button Grid.Column="1" Content="..." Height="24" MinHeight="24" Padding="0" Margin="4,0,0,0"
						HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
						CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" FontSize="11"
						ToolTip.Tip="{loc:Loc module.probing.profileActions, DText='Profile actions'}" Click="ProfileMenu_Click">
					<Button.ContextMenu>
						<ContextMenu>
							<MenuItem Header="{loc:Loc common.add, DText='Add'}" Command="{Binding ProfileAddCommand}" />
							<MenuItem Header="{loc:Loc common.apply, DText='Apply'}" Command="{Binding ProfileUpdateCommand}" />
							<MenuItem Header="{loc:Loc common.remove, DText='Remove'}" Command="{Binding ProfileDeleteCommand}" />
						</ContextMenu>
					</Button.ContextMenu>
				</Button>
			</Grid>

			<!-- Probe tip/tool -->
			<Border Grid.Row="1" Classes="group">
				<StackPanel Spacing="3">
					<TextBlock Text="{loc:Loc module.probing.probeTipTool, DText='Probe tip/tool'}" FontWeight="SemiBold" 
							   FontSize="11" Margin="0,0,0,3" />
					<DockPanel>						
						<TextBox DockPanel.Dock="Right" Grid.Column="1" Classes="num" Text="{Binding ProbeDiameter, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" />
						<TextBlock Classes="fld" Text="{loc:Loc module.probing.diameter, DText='Diameter:'}"/>
					</DockPanel>
				</StackPanel>
			</Border>

			<!-- Touch plate/fixture height -->
			<Border Grid.Row="2" Classes="group">
				<StackPanel Spacing="3">
					<TextBlock Text="{loc:Loc module.probing.touchPlateHeight, DText='Touch plate/fixture height'}" FontWeight="SemiBold" 
							   FontSize="11" Margin="0,0,0,3" />
					<DockPanel>						
						<TextBox DockPanel.Dock="Right" Grid.Column="1" Classes="num" Text="{Binding TouchPlateHeight, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" />
						<TextBlock Classes="fld" Text="{loc:Loc module.probing.touchPlate, DText='Touch plate:'}" />
					</DockPanel>
					<DockPanel>
						<TextBox DockPanel.Dock="Right" Grid.Column="1" Classes="num" Text="{Binding FixtureHeight, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" />
						<TextBlock Classes="fld" Text="{loc:Loc module.probing.fixture, DText='Fixture:'}" />
					</DockPanel>
				</StackPanel>
			</Border>

			<!-- Probing distances and speed -->
			<Border Grid.Row="3" Classes="group">
				<StackPanel Spacing="3">
					<TextBlock Text="{loc:Loc module.probing.distancesAndSpeed, DText='Probing distances and speed'}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
					<DockPanel>
						<TextBox DockPanel.Dock="Right" Classes="num" Text="{Binding RapidsFeedRate, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" />
						<TextBlock Classes="fld" Text="{loc:Loc module.probing.rapidsFeedRate, DText='Rapids feed rate:'}" ToolTip.Tip="{loc:Loc module.probing.rapidsFeedRateHint, DText='Feed for rapid moves; 0 uses the controller setting'}" />						
					</DockPanel>
					<DockPanel>
						<TextBox DockPanel.Dock="Right" Grid.Column="1" Classes="num" Text="{Binding ProbeFeedRate, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" />
						<TextBlock Classes="fld" Text="{loc:Loc module.probing.searchFeedRate, DText='Search feed rate:'}" ToolTip.Tip="{loc:Loc module.probing.searchFeedRateHint, DText='Feed rate for the initial probing move'}" />
					</DockPanel>
					<DockPanel>
						<TextBox DockPanel.Dock="Right" Grid.Column="1" Classes="num" Text="{Binding LatchFeedRate, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" />
						<TextBlock Classes="fld" Text="{loc:Loc module.probing.latchFeedRate, DText='Latch feed rate:'}" ToolTip.Tip="{loc:Loc module.probing.latchFeedRateHint, DText='Feed rate for the second slow probing move'}" />
					</DockPanel>
					<DockPanel>
						<TextBox DockPanel.Dock="Right" Grid.Column="1" Classes="num" Text="{Binding ProbeDistance, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" />
						<TextBlock Classes="fld" Text="{loc:Loc module.probing.probingDistance, DText='Probing distance:'}" ToolTip.Tip="{loc:Loc module.probing.probingDistanceHint, DText='Maximum distance of a probing move'}" />
					</DockPanel>
					<DockPanel>
						<TextBox DockPanel.Dock="Right" Grid.Column="1" Classes="num" Text="{Binding LatchDistance, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" />
						<TextBlock Classes="fld" Text="{loc:Loc module.probing.latchDistance, DText='Latch distance:'}" ToolTip.Tip="{loc:Loc module.probing.latchDistanceHint, DText='Retract before the slow probe; 0 skips it'}" />
					</DockPanel>
				</StackPanel>
			</Border>

			<!-- Probing clearances -->
			<Border Grid.Row="4" Classes="group">
				<StackPanel Spacing="3">
					<TextBlock Text="{loc:Loc module.probing.clearances, DText='Probing clearances'}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
					<DockPanel>
						<TextBox DockPanel.Dock="Right" Classes="num" Text="{Binding XYClearance, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" />
						<TextBlock Classes="fld" Text="{loc:Loc module.probing.xyClearance, DText='XY Clearance:'}" ToolTip.Tip="{loc:Loc module.probing.xyClearanceHint, DText='Initial distance away from the face to probe'}" />
					</DockPanel>
					<DockPanel>
						<TextBox DockPanel.Dock="Right" Classes="num" Text="{Binding Offset, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" />
						<TextBlock Classes="fld" Text="{loc:Loc module.probing.offset, DText='Offset:'}" ToolTip.Tip="{loc:Loc module.probing.offsetHint, DText='Distance from the corner to the probe point'}" />
					</DockPanel>
					<DockPanel>
						<TextBox DockPanel.Dock="Right" Classes="num" Text="{Binding Depth, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" />
						<TextBlock Classes="fld" Text="{loc:Loc module.probing.depth, DText='Depth:'}" ToolTip.Tip="{loc:Loc module.probing.depthHint, DText='Z below the start position where XY probing happens'}" />
					</DockPanel>
				</StackPanel>
			</Border>

			<!-- Probe/touchplate XY offsets -->
			<Border Grid.Row="5" Classes="group">
				<StackPanel Spacing="3">
					<TextBlock Text="{loc:Loc module.probing.xyOffsets, DText='Probe/touchplate XY offsets'}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
					<DockPanel>
						<TextBox DockPanel.Dock="Right" Classes="num" Text="{Binding ProbeOffsetX, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" />
						<TextBlock Classes="fld" Text="X:" ToolTip.Tip="{loc:Loc module.probing.xOffsetHint, DText='X offset from the probe to the controlled point'}" />
					</DockPanel>
					<DockPanel>

						<TextBox DockPanel.Dock="Right" Classes="num" Text="{Binding ProbeOffsetY, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}" />
						<TextBlock Classes="fld" Text="Y:" ToolTip.Tip="{loc:Loc module.probing.yOffsetHint, DText='Y offset from the probe to the controlled point'}" />
					</DockPanel>
					<CheckBox Content="{loc:Loc module.probing.isTouchPlate, DText='Is touch plate'}" FontSize="11" IsChecked="{Binding TouchPlateIsXY}" />
				</StackPanel>
			</Border>

			<!-- Coordinate writing -->
			<Border Grid.Row="6" Classes="group">
				<StackPanel Spacing="3">
					<TextBlock Text="{loc:Loc module.probing.setOffset, DText='Set offset'}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
					<Grid ColumnDefinitions="*,6,*,6,*" Margin="0,0,0,8">
						<RadioButton Grid.Column="0" Classes="tool" Content="G10" FontSize="11" GroupName="cmode" IsChecked="{Binding IsCoordG10}" />
						<RadioButton Grid.Column="2" Classes="tool" Content="G92" FontSize="11" GroupName="cmode" IsChecked="{Binding IsCoordG92}" />
						<RadioButton Grid.Column="4" Classes="tool" Content="{loc:Loc module.probing.measure, DText='Measure'}" FontSize="11" GroupName="cmode" IsChecked="{Binding IsCoordMeasure}" />						
					</Grid>
					<DockPanel Grid.Row="2">						
						<ComboBox DockPanel.Dock="Right" Width="70" Grid.Column="1" Height="24" MinHeight="24" CornerRadius="0" BorderBrush="#999"
								  BorderThickness="1" FontSize="11"
								  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
								  ItemsSource="{Binding CoordinateSystemNames}"
								  SelectedIndex="{Binding CoordinateSystemIndex, Mode=TwoWay}" />
						<TextBlock Classes="fld" Text="{loc:Loc module.probing.system, DText='System:'}" />
					</DockPanel>
				</StackPanel>
			</Border>

			<!-- Last result -->
			<TextBlock Grid.Row="7" Text="{Binding LastResult}" TextWrapping="Wrap" FontSize="10" Foreground="#555"
					   FontFamily="Consolas,monospace" IsVisible="{Binding LastResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
		</Grid>

        <!-- ============================ Right: tool strip + panel ============================ -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto">

            <!-- Tool toggle strip (ioSender's inner TabControl as buttons, one row) -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,6,2,0" x:Name="ToolToggleStrip">
				<RadioButton Classes="tool" GroupName="tool" Content="{loc:Loc module.probing.tipTool, DText='Tool length'}"
                             IsChecked="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=ToolLength}"
                             IsVisible="{Binding ToolLengthEnabled}" />
                <RadioButton Classes="tool" GroupName="tool" Content="{loc:Loc module.probing.edgeExternal, DText='Edge external'}"
                             IsChecked="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=EdgeFinderExternal}"
                             IsVisible="{Binding EdgeExternalEnabled}" />
                <RadioButton Classes="tool" GroupName="tool" Content="{loc:Loc module.probing.edgeInternal, DText='Edge internal'}"
                             IsChecked="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=EdgeFinderInternal}"
                             IsVisible="{Binding EdgeInternalEnabled}" />
                <RadioButton Classes="tool" GroupName="tool" Content="{loc:Loc module.probing.rotation, DText='Rotation'}"
                             IsChecked="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=Rotation}"
                             IsVisible="{Binding RotationEnabled}" />
                <RadioButton Classes="tool" GroupName="tool" Content="{loc:Loc module.probing.tabCenter, DText='Center'}"
                             IsChecked="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=CenterFinder}"
                             IsVisible="{Binding CenterEnabled}" />
                <RadioButton Classes="tool" GroupName="tool" Content="{loc:Loc module.probing.heightmap, DText='Height map'}"
                             IsChecked="{Binding SelectedTool, Converter={x:Static conv:Converters.EnumToBool}, ConverterParameter=HeightMap}"
                             IsVisible="{Binding HeightMapEnabled}" />
            </StackPanel>

            <!-- Instructions + warning -->
            <Border Grid.Row="1" Margin="6" Padding="6" HorizontalAlignment="Stretch"
                    Background="#fff8e1" BorderBrush="#e0c060" BorderThickness="1">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Instructions}" TextWrapping="Wrap" FontSize="11" Foreground="#333" />
                    <TextBlock Text="{loc:Loc module.probing.warning, DText='Warning! Use with care - incorrect parameters may damage your probe!'}"
                               Foreground="Red" FontWeight="Bold" FontSize="10" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Per-tool panel: in the designer only the panel pinned via
                 panels:ProbeDesignState.PinnedTool on the root renders (all
                 Is* bindings fail without a DataContext, so every panel
                 would otherwise stack on top of the others); at runtime the
                 Is* bindings select the active tool. -->
            <Grid Grid.Row="2" Margin="6" MaxWidth="{Binding Path=Bounds.Width, ElementName=ToolToggleStrip}">
                <panels:ToolLengthPanel IsVisible="{Binding IsToolLength}" />
                <panels:EdgeFinderPanel IsVisible="{Binding IsEdgeExternal}" />
                <panels:EdgeFinderPanel IsVisible="{Binding IsEdgeInternal}" />
                <panels:CenterFinderPanel IsVisible="{Binding IsCenter}" />
                <panels:RotationPanel IsVisible="{Binding IsRotation}" />
                <panels:HeightMapPanel IsVisible="{Binding IsHeightMap}" />
            </Grid>

            <!-- Start / Stop -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6" Margin="6,0,6,8">
                <Button Content="{loc:Loc common.start, DText='Start'}" Command="{Binding StartCommand}" Width="90" Height="30" MinHeight="30"
                        CornerRadius="0" Background="#eee" Foreground="Black" BorderBrush="#999" BorderThickness="1"
                        VerticalContentAlignment="Center" />
                <Button Content="{loc:Loc common.stop, DText='Stop'}" Command="{Binding StopCommand}" Width="90" Height="30" MinHeight="30"
                        CornerRadius="0" Background="#e04545" Foreground="White" BorderBrush="#b00" BorderThickness="1"
                        VerticalContentAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
