<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SenderNG.Modules.Plugins"
             xmlns:conv="clr-namespace:SenderNG.Converters"
             xmlns:loc="clr-namespace:SenderNG.Localization;assembly=SenderNG"
             x:Class="SenderNG.Modules.Plugins.HeightMapPanel"
             x:DataType="vm:ProbeViewModel">

    <StackPanel Spacing="10" Margin="0,4" HorizontalAlignment="Stretch">
        <TextBlock Text="{loc:Loc module.probing.heightmapDesc}"
                   FontSize="11" Foreground="#333" TextWrapping="Wrap" />

        <Border CornerRadius="0" Background="White" BorderBrush="#aaa" BorderThickness="1" Padding="6"
                HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc module.probing.area}" FontWeight="SemiBold" FontSize="11" />
                <Grid ColumnDefinitions="90,*,90,*" RowDefinitions="Auto,Auto" Width="430" HorizontalAlignment="Left">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc module.probing.minX}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding HmMinX, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}"
                             Height="24" MinHeight="24" CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                             FontSize="11" Padding="4,0" VerticalContentAlignment="Center" Margin="0,0,12,4" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Loc module.probing.maxX}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding HmMaxX, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}"
                             Height="24" MinHeight="24" CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                             FontSize="11" Padding="4,0" VerticalContentAlignment="Center" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc module.probing.minY}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HmMinY, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}"
                             Height="24" MinHeight="24" CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                             FontSize="11" Padding="4,0" VerticalContentAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{loc:Loc module.probing.maxY}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding HmMaxY, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}"
                             Height="24" MinHeight="24" CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                             FontSize="11" Padding="4,0" VerticalContentAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <Border CornerRadius="0" Background="White" BorderBrush="#aaa" BorderThickness="1" Padding="6"
                HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Loc module.probing.grid}" FontWeight="SemiBold" FontSize="11" />
                <Grid ColumnDefinitions="90,*,90,*" Width="430" HorizontalAlignment="Left">
                    <TextBlock Grid.Column="0" Text="{loc:Loc module.probing.gridX}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Grid.Column="1" Text="{Binding HmGridSizeX, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}"
                             Height="24" MinHeight="24" CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                             FontSize="11" Padding="4,0" VerticalContentAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="2" Text="{loc:Loc module.probing.gridY}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Grid.Column="3" Text="{Binding HmGridSizeY, Mode=TwoWay, Converter={x:Static conv:Converters.NumericText}}"
                             Height="24" MinHeight="24" CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                             FontSize="11" Padding="4,0" VerticalContentAlignment="Center" />
                </Grid>
                <CheckBox Content="{loc:Loc module.probing.lockXY}" IsChecked="{Binding HmLockXY}" FontSize="11" />
                <CheckBox Content="{loc:Loc module.probing.addPause}" IsChecked="{Binding HmAddPause}" FontSize="11"
                          ToolTip.Tip="{loc:Loc module.probing.addPauseHint}" />
                <CheckBox Content="{loc:Loc module.probing.setToolOffset}" IsChecked="{Binding HmSetToolOffset}" FontSize="11" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="{loc:Loc module.probing.saveMap}" Command="{Binding HeightMapSaveCommand}" Padding="12,5" Height="28" MinHeight="28"
                    CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" FontSize="11" VerticalContentAlignment="Center" />
            <Button Content="{loc:Loc module.probing.loadMap}" Command="{Binding HeightMapLoadCommand}" Padding="12,5" Height="28" MinHeight="28"
                    CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" FontSize="11" VerticalContentAlignment="Center" />
            <Button Content="{loc:Loc module.probing.applyToProgram}" Command="{Binding HeightMapApplyCommand}" Padding="12,5" Height="28" MinHeight="28"
                    CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" FontSize="11" VerticalContentAlignment="Center"
                    IsEnabled="{Binding HasHeightMap}" />
        </StackPanel>
    </StackPanel>
</UserControl>
