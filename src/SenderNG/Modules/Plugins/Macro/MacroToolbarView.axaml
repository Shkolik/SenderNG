<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Modules.Plugins"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="56"
             x:Class="SenderNG.Modules.Plugins.MacroToolbarView"
             x:DataType="vm:MacroViewModel"
             IsVisible="{Binding HasToolbarMacros}">

    <!-- 18 px lead margin + the toolbar StackPanel's 6 px spacing = 24 px from the file buttons. -->
    <Border Margin="18,0,0,0" VerticalAlignment="Center">
        <ItemsControl x:Name="MacroToolbarItems" ItemsSource="{Binding ToolbarMacros}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MacroItem" x:CompileBindings="False">
                    <Button ToolTip.Tip="{Binding Name}"
                            Command="{Binding $parent[UserControl].DataContext.RunToolbarCommand}"
                            CommandParameter="{Binding}"
                            Width="48" Height="48" MinHeight="48" CornerRadius="0" Padding="2,2"
                            Background="{DynamicResource Sender.Bg.Button}"
                            Foreground="{DynamicResource Sender.Text.OnButton}"
                            BorderBrush="{DynamicResource Sender.Border.Input}" BorderThickness="1"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ToolbarLabel}" FontSize="13" MaxWidth="40"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Sender.Text.OnButton}" />
                            <TextBlock Text="{Binding ToolbarIndex}" FontSize="9" VerticalAlignment="Top"
                                       IsVisible="{Binding HasShortName}"
                                       Foreground="{DynamicResource Sender.Text.OnButton}" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
