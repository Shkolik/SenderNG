<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\appIcon.ico</ApplicationIcon>
    <Version>0.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to match Avalonia.Desktop/Win32/etc. below: a floating 12.* once
         resolved to 12.1.2 while the platform packages stayed on 12.1.1, which
         crashed startup with TypeLoadException (PopupImpl.SetHitTestVisible). -->
    <PackageReference Include="Avalonia" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\banner.png" />
    <AvaloniaResource Include="Assets\appIcon.png" />
    <AvaloniaResource Include="Assets\appIcon.ico" />
    <!-- Machine-topology reference pictures for the profile's axis editor,
         loaded as avares://SenderNG/Assets/machine-topology/<file>. Wildcarded
         so replacing a drawing needs no edit here (same pattern as the Probing
         module's Assets\Probing\*.png). Placeholder art for now. -->
    <AvaloniaResource Include="Assets\machine-topology\*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SenderNG.Core\SenderNG.Core.csproj" />
    <!-- Plugin modules are DISCOVERED at runtime (ModuleCatalog scans
         OutputDir/Modules/*.dll): no compile-time dependency. These build-order
         references only guarantee the plugins are built before their DLLs are
         staged below — the app never references their types. The SDK assembly
         (SenderNG.Modules.Common) ships the same way: present in Modules/ for
         plugin assembly resolution, never referenced by app code. -->
    <ProjectReference Include="..\SenderNG.Modules.Common\SenderNG.Modules.Common.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SenderNG.Modules.Common.Render\SenderNG.Modules.Common.Render.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SenderNG.Modules.Excellon\SenderNG.Modules.Excellon.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SenderNG.Modules.HeightMapViewer\SenderNG.Modules.HeightMapViewer.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SenderNG.Modules.Hpgl\SenderNG.Modules.Hpgl.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SenderNG.Modules.Plotter\SenderNG.Modules.Plotter.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SenderNG.Modules.Plotter.GL\SenderNG.Modules.Plotter.GL.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SenderNG.Modules.Probing\SenderNG.Modules.Probing.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Locale data is a UI responsibility: copied on build into OutputDir/Locale
         so the host can discover the requested locale and pass its stream into
         LocalizationService (Core owns only the mechanism). -->
    <Content Include="Locale\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Locale\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
    <!-- Plugin payloads: each plugin ships its own DLL + Locale catalogs under
         OutputDir/Modules/<id>/Locale (registered by the host). Linked here from
         the plugin projects so they land in the app output; real third-party
         plugins are dropped into Modules/ by hand. -->
    <None Include="..\SenderNG.Modules.Common\bin\$(Configuration)\$(TargetFramework)\SenderNG.Modules.Common.dll">
      <Link>Modules\SenderNG.Modules.Common.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Render SDK: Common.Render + its Silk.NET closure ship flat in Modules/
         (Model A), referenced by plugins, never bundled per plugin. Declared as
         None items rather than a copy target so `dotnet publish -o` carries them
         (publish is driven by project items, not by files in the build output). -->
    <None Include="..\SenderNG.Modules.Common.Render\bin\$(Configuration)\$(TargetFramework)\SenderNG.Modules.Common.Render.dll">
      <Link>Modules\SenderNG.Modules.Common.Render.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\SenderNG.Modules.Common.Render\bin\$(Configuration)\$(TargetFramework)\Silk.NET.Core.dll">
      <Link>Modules\Silk.NET.Core.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\SenderNG.Modules.Common.Render\bin\$(Configuration)\$(TargetFramework)\Silk.NET.Maths.dll">
      <Link>Modules\Silk.NET.Maths.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\SenderNG.Modules.Common.Render\bin\$(Configuration)\$(TargetFramework)\Silk.NET.OpenGL.dll">
      <Link>Modules\Silk.NET.OpenGL.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\SenderNG.Modules.Excellon\bin\$(Configuration)\$(TargetFramework)\SenderNG.Modules.Excellon.dll">
      <Link>Modules\SenderNG.Modules.Excellon.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\SenderNG.Modules.Excellon\Locale\**\*.json">
      <Link>Modules\excellon\Locale\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\SenderNG.Modules.Hpgl\bin\$(Configuration)\$(TargetFramework)\SenderNG.Modules.Hpgl.dll">
      <Link>Modules\SenderNG.Modules.Hpgl.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\SenderNG.Modules.Hpgl\Locale\**\*.json">
      <Link>Modules\hpgl\Locale\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\SenderNG.Modules.HeightMapViewer\bin\$(Configuration)\$(TargetFramework)\SenderNG.Modules.HeightMapViewer.dll">
      <Link>Modules\SenderNG.Modules.HeightMapViewer.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\SenderNG.Modules.HeightMapViewer\Locale\**\*.json">
      <Link>Modules\heightmap-viewer\Locale\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\SenderNG.Modules.Plotter\bin\$(Configuration)\$(TargetFramework)\SenderNG.Modules.Plotter.dll">
      <Link>Modules\SenderNG.Modules.Plotter.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\SenderNG.Modules.Plotter\Locale\**\*.json">
      <Link>Modules\plotter\Locale\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\SenderNG.Modules.Plotter.GL\bin\$(Configuration)\$(TargetFramework)\SenderNG.Modules.Plotter.GL.dll">
      <Link>Modules\SenderNG.Modules.Plotter.GL.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\SenderNG.Modules.Plotter.GL\Locale\**\*.json">
      <Link>Modules\plotter-gl\Locale\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\SenderNG.Modules.Probing\bin\$(Configuration)\$(TargetFramework)\SenderNG.Modules.Probing.dll">
      <Link>Modules\SenderNG.Modules.Probing.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\SenderNG.Modules.Probing\Locale\**\*.json">
      <Link>Modules\probing\Locale\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SenderNG.Core.Tests" />
    <InternalsVisibleTo Include="SenderNG.Tests" />
  </ItemGroup>
</Project>
