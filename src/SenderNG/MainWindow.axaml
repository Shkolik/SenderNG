<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SenderNG.ViewModels"
        xmlns:fixed="clr-namespace:SenderNG.Modules.Fixed"
        xmlns:m="clr-namespace:SenderNG.Core.Modules;assembly=SenderNG.Core"
        xmlns:conv="clr-namespace:SenderNG.Converters"
        xmlns:loc="clr-namespace:SenderNG.Localization"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="SenderNG.MainWindow"
        x:DataType="vm:MainViewModel"
         Title="{Binding Title, FallbackValue=SenderNG}" Width="1000" Height="600"
         Background="#f6f6f6">

    <!-- Flyout strip buttons: width stays 32, height adapts to rotated text.
         Overrides app-wide fixed Button Height=28 (class selector beats type selector). -->
    <Window.Styles>
        <Style Selector="Button.flyoutToggle">
            <Setter Property="Height" Value="NaN" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="280,*,260,Auto" RowDefinitions="Auto,*,Auto,Auto">

        <!-- Row0: Menu + Toolbar (grid-column 0/3) -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                Background="#e8e8e8" BorderBrush="#aaa" BorderThickness="0,0,0,1" HorizontalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Stretch">
                <Menu Background="#e8e8e8" CornerRadius="0">
                    <MenuItem Header="{loc:Loc app.menu.file}">
                        <MenuItem Header="{loc:Loc app.menu.file.open}" Command="{Binding OpenFileCommand}" />
                        <MenuItem Header="{loc:Loc app.menu.file.recent}" ItemsSource="{Binding RecentFiles}">
                            <MenuItem.ItemContainerTheme>
                                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header" Value="{Binding}" />
                                    <Setter Property="Command" Value="{Binding $parent[Window].DataContext.SelectRecentCommand}" />
                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                </ControlTheme>
                            </MenuItem.ItemContainerTheme>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{loc:Loc app.menu.file.connect}" Command="{Binding ConnectCommand}" />
                        <MenuItem Header="{loc:Loc app.menu.file.disconnect}" Command="{Binding DisconnectCommand}" />
                        <Separator />
                        <MenuItem Header="{loc:Loc app.menu.file.exit}" Command="{Binding $parent[Window].Close}" />
                    </MenuItem>
                    <MenuItem Header="{loc:Loc app.menu.settings}" ItemsSource="{Binding SettingsMenu}" x:CompileBindings="False">
                        <MenuItem.ItemContainerTheme>
                            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="Header" Value="{Binding Header}" />
                                <Setter Property="Command" Value="{Binding Command}" />
                                <Setter Property="CommandParameter" Value="{Binding Parameter}" />
                            </ControlTheme>
                        </MenuItem.ItemContainerTheme>
                    </MenuItem>
                    <MenuItem Header="{loc:Loc app.menu.help}">
                        <MenuItem Header="{loc:Loc app.menu.help.about}" Command="{Binding AboutCommand}" />
                    </MenuItem>
                </Menu>
                <Border BorderBrush="#aaa" BorderThickness="0,1,0,0" Padding="4,2" Background="#e8e8e8" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- Toolbox buttons square 48x48 icon-only with ToolTip, contour icons -->
                        <Button Command="{Binding ConnectCommand}" ToolTip.Tip="{loc:Loc app.toolbar.connect}" Width="48" Height="48" MinHeight="48" CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <!-- Plug/connector outline (stroke only) -->
                            <Path Data="M7 2 L7 6 M13 2 L13 6 M5 6 L15 6 L15 10 C15 12.8 12.8 15 10 15 C7.2 15 5 12.8 5 10 Z M10 15 L10 18"
                                  Stroke="Black" StrokeThickness="1.5"
                                  Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button Command="{Binding OpenFileCommand}" ToolTip.Tip="{loc:Loc app.toolbar.open}" Width="48" Height="48" MinHeight="48" CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <!-- Folder outline (stroke only) -->
                            <Path Data="M3 5 h4 l2 2 h6 v7 a1 1 0 0 1 -1 1 H4 a1 1 0 0 1 -1 -1 Z"
                                  Stroke="Black" StrokeThickness="1.5"
                                  Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <!-- Toolbar extensible: additional module toolbar items can be added here via ItemsControl bound to ToolbarModules -->
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Col0 Row1: Left Border with 5 Expanders -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="White" BorderBrush="#aaa" BorderThickness="0,0,1,0" HorizontalAlignment="Stretch">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                <!-- DRO -->
                <Expander Grid.Row="0" IsExpanded="True" CornerRadius="0" Background="White"
                          BorderBrush="#aaa" BorderThickness="1" Margin="4,4,4,2" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock Text="{Binding DroHeader, FallbackValue='DRO'}" FontWeight="SemiBold" />
                    </Expander.Header>
                    <Border HorizontalAlignment="Stretch">
                        <ContentControl Content="{Binding DroContent}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" />
                    </Border>
                </Expander>

                <!-- Program limits: hidden until a program with motion is loaded -->
                <Expander Grid.Row="1" IsExpanded="True" CornerRadius="0" Background="White"
                          BorderBrush="#aaa" BorderThickness="1" Margin="4,2" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsVisible="{Binding HasProgramLimits}">
                    <Expander.Header>
                        <TextBlock Text="{loc:Loc app.panel.programLimits}" FontWeight="SemiBold" />
                    </Expander.Header>
                    <Border Padding="6" HorizontalAlignment="Stretch">
                        <ItemsControl ItemsSource="{Binding ProgramLimitRows}" HorizontalAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="fixed:ProgramLimitRow">
                                    <Grid ColumnDefinitions="22,*,8,*,Auto" Margin="0,1" HorizontalAlignment="Stretch">
                                        <TextBlock Grid.Column="0" Text="{Binding Letter}" FontSize="16" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding Min, StringFormat={}{0:F3}, Mode=OneWay}" IsReadOnly="True"
                                                 Height="32" MinHeight="32" CornerRadius="0" BorderBrush="#999" BorderThickness="1" Padding="6,0"
                                                 FontSize="13" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="2,0" />
                                        <TextBlock Grid.Column="2" Text="-" VerticalAlignment="Center" TextAlignment="Center" FontSize="11" Foreground="#666" />
                                        <TextBox Grid.Column="3" Text="{Binding Max, StringFormat={}{0:F3}, Mode=OneWay}" IsReadOnly="True"
                                                 Height="32" MinHeight="32" CornerRadius="0" BorderBrush="#999" BorderThickness="1" Padding="6,0"
                                                 FontSize="13" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="2,0" />
                                        <TextBlock Grid.Column="4" Text="mm" VerticalAlignment="Center" FontSize="11" Foreground="#888" Margin="4,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Expander>

                <!-- Left plugins ItemsControl (flex:1 fills) — hidden when no extra left plugins (count <=2) -->
                <Expander Grid.Row="2" IsExpanded="True" CornerRadius="0" Background="White"
                          BorderBrush="#aaa" BorderThickness="1" Margin="4,2" Padding="0"
                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          IsVisible="{Binding LeftModules, Converter={x:Static conv:Converters.LeftPluginsVisible}}">
                    <Expander.Header>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc app.panel.leftPlugins}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Loc app.panel.leftPluginsHint}" Foreground="#888" FontSize="9" />
                        </StackPanel>
                    </Expander.Header>
                    <ScrollViewer VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <ItemsControl ItemsSource="{Binding LeftModules}" Margin="4" HorizontalAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NamedModule">
                                    <Border BorderBrush="#aaa" BorderThickness="1" CornerRadius="0" Margin="0,2" Padding="6" Background="#fafafa" HorizontalAlignment="Stretch">
                                        <TextBlock Text="{Binding Name}" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Expander>

                <!-- Signals (pinned bottom) — fixed, no Expander header. ioSender's
                     SignalsControl layout: axis/limit LEDs anchored left, machine
                     control signals (probe, door, e-stop, hold, cycle start, reset,
                     motor) anchored right in the same row. Two WrapPanels in a
                     3-column grid (Auto,*,Auto) reproduce the DockPanel Left/Right
                     split so each group wraps independently when space is tight. -->
                <Border Grid.Row="3" Background="White" BorderBrush="#aaa" BorderThickness="0,1,0,0" Margin="0" Padding="4,6" HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding AxisSignalIndicators}" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SignalIndicator">
                                    <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Margin="4,0" ToolTip.Tip="{Binding ToolTip}">
                                        <Ellipse Width="14" Height="14" Stroke="#777" StrokeThickness="1.4"
                                                 Fill="{Binding IsActive, Converter={x:Static conv:Converters.SignalBrush}}"
                                                 HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Letter}" FontSize="11" Foreground="#333" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding ControlSignalIndicators}" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SignalIndicator">
                                    <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Margin="4,0" ToolTip.Tip="{Binding ToolTip}">
                                        <Ellipse Width="14" Height="14" Stroke="#777" StrokeThickness="1.4"
                                                 Fill="{Binding IsActive, Converter={x:Static conv:Converters.SignalBrush}}"
                                                 HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Letter}" FontSize="11" Foreground="#333" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- State / Controls (pinned bottom) — fixed, no Expander, aligns with Cycle bar height 28 -->
                <Border Grid.Row="4" Background="White" BorderBrush="#aaa" BorderThickness="0,1,0,0" Margin="0" Padding="4" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                        <!-- State row as a 3-column grid: [State] | [indicator, stretches to fit
                             NOT CONNECTED] | [x Check]. The indicator has no fixed width so the
                             longest state text (NOT CONNECTED) and short ones (Alarm, Check) both
                             fit and center. -->
                        <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                            <TextBlock Grid.Column="0" Text="{loc:Loc app.state.label}" FontSize="12" FontWeight="SemiBold" Foreground="#333" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Border Grid.Column="1" Height="30" MinHeight="30" VerticalAlignment="Center" Margin="0,0,6,0"
                                    Background="{Binding StateBrush}" BorderBrush="#8a8" BorderThickness="1" CornerRadius="0" HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding MachineStateDisplay}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{Binding StateForeground}"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                            <CheckBox Grid.Column="2" Content="{loc:Loc app.state.check}" FontSize="11" CornerRadius="0" VerticalAlignment="Center"
                                      Command="{Binding CheckCommand}" IsChecked="{Binding IsCheckMode, Mode=OneWay}"
                                      ToolTip.Tip="{loc:Loc app.state.checkTip}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" HorizontalAlignment="Stretch">
                            <Button Grid.Column="0" Content="{loc:Loc app.state.home}" Command="{Binding HomeCommand}" ToolTip.Tip="{loc:Loc app.state.homeTip}" CornerRadius="0" Background="#eee" Foreground="Black" BorderBrush="#999" BorderThickness="1" Margin="0,0,2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0" Height="28" MinHeight="28" />
                            <Button Grid.Column="1" Content="{loc:Loc app.state.unlock}" Command="{Binding UnlockCommand}" ToolTip.Tip="{loc:Loc app.state.unlockTip}" CornerRadius="0" Background="#eee" Foreground="Black" BorderBrush="#999" BorderThickness="1" Margin="2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0" Height="28" MinHeight="28" />
                            <Button Grid.Column="2" Content="{loc:Loc app.state.reset}" Command="{Binding ResetCommand}" ToolTip.Tip="{loc:Loc app.state.resetTip}" CornerRadius="0" Background="#e04545" Foreground="White" BorderBrush="#b00" BorderThickness="1" Margin="2,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0" Height="28" MinHeight="28" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Col1 Row1: Center — TabControl with one tab per Center-claiming module (Program, Console) -->
        <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="#aaa" BorderThickness="1,0,0,0" HorizontalAlignment="Stretch">
            <Grid RowDefinitions="*,Auto">
                <TabControl Grid.Row="0" ItemsSource="{Binding CenterTabs}" CornerRadius="0" Background="White" Margin="4" HorizontalAlignment="Stretch">
                    <TabControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CenterTab">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:CenterTab">
                            <ContentControl Content="{Binding View}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>

                <!-- Cycle bar: 4 Buttons left-aligned below Center TabControl — Height 28, flat contour glyphs black/white on bg -->
                <Border Grid.Row="1" Background="#e8e8e8" BorderBrush="#aaa" BorderThickness="0,1,0,0" Padding="6" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Command="{Binding CycleStartCommand}" ToolTip.Tip="{loc:Loc app.cycle.startTip}" CornerRadius="0" Background="#eee" Foreground="Black" BorderBrush="#999" BorderThickness="1" Padding="8,0" FontSize="11" Height="28" MinHeight="28" VerticalAlignment="Center" VerticalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <PathIcon Data="M6 5 L14 10 L6 15 Z" Width="12" Height="12" Foreground="Black" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc app.cycle.start}" Foreground="Black" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding FeedHoldCommand}" ToolTip.Tip="{loc:Loc app.cycle.feedHoldTip}" CornerRadius="0" Background="#eee" Foreground="Black" BorderBrush="#999" BorderThickness="1" Padding="8,0" FontSize="11" Height="28" MinHeight="28" VerticalAlignment="Center" VerticalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <PathIcon Data="M5 5 L7 5 L7 15 L5 15 Z M9 5 L11 5 L11 15 L9 15 Z" Width="12" Height="12" Foreground="Black" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc app.cycle.feedHold}" Foreground="Black" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding StopCommand}" ToolTip.Tip="{loc:Loc app.cycle.stopTip}" CornerRadius="0" Background="#e04545" Foreground="White" BorderBrush="#b00" BorderThickness="1" Padding="8,0" FontSize="11" Height="28" MinHeight="28" VerticalAlignment="Center" VerticalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <PathIcon Data="M5 5 L11 5 L11 11 L5 11 Z" Width="12" Height="12" Foreground="White" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc app.cycle.stop}" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RewindCommand}" ToolTip.Tip="{loc:Loc app.cycle.rewindTip}" CornerRadius="0" Background="#eee" Foreground="Black" BorderBrush="#999" BorderThickness="1" Padding="8,0" FontSize="11" Height="28" MinHeight="28" VerticalAlignment="Center" VerticalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <PathIcon Data="M12 5 A6 6 0 1 0 12 15 L12 13 A4 4 0 1 1 12 7 Z M11 8 L8 11 L11 11 Z" Width="12" Height="12" Foreground="Black" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc app.cycle.rewind}" Foreground="Black" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Col2 Row1: Right panel (own column — flyout strip never covers it); flyout drawer overlays on top -->
        <Panel x:Name="FlyoutHost" Grid.Row="1" Grid.Column="2">
            <Border Background="White" BorderBrush="#aaa" BorderThickness="1,0,0,0" HorizontalAlignment="Stretch" Margin="0,0,0,0">
                <ScrollViewer HorizontalAlignment="Stretch" Margin="0,0,0,0">
                    <StackPanel Spacing="2" Margin="4" HorizontalAlignment="Stretch">
                        <ItemsControl ItemsSource="{Binding RightModuleViews}" HorizontalAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ModuleView">
                                    <Expander IsExpanded="True" CornerRadius="0" Background="White"
                                              BorderBrush="#aaa" BorderThickness="1" Margin="0,2" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <Expander.Header>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" />
                                        </Expander.Header>
                                        <Border Padding="4" HorizontalAlignment="Stretch">
                                            <ContentControl Content="{Binding View}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" />
                                        </Border>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Panel>

        <!-- Flyout drawer overlay — spans only the center + right columns (never
             covering the left DRO panel or the strip), anchored right at the
             strip's left edge. The column span caps its width at center + right
             so the DRO stays visible. The flyout view is placed directly in the
             star row (no wrapping ScrollViewer) so its height is clamped to the
             row — this lets views with their own ScrollViewer (e.g. Probing)
             pin their scrollbars to the viewport instead of the content bottom.
             Tall views without an internal scrollbar clip to the row. -->
        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                MinWidth="360" MaxWidth="{Binding $parent[Window].Width}"
                MaxHeight="{Binding #FlyoutHost.Bounds.Height}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="White" BorderBrush="#aaa" BorderThickness="1"
                ClipToBounds="True"
                IsVisible="{Binding SelectedModule, Converter={x:Static conv:Converters.IsFlyout}}">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0" Background="#e8e8e8" BorderBrush="#aaa" BorderThickness="0,0,0,1" Padding="6,4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding SelectedModuleName, FallbackValue='Flyout'}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="✕" CornerRadius="0" Background="#eee" BorderBrush="#999" BorderThickness="1" Padding="6,0" Height="22" MinHeight="22" FontSize="10"
                                Command="{Binding SelectModuleCommand}" CommandParameter="{x:Null}" />
                    </Grid>
                </Border>
                <ContentControl Grid.Row="1" Content="{Binding CurrentModuleView}" Margin="4" Padding="0,0,4,0"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Grid>
        </Border>

        <!-- Col3 Row1: Flyout vertical 32px strip — dedicated column, never covers Right; Auto collapses when no Flyout claimants -->
        <Border Grid.Row="1" Grid.Column="3" Width="32"
                Background="#e0e0e0" BorderBrush="#aaa" BorderThickness="1,0,0,0"
                IsVisible="{Binding FlyoutModules, Converter={x:Static conv:Converters.HasElements}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FlyoutModules}" Margin="2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NamedModule">
                            <Button Classes="flyoutToggle" CornerRadius="0" Background="#eee"
                                    BorderBrush="#999" BorderThickness="1"
                                    HorizontalAlignment="Stretch" FontSize="12"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectModuleCommand}"
                                    CommandParameter="{Binding Module}">
                                <LayoutTransformControl>
                                    <LayoutTransformControl.LayoutTransform>
                                        <RotateTransform Angle="-90" />
                                    </LayoutTransformControl.LayoutTransform>
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                </LayoutTransformControl>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Row2: MDI editable ComboBox (IsEditable) Width=300 + Send + signals/limits summary -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                Background="White" BorderBrush="#aaa" BorderThickness="0,1,0,1" Padding="6" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc app.mdi.label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ComboBox x:Name="MdiBox" Width="300" Height="28" MinHeight="28" IsEditable="True"
                          Text="{Binding MdiInput, Mode=TwoWay}"
                          ItemsSource="{Binding MdiHistory}"
                          PlaceholderText="{loc:Loc app.mdi.placeholder}"
                          CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                          VerticalAlignment="Center" VerticalContentAlignment="Center">
                    <ComboBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SendMdiCommand}" />
                        <KeyBinding Gesture="Up" Command="{Binding MdiHistoryPrevCommand}" />
                        <KeyBinding Gesture="Down" Command="{Binding MdiHistoryNextCommand}" />
                    </ComboBox.KeyBindings>
                </ComboBox>
                <Button Content="{loc:Loc app.mdi.send}" Command="{Binding SendMdiCommand}" CornerRadius="0" Background="#eee" Foreground="Black" BorderBrush="#999" BorderThickness="1" Padding="12,0" Height="28" MinHeight="28" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                <TextBlock Text="{loc:Loc app.mdi.signalsSummary}" Foreground="#888" FontSize="9" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.85" />
            </StackPanel>
        </Border>

        <!-- Row3: StatusBar -->
        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
                Background="#e8e8e8" BorderBrush="#aaa" BorderThickness="0,1,0,0" Padding="4,2" HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusBarBlocks}" FontSize="10" Foreground="#666" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="10" Foreground="#666" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                <TextBlock Grid.Column="2" Text="{Binding ConnectionStatus, FallbackValue='Ready'}" FontSize="10" Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding RunTime}" FontSize="10" Foreground="#666" VerticalAlignment="Center" Margin="10,0,0,0" />
                <TextBlock Grid.Column="4" Text="{Binding StatusBarJogStep}" FontSize="10" Foreground="#666" VerticalAlignment="Center" Margin="10,0,0,0" />
            </Grid>
        </Border>

    </Grid>
</Window>
