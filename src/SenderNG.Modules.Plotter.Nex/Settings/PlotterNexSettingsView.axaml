<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Modules.Plotter.Nex.Settings"
             mc:Ignorable="d" d:DesignWidth="240" d:DesignHeight="120"
             x:Class="SenderNG.Modules.Plotter.Nex.Settings.PlotterNexSettingsView"
             x:DataType="vm:PlotterNexSettingsViewModel">
    <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowWireLength}">
            <TextBlock Text="Wire length (tower distance)" FontSize="10" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding WireLength}" CornerRadius="0" Height="28" MinWidth="90" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding PlaneRows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlotterNexPlaneRow">
                    <Expander IsExpanded="True" Header="{Binding Title}" Margin="0,2">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="World axes" FontSize="10" VerticalAlignment="Center" />
                                <ItemsControl ItemsSource="{Binding Slots}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WorldAxisRow">
                                            <ComboBox ItemsSource="{Binding Choices}"
                                                      SelectedIndex="{Binding Axis}"
                                                      CornerRadius="0" Height="28" MinWidth="56" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="X" FontSize="10" VerticalAlignment="Center" />
                                <NumericUpDown Value="{Binding OriginX}" CornerRadius="0" Height="28" MinWidth="64" />
                                <TextBlock Text="Y" FontSize="10" VerticalAlignment="Center" />
                                <NumericUpDown Value="{Binding OriginY}" CornerRadius="0" Height="28" MinWidth="64" />
                                <TextBlock Text="Z" FontSize="10" VerticalAlignment="Center" />
                                <NumericUpDown Value="{Binding OriginZ}" CornerRadius="0" Height="28" MinWidth="64" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>