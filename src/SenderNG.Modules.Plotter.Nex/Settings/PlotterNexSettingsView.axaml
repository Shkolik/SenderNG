<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Modules.Plotter.Nex.Settings"
             mc:Ignorable="d" d:DesignWidth="240" d:DesignHeight="120"
             x:Class="SenderNG.Modules.Plotter.Nex.Settings.PlotterNexSettingsView"
             x:DataType="vm:PlotterNexSettingsViewModel">
    <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowWireLength}">
            <TextBlock Text="{Binding WireLengthLabel}" FontSize="10" VerticalAlignment="Center" />
            <TextBox Text="{Binding WireLength}" Width="110" Height="24" MinHeight="24"
                     CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                     FontSize="11" VerticalContentAlignment="Center" Padding="4,0" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="{Binding ViewLabel}" FontSize="12" FontWeight="SemiBold"
                       Foreground="#333" Margin="0,6,0,0" />
            <ToggleSwitch Content="{Binding ShowOriginLabel}" IsChecked="{Binding ShowOrigin}" />
            <ToggleSwitch Content="{Binding ShowEnvelopeLabel}" IsChecked="{Binding ShowEnvelope}" />
            <ToggleSwitch Content="{Binding ShowRunStateLabel}" IsChecked="{Binding ShowRunState}" />
            <ToggleSwitch Content="{Binding ShowGridLabel}" IsChecked="{Binding ShowGrid}" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="{Binding AntiAliasingLabel}" FontSize="12" FontWeight="SemiBold"
                       Foreground="#333" Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding AaModeLabel}" FontSize="10" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding AaModeChoices}" SelectedIndex="{Binding AaMode}"
                          Width="110" Height="28" MinHeight="28" CornerRadius="0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding AaQualityLabel}" FontSize="10" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding AaQualityChoices}" SelectedIndex="{Binding AaQuality}"
                          Width="110" Height="28" MinHeight="28" CornerRadius="0" />
            </StackPanel>
        </StackPanel>
        <Rectangle Height="1" Fill="#ddd" />
        <ItemsControl ItemsSource="{Binding PlaneRows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlotterNexPlaneRow">
                    <StackPanel Margin="0,6" Spacing="4">
                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#333" />
                        <Rectangle Height="1" Fill="#ddd" />
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,24,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding WorldAxesLabel}"
                                       FontSize="11" Margin="0,4,0,6" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding OriginLabel}"
                                       FontSize="11" Margin="0,4,0,6" VerticalAlignment="Center" />
                            <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Slots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorldAxisRow">
                                        <ComboBox ItemsSource="{Binding Choices}"
                                                  SelectedIndex="{Binding Axis}"
                                                  Width="64" MinWidth="56" Height="28" MinHeight="28" CornerRadius="0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="X" FontSize="10" VerticalAlignment="Center" />
                                <TextBox Text="{Binding OriginX}" Width="56" Height="28" MinHeight="28"
                                         CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                                         FontSize="11" VerticalContentAlignment="Center" Padding="4,0" />
                                <TextBlock Text="Y" FontSize="10" VerticalAlignment="Center" />
                                <TextBox Text="{Binding OriginY}" Width="56" Height="28" MinHeight="28"
                                         CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                                         FontSize="11" VerticalContentAlignment="Center" Padding="4,0" />
                                <TextBlock Text="Z" FontSize="10" VerticalAlignment="Center" />
                                <TextBox Text="{Binding OriginZ}" Width="56" Height="28" MinHeight="28"
                                         CornerRadius="0" BorderBrush="#999" BorderThickness="1"
                                          FontSize="11" VerticalContentAlignment="Center" Padding="4,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>