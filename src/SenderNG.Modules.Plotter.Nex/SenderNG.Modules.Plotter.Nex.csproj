<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Native floor for the D3D11 readback pipeline (byte* copy in
         NexGpuReadback.CopyFrame). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI plugin: references Avalonia because CreateView returns a Control. -->
    <!-- Pinned to the host app's resolved version (floating 12.* caused a
         framework mismatch TypeLoadException crash in the Skia plotter). -->
    <PackageReference Include="Avalonia" Version="12.0.0" />
    <!-- Nex: versions from the spike findings doc (Task 0). The Avalonia
         package brings the full Nex package set transitively â€” no explicit
         HelixToolkit.Nex reference needed. Vulkan 1.3 required. -->
    <!-- 1.2.0 (the last NuGet.org release, Jul 2025) is broken on all current
         .NET runtimes: WorldDataProvider.Update() -> RangeLightData.Update()
         throws TypeLoadException (the EntityCollection Enumerator embeds a
         byref-like ValueEnumerator as a struct field) -> the HelixViewport tick
         swallows it -> permanently black view. Fixed in upstream master.
         NOTE: 1.3.0-alpha.41 (Jul 13 2026) comes from the github/helix-toolkit
         GitHub Packages feed (user-level NuGet.Config), not NuGet.org. -->
    <PackageReference Include="HelixToolkit.Nex.Avalonia" Version="1.3.0-alpha.41" />
    <!-- D3D11 readback pipeline (NexGpuReadback) compiles directly against
         Vortice. Pinned to the exact versions the Nex closure already ships
         (verified in the staged Modules\plotter-nex), so the loaded runtime
         assembles stay type-identical with the engine's own interop layer. -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
    <!-- The Nex package set pulls Microsoft.Extensions.* 10.x transitively
         (HelixToolkit.Nex -> Microsoft.Extensions.Logging). The host app + Core
         are kept on the same 10.x line so the plugin's IServiceCollection
         contracts unify with the host container â€” see SenderNG / SenderNG.Core.
         (Note: a DI 8.x pin does NOT work here: nearest-wins keeps DI.Abstractions
         on 10.x via Microsoft.Extensions.Logging.Abstractions, so the module
         still binds 10.0.0.0 and the host must match it.) -->
  </ItemGroup>

  <PropertyGroup>
    <!-- The plugin's types span its package closure (HelixToolkit.Nex.*,
         Vortice.*, SharpGen.Runtime, ZLinq, Glslang.NET, SixLabors.ImageSharp,
         Microsoft.Extensions.* 10.x). The app references plugins with
         ReferenceOutputAssembly="false", so the plugin's NuGet closure is
         otherwise NOT copied anywhere. CopyLocalLockFileAssemblies forces the
         full .deps graph (managed + the win-x64 natives) into this project's
         bin, from which SenderNG.csproj stages them flat into Modules/ (the
         LoadFrom probe resolves dependencies from its own directory). -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SenderNG.Core\SenderNG.Core.csproj" />
  </ItemGroup>

</Project>
