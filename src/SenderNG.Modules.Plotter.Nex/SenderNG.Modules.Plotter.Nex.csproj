<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI plugin: references Avalonia because CreateView returns a Control. -->
    <!-- Pinned to the host app's resolved version (floating 12.* caused a
         framework mismatch TypeLoadException crash in the Skia plotter). -->
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <!-- Nex: versions from the spike findings doc (Task 0). The Avalonia
         package brings the full Nex package set transitively — no explicit
         HelixToolkit.Nex reference needed. Vulkan 1.3 required. -->
    <PackageReference Include="HelixToolkit.Nex.Avalonia" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SenderNG.Core\SenderNG.Core.csproj" />
  </ItemGroup>

</Project>
