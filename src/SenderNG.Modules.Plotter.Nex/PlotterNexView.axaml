<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hx="clr-namespace:HelixToolkit.Nex.Avalonia;assembly=HelixToolkit.Nex.Avalonia"
             xmlns:vm="clr-namespace:SenderNG.Modules.Plotter.Nex"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="SenderNG.Modules.Plotter.Nex.PlotterNexView"
             x:Name="Root"
             x:DataType="vm:PlotterNexViewModel"
             x:CompileBindings="False">

    <!-- The Nex engine and viewport client live on the code-behind (they are
         concrete Nex types; the view model stays headless). The HelixViewport
         binds Engine / ViewportClient / CameraController to code-behind
         properties raised through INPC. -->
    <Grid Background="#101418">

        <!-- Scene view + chrome, replaced entirely by the fallback border when
             Vulkan creation failed (see NexPlotScene in the code-behind). -->
        <Panel x:Name="ScenePanel" IsVisible="{Binding !VulkanUnavailable, Mode=OneWay}">
            <hx:HelixViewport x:Name="Viewport"
                              Engine="{Binding #Root.Engine}"
                              ViewportClient="{Binding #Root.ViewportClient}"
                              CameraController="{Binding #Root.CameraController}"
                              RotateMouseButton="Left"
                              PanMouseButton="Middle"
                              PointerRingEnabled="False" />

            <!-- Snap toolbar: switching a preset also re-binds the viewport's
                 camera controller to the scene's new active pair. -->
            <StackPanel Orientation="Horizontal" Spacing="4"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                <Border Padding="6" Background="#80101518">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Border Width="1" Height="24" Background="#405555" VerticalAlignment="Center" />
                        <Button Content="XY" Click="OnSnapXy" />
                        <Button Content="XZ" Click="OnSnapXz" />
                        <Button Content="YZ" Click="OnSnapYz" />
                        <Button Content="3D" Click="OnSnapIso" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Status strip: healthy empty when geometry is plotted, a reason
                 otherwise (no program / no motion / building / failed). -->
            <Border HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                    Padding="10,4" Background="#B0101418" IsHitTestVisible="False">
                <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                           Foreground="#DDD" FontSize="12" TextTrimming="CharacterEllipsis" />
            </Border>
        </Panel>

        <!-- Fallback shown when no Vulkan device could be created. -->
        <Border Background="#22262B" IsVisible="{Binding VulkanUnavailable, Mode=OneWay}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" MaxWidth="460">
                <TextBlock x:Name="FallbackTitle"
                           Text="3D plotting unavailable"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#EEE" HorizontalAlignment="Center" />
                <TextBlock x:Name="FallbackHint"
                           Text="No Vulkan 1.3 device could be created — 2D plotting stays available."
                           Foreground="#AAA" TextWrapping="Wrap" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

    </Grid>
</UserControl>