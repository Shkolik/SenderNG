<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SenderNG.Modules.Plotter.Nex"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="SenderNG.Modules.Plotter.Nex.PlotterNexView"
             x:Name="Root"
             x:DataType="vm:PlotterNexViewModel"
             x:CompileBindings="False">

    <!-- Skia-plotter-matching chrome: light #e8e8e8 header bar with dark text
         and a #aaa frame, the 3D viewport filling the rest. The Nex engine and
         viewport client live on the code-behind (they are concrete Nex types;
         the view model stays headless). The scene is rendered into a D3D11
         shared texture and read back to a WriteableBitmap by a DispatcherTimer
         tick in the code-behind; GpuImage shows the result. (The composition
         presenter path — HelixViewport — is disabled: it deadlocks, upstream.
         See NexGpuReadback.) -->
    <Border BorderBrush="#aaa" BorderThickness="1" Background="White">
        <DockPanel>
            <!-- Header bar (Skia PlotterView row): view snaps right, status left. -->
            <Border DockPanel.Dock="Top" Background="#e8e8e8" Height="24">
                <DockPanel Margin="8,0,6,0">
                    <StackPanel Orientation="Horizontal" Spacing="4"
                                DockPanel.Dock="Right" VerticalAlignment="Center">
                        <ToggleButton x:Name="SnapXyButton" Content="XY" FontSize="11" Padding="8,1" Click="OnSnapXy" />
                        <ToggleButton x:Name="SnapXzButton" Content="XZ" FontSize="11" Padding="8,1" Click="OnSnapXz" />
                        <ToggleButton x:Name="SnapYzButton" Content="YZ" FontSize="11" Padding="8,1" Click="OnSnapYz" />
                        <ToggleButton x:Name="SnapIsoButton" Content="3D" FontSize="11" Padding="8,1" Click="OnSnapIso" IsChecked="True" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PlaneLettersText, Mode=OneWay}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#333" />
                        <TextBlock Text="{Binding ProgressText, Mode=OneWay}"
                                   FontSize="11" Foreground="#666" Margin="12,0,0,0" />
                        <TextBlock x:Name="StatusTextBlock"
                                   Text="{Binding StatusText, Mode=OneWay}"
                                   FontSize="11" Foreground="#b03030" Margin="12,0,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Panel x:Name="ScenePanel" IsVisible="{Binding !VulkanUnavailable, Mode=OneWay}">
                <Image x:Name="GpuImage" Stretch="UniformToFill" />

                <!-- Navigation input: LMB drag pans, wheel zooms at the cursor,
                     RMB drag orbits (3D only). Bottom-right: − ⛶ + overlay with a
                     percent readout above it. -->
                <Panel x:Name="PlotInput"
                       Background="Transparent"
                       PointerPressed="OnPlotInputPointerPressed"
                       PointerMoved="OnPlotInputPointerMoved"
                       PointerReleased="OnPlotInputPointerReleased"
                       PointerCaptureLost="OnPlotInputPointerCaptureLost"
                       PointerWheelChanged="OnPlotInputPointerWheelChanged">
                    <Panel.Styles>
                        <!-- Text-only nav buttons: no chrome. Idle gray; darker +
                             semi-bold on hover and press. -->
                        <Style Selector="Button.navBtn">
                            <Setter Property="Width" Value="32" />
                            <Setter Property="Height" Value="32" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="FontSize" Value="24" />
                            <Setter Property="Foreground" Value="#777" />
                            <Setter Property="FontWeight" Value="Normal" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter x:Name="PART_ContentPresenter"
                                                      Background="Transparent"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalContentAlignment="Center"
                                                      VerticalContentAlignment="Center" />
                                </ControlTemplate>
                            </Setter>
                        </Style>
                        <Style Selector="Button.navBtn:pointerover">
                            <Setter Property="Foreground" Value="#444" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                        <Style Selector="Button.navBtn:pressed">
                            <Setter Property="Foreground" Value="#222" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                        <Style Selector="ToggleButton.navBtn:checked">
                            <Setter Property="Foreground" Value="#222" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                    </Panel.Styles>
                    <!-- Top-left view-toggle chrome: the same 4
                         PlotterNexSettings toggles the App Settings leaf binds,
                         so both surfaces stay two views onto one model. The
                         DataContext is a PlotterNexSettingsViewModel wired in
                         the code-behind; each flip persists per-profile and is
                         pushed to the live scene as a runtime chrome change. -->
                    <StackPanel Orientation="Vertical" Spacing="6"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                                x:Name="OverlayViewToggles">
                        <ToggleButton Classes="navBtn" Content="◎" ToolTip.Tip="{Binding ShowOriginLabel}"
                                      IsChecked="{Binding ShowOrigin}" />
                        <ToggleButton Classes="navBtn" Content="▢" ToolTip.Tip="{Binding ShowEnvelopeLabel}"
                                      IsChecked="{Binding ShowEnvelope}" />
                        <ToggleButton Classes="navBtn" Content="▶" ToolTip.Tip="{Binding ShowRunStateLabel}"
                                      IsChecked="{Binding ShowRunState}" />
                        <ToggleButton Classes="navBtn" Content="▦" ToolTip.Tip="{Binding ShowGridLabel}"
                                      IsChecked="{Binding ShowGrid}" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Spacing="6"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12">
                        <TextBlock x:Name="ZoomPctText" Text="100%" FontSize="12" Foreground="#777"
                                   HorizontalAlignment="Center" IsVisible="False" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="ZoomOutButton" Classes="navBtn" Content="−" Click="OnZoomOut" />
                            <Button x:Name="ReframeButton" Classes="navBtn" Content="⛶" Click="OnReframe" />
                            <Button x:Name="ZoomInButton" Classes="navBtn" Content="+" Click="OnZoomIn" />
                        </StackPanel>
                    </StackPanel>
                </Panel>

                <!-- Live viewport render diagnostics (POC). "t N" counts readback
                     ticks that presented a full frame to the bitmap, "N fps"
                     reports completed frames per second. A ticking counter with
                     no FPS means copy/bitmap work never completes; no counter at
                     all means the render loop never started. -->
                <StackPanel Orientation="Vertical" Spacing="2"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                            IsHitTestVisible="False">
                    <TextBlock x:Name="CtxText" Text="ctx –" Foreground="#666" FontSize="11" />
                    <TextBlock x:Name="RenderText" Text="t – / – fps" Foreground="#666" FontSize="11" />
                </StackPanel>
            </Panel>

            <!-- Fallback shown when no Vulkan device could be created. -->
            <Border Background="#22262B" IsVisible="{Binding VulkanUnavailable, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" MaxWidth="460">
                    <TextBlock x:Name="FallbackTitle"
                               Text="3D plotting unavailable"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="#EEE" HorizontalAlignment="Center" />
                    <TextBlock x:Name="FallbackHint"
                               Text="No Vulkan 1.3 device could be created — 2D plotting stays available."
                               Foreground="#AAA" TextWrapping="Wrap" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </DockPanel>
    </Border>
</UserControl>