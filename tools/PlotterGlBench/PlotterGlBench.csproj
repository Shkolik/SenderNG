<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- fixed (byte* p = frame) around the CopyFrame loop. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>PlotterGlBench</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The GL module only — never the app. InternalsVisibleTo "PlotterGlBench"
         is declared in the GL csproj (GlContext/GlPlotScene/GlReadback are
         internal; the bench measures them head-offscreen, no Avalonia). -->
    <ProjectReference Include="..\..\src\SenderNG.Modules.Plotter.GL\SenderNG.Modules.Plotter.GL.csproj" />
  </ItemGroup>

</Project>
